    min-width:560px!important;
  }
}

/* source: stable-v20b-precise-refine */
/* Keep v19 geometry; enlarge only the information the user specified. */
#dexDetail .v19-type{
  font-weight:950!important;
  padding:6px 10px!important;
}

/* Berry / sleep type / specialty: keep the same row, make content larger */
#dexDetail .v19-traits span{
  min-height:38px!important;
}

/* Food header: distribute labels horizontally with better visual balance */
#detailFoods .v13-food-head{
  grid-template-columns:minmax(155px,1.55fr) 58px 62px 62px minmax(145px,1.35fr)!important;
  font-size:13px!important;
  min-height:44px!important;
}
#detailFoods .v13-food-title{
  font-size:14px!important;
  gap:8px!important;
}
#detailFoods .v13-food-rate{
  font-size:10px!important;
}
#detailFoods .v13-food-row{
  grid-template-columns:minmax(155px,1.55fr) 58px 62px 62px minmax(145px,1.35fr)!important;
  min-height:64px!important;
}

/* A/B/C: larger, colored badges for instant recognition */
#detailFoods .food-letter{
  width:30px!important;
  height:30px!important;
  font-size:15px!important;
  font-weight:950!important;
  color:#fff!important;
  border-radius:9px!important;
}
#detailFoods .v13-food-row:nth-of-type(2) .food-letter{background:#5d9f6e!important}
#detailFoods .v13-food-row:nth-of-type(3) .food-letter{background:#d39a45!important}
#detailFoods .v13-food-row:nth-of-type(4) .food-letter{background:#7b83bd!important}

/* Skill: existing right-side controller only. Rate sits between name and controller. */
.v20b-skill-line{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto auto!important;
  align-items:center!important;
