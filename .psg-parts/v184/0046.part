 'くさ':`<path d="M15 46C18 24 35 13 51 13c0 22-11 39-32 38" fill="#78bf87" stroke="#35845a" stroke-width="3"/><path d="M17 51c7-11 15-18 29-29" fill="none" stroke="#35845a" stroke-width="3"/><path d="M30 37l-3-11m8 6 12-1" stroke="#4e9d67" stroke-width="2"/>`,
