/* source: stable-v21-header-skill */
#dexDetail .v19-identity{gap:7px!important}
#dexDetail .v19-identity .v19-no{font-size:13px!important;flex:0 0 auto!important}
#dexDetail .v19-identity strong{font-size:24px!important;line-height:1.05!important;flex:0 0 auto!important}
#dexDetail .v19-type{margin-left:2px!important;font-size:14px!important;padding:5px 8px!important;flex:0 0 auto!important}
#dexDetail .v19-traits,#dexDetail .hero-info>.stats{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;width:100%!important}
#dexDetail .v19-traits span,#dexDetail .hero-info>.stats .stat{width:100%!important;box-sizing:border-box!important}
.v21-skill-row{display:grid!important;grid-template-columns:minmax(0,1fr) auto auto!important;align-items:center!important;gap:10px!important;width:100%!important}
