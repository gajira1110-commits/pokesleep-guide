for(const [kind,entries] of Object.entries({"pokemon":{"1":"data:image/webp;base64,"},"pokemonFaces":{},"ingredients":{},"berries":{},"skills":{},"recipes":{},"sleepStyles":{},"fields":{},"subskills":{"きのみの数S":"data:image/svg+xml;base64,","おてつだいボーナス":"data:image/svg+xml;base64,","おてつだいスピードS":"data:image/svg+xml;base64,","おてつだいスピードM":"data:image/svg+xml;base64,","食材確率アップS":"data:image/svg+xml;base64,","食材確率アップM":"data:image/svg+xml;base64,","スキル確率アップS":"data:image/svg+xml;base64,","スキル確率アップM":"data:image/svg+xml;base64,","最大所持数アップS":"data:image/svg+xml;base64,","最大所持数アップM":"data:image/svg+xml;base64,","最大所持数アップL":"data:image/svg+xml;base64,","スキルレベルアップS":"data:image/svg+xml;base64,","スキルレベルアップM":"data:image/svg+xml;base64,","げんき回復ボーナス":"data:image/svg+xml;base64,","睡眠EXPボーナス":"data:image/svg+xml;base64,","ゆめのかけらボーナス":"data:image/svg+xml;base64,","リサーチEXPボーナス":"data:image/svg+xml;base64,"},"types":{}}))Object.assign(window.PS_IMAGE_FILES[kind],entries);
for(const [no,styles] of Object.entries(window.PS_CATALOG.sleepStyles)){
  window.PS_CATALOG.sleepStyles[no]=styles.map(([name,stars,explicitId],index)=>{
    const id=explicitId||`${String(no).padStart(4,'0')}_${String(index+1).padStart(2,'0')}`;
    return {id,stars,name,image:window.PS_IMAGE_FILES.sleepStyles[id]||`assets/sleep/${id}.webp`};
  });
}
/* Render-only preview rows are derived from the verified slot candidates.
   The complete candidate sets remain in ingredientSlots for future screens. */
for(const pokemon of Object.values(window.PS_CATALOG.pokemon)){
  const assets=window.PS_IMAGE_FILES;
  pokemon.image=assets.pokemon[pokemon.no]||pokemon.image||null;
  pokemon.faceImage=assets.pokemonFaces[pokemon.no]||pokemon.image;
  pokemon.berryImage=assets.berries[pokemon.berry]||pokemon.berryImage||null;
  if(!pokemon.ingredientSlots)continue;
  const rows=new Map();
  pokemon.ingredientSlots.forEach((slot,levelIndex)=>{
    for(const candidate of slot.candidates){
      if(!rows.has(candidate.name))rows.set(candidate.name,[null,null,null]);
      rows.get(candidate.name)[levelIndex]=candidate.qty;
    }
  });
  pokemon.ingredients=[...rows].map(([name,qty],i)=>({slot:["A","B","C"][i],name,qty}));
}
for(const [name,image] of Object.entries(window.PS_IMAGE_FILES.ingredients)){
  window.PS_CATALOG.ingredientAssets[name]={...window.PS_CATALOG.ingredientAssets[name],image};
}
for(const [id,image] of Object.entries(window.PS_IMAGE_FILES.skills)){
  if(window.PS_CATALOG.skills[id])window.PS_CATALOG.skills[id].image=image;
}
window.PS_CATALOG.recipesByIngredient={};
for(const recipe of Object.values(window.PS_CATALOG.recipes)){
  recipe.image=window.PS_IMAGE_FILES.recipes[recipe.id]||null;
  for(const ingredient of recipe.ingredients){
    (window.PS_CATALOG.recipesByIngredient[ingredient.name]??=[]).push({id:recipe.id,name:recipe.name,image:recipe.image,amount:ingredient.qty});
  }
}
window.PS_CATALOG.ingredientVisual=name=>window.PS_CATALOG.ingredientAssets[name]||null;
</script>






































































<style id="psg-v56-consolidated-styles">
/* source: base */
:root{--bg:#f5f8f7;--card:#fff;--line:#dfe8e4;--text:#111;--muted:#718079;--green:#46a477;--psg-header-height:56px}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
header{height:56px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-weight:900;position:sticky;top:0;z-index:20}
main{max-width:720px;margin:auto;padding:12px 12px 86px}.screen{display:none}.screen.active{display:block}
h2{margin:8px 0 12px;font-size:19px}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:10px}
.empty{text-align:center;padding:34px 16px;color:var(--muted)}button,input,select{font:inherit}
.btn{border:1px solid var(--line);background:#fff;border-radius:11px;padding:9px 12px;font-weight:800}.primary{background:var(--green);color:#fff;border-color:var(--green)}
.psg-team-card .note{margin:8px 0}
.psg-skill-index input{display:block;width:100%;margin:8px 0 12px;padding:12px;border:1px solid var(--line);border-radius:12px;font-size:16px}.psg-skill-entry{margin-top:10px;border:1px solid var(--line);border-radius:14px;background:#fff;overflow:hidden}.psg-skill-entry summary{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px;cursor:pointer;color:#171d1a}.psg-skill-entry summary strong{font-size:18px}.psg-skill-tags{font-size:13px;color:#527a62}.psg-skill-levels{padding:0 14px}.psg-skill-level{display:flex;gap:16px;padding:10px 0;border-top:1px solid var(--line)}.psg-skill-level b{min-width:44px}.psg-skill-species-label{font-weight:700;padding:12px 14px 6px}.psg-skill-species{display:flex;flex-wrap:wrap;gap:8px;padding:0 14px 14px}
.psg-recipe-filters{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}.psg-recipe-filters label{font-size:13px;font-weight:700}.psg-recipe-filters input,.psg-recipe-filters select{display:block;width:100%;box-sizing:border-box;margin-top:5px;padding:10px 8px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:16px;color:#18221b}.psg-recipe-entry{border:1px solid var(--line);border-radius:14px;margin:10px 0;padding:12px;background:#fff}.psg-recipe-heading,.psg-recipe-energy{display:flex;align-items:center;justify-content:space-between;gap:8px}.psg-recipe-headline{display:flex;flex-direction:column;gap:2px}.psg-recipe-headline strong{font-size:17px}.psg-recipe-headline small,.psg-recipe-energy small{color:var(--muted)}.psg-recipe-ingredients{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.psg-recipe-chip{display:flex;align-items:center;gap:5px;border-radius:10px;background:#f3f7f3;padding:4px 8px;font-weight:700}.psg-recipe-chip img{width:26px;height:26px;object-fit:contain}.psg-recipe-energy strong{font-size:14px}.psg-recipe-entry>.note{margin:8px 0}.psg-recipe-providers{border-top:1px solid var(--line);padding-top:8px;font-size:13px}.psg-recipe-providers summary{color:#3679c2;font-weight:700;cursor:pointer}.psg-recipe-providers p{margin:8px 0 0;line-height:1.5}
.toolbar{display:flex;gap:7px;margin-bottom:10px}.toolbar input{min-width:0;flex:1;border:1px solid var(--line);border-radius:11px;padding:10px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.poke{background:#fff;border:1px solid var(--line);border-radius:14px;padding:9px;min-height:112px;cursor:pointer;font:inherit;color:inherit;text-align:left}.poke b{display:block;font-size:13px}.poke small{color:var(--muted)}.poke .icons{margin-top:24px;font-size:15px;display:flex;gap:5px}
nav{position:fixed;bottom:0;left:0;right:0;height:68px;background:#fff;border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);z-index:30;padding-bottom:env(safe-area-inset-bottom)}
nav button{border:0;background:#fff;color:#718079;font-weight:800;font-size:11px}nav button.active{color:var(--green)}
.detail-head{display:flex;align-items:center;gap:9px;margin-bottom:10px}.detail-head h2{margin:0;flex:1}.stats{display:grid;grid-template-columns:1fr 1fr;gap:7px}.stat{background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px}.stat small{display:block;color:var(--muted);font-size:10px}.section-title{font-weight:900;margin-bottom:8px}
.pills{display:flex;gap:6px;flex-wrap:wrap}.pill{background:#f1f5f3;border-radius:999px;padding:6px 9px;font-size:12px}
.note{font-size:12px;color:var(--muted);line-height:1.6}
@media(max-width:360px){.grid{gap:6px}.poke{padding:7px}}

/* source: stable-v2-style */
.dex-card{position:relative;min-width:0;min-height:162px;padding:8px 6px 9px;overflow:hidden;display:flex;flex-direction:column}
.dex-card .dex-heading{min-width:0;min-height:36px;display:flex;align-items:flex-start;justify-content:space-between;gap:2px}
.dex-card .dex-identity{min-width:0;flex:1;color:#111}
.dex-card .dex-no{display:block;font-size:10px;font-weight:800;line-height:1.1}
.dex-card .dex-name{display:block;font-weight:900;font-size:13px;line-height:1.2;overflow-wrap:anywhere}
.dex-card .dex-discovery{flex:none;font-size:10px;font-weight:800;white-space:nowrap;color:#52635b}
.dex-card .dex-art{height:92px;display:grid;place-items:center;color:#9aa7a2}
.dex-card .dex-art img{width:100%;height:100%;object-fit:contain}
.psg-face-sprite{display:block;flex:none;width:100%;max-height:100%;aspect-ratio:145/108;background-image:var(--psg-face-sheet);background-repeat:no-repeat;background-size:1412.414% 1066.667%;background-position:var(--face-x) var(--face-y);image-rendering:pixelated;border-radius:7px}
.dex-card .dex-art>.psg-face-sprite{max-width:124px}
.psg-team-face>.psg-face-sprite,.psg-recipe-provider-art>.psg-face-sprite,.v31-evo-image>.psg-face-sprite{width:100%;height:auto}
#boxGrid .psg-box-card{display:flex;flex-direction:column;gap:4px}
.psg-box-card-art{width:100%;height:78px;display:grid;place-items:center;overflow:hidden;border-radius:8px;color:#82918a;font-size:10px}
.psg-box-card-art>.psg-face-sprite{max-width:104px}
.psg-box-card-art>img{width:100%;height:100%;object-fit:contain}
.psg-box-card-copy{display:block;min-width:0}
/* Five cards across on phone and desktop; each badge keeps its own accessible label. */
#dexGrid,#boxGrid{grid-template-columns:repeat(5,minmax(0,1fr));gap:5px}
#dexGrid .dex-card{padding:5px 3px;min-height:132px}
#dexGrid .dex-heading{min-height:36px;display:block}
#dexGrid .dex-discovery{display:block;font-size:9px;text-align:right;margin-left:auto}
#dexGrid .dex-name{font-size:11px}
#dexGrid .dex-art{height:73px}
#dexGrid .dex-bottom{gap:0;margin-top:-7px}
#dexGrid .dex-bottom span{width:16px;height:16px;font-size:10px}
#dexGrid .dex-bottom img,#dexGrid .dex-bottom img.psg-specialty-icon{width:13px;height:13px}
#boxGrid .psg-box-card{min-width:0;padding:3px 2px 4px;gap:1px;overflow:hidden;border-radius:10px}
#boxGrid .psg-box-card-art{position:relative;height:68px}
#boxGrid .psg-box-card-copy{min-height:14px;line-height:1.1;text-align:left}
#boxGrid .psg-box-card-copy b{display:block;font-size:11px;line-height:1.1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#boxGrid .psg-box-card-level{position:absolute;right:1px;bottom:1px;z-index:2;padding:1px 2px;border-radius:3px;background:#ffffffe8;color:#111;font-size:10px;font-weight:950;line-height:1.15}
#boxGrid .psg-box-card-copy small{font-size:10px}
.psg-box-mini-row{display:flex;justify-content:center;gap:1px;min-width:0}
.psg-box-mini-badge{position:relative;display:grid;place-items:center;min-width:0;flex:1;max-width:19px;aspect-ratio:1;border-radius:3px;background:#eff4ef;border:1px solid #d9e3db;overflow:hidden;font-size:9px;line-height:1}
.psg-box-mini-badge img{width:100%;height:100%;object-fit:contain}
.psg-box-mini-badge em{position:absolute;top:0;left:0;font-size:7px;font-style:normal;font-weight:900;background:#fff9;z-index:1}
.psg-box-mini-badge.is-unknown{color:#839089;background:#f5f5f5}
.psg-box-mini-badge.is-locked{opacity:.48}
.psg-subskill-card-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:2px;width:100%;max-width:74px;margin:0 auto}
.psg-subskill-card-grid .psg-box-mini-badge{grid-column:span 2;width:100%;max-width:none;min-height:18px;border-radius:4px}
.psg-subskill-card-grid .psg-box-mini-badge:nth-child(4){grid-column:2 / span 2}
.dex-card .dex-art-placeholder{width:35px;height:35px;border:2px dotted currentColor;border-radius:50%}
.dex-card .dex-bottom{display:flex;align-items:center;justify-content:center;gap:2px;margin-top:-11px;position:relative}
.dex-card .dex-bottom span{width:23px;height:23px;border-radius:50%;background:#fff;box-shadow:0 2px 5px #20312c24;display:grid;place-items:center;font-size:13px}
.dex-card .dex-bottom img{width:18px;height:18px;object-fit:contain}
.psg-specialty-icon{width:22px;height:22px;object-fit:contain;vertical-align:middle;flex:none;image-rendering:pixelated}
.dex-card .dex-bottom img.psg-specialty-icon{width:18px;height:18px}
#boxSpecialtyFilters .filter-option{display:flex;align-items:center;gap:6px}
#boxSpecialtyFilters .psg-specialty-icon{width:20px;height:20px}
.psg-mini-missing{display:block;font-size:7px;font-weight:650;line-height:.95;text-align:center;color:#74857e;letter-spacing:0}
@media(max-width:360px){.dex-card .dex-bottom span{width:18px;height:18px;font-size:11px}}
.type-grass{--psg-type-bg:#eaf7ed;background:var(--psg-type-bg)}.type-fire{--psg-type-bg:#fff0e9;background:var(--psg-type-bg)}.type-water{--psg-type-bg:#eaf4ff;background:var(--psg-type-bg)}.type-electric{--psg-type-bg:#fff9dc;background:var(--psg-type-bg)}.type-bug{--psg-type-bg:#f2f7df;background:var(--psg-type-bg)}.type-normal{--psg-type-bg:#f3f2ef;background:var(--psg-type-bg)}.type-poison{--psg-type-bg:#f5eafa;background:var(--psg-type-bg)}.type-ground{--psg-type-bg:#f6f0e3;background:var(--psg-type-bg)}.type-flying{--psg-type-bg:#eaf3ff;background:var(--psg-type-bg)}.type-ghost{--psg-type-bg:#eeeaf8;background:var(--psg-type-bg)}.type-psychic{--psg-type-bg:#ffeef4;background:var(--psg-type-bg)}.type-ice{--psg-type-bg:#e6f8fb;background:var(--psg-type-bg)}.type-steel{--psg-type-bg:#edf2f5;background:var(--psg-type-bg)}.type-fighting{--psg-type-bg:#faece8;background:var(--psg-type-bg)}.type-rock{--psg-type-bg:#f0eee4;background:var(--psg-type-bg)}.type-dark{--psg-type-bg:#ecebea;background:var(--psg-type-bg)}.type-dragon{--psg-type-bg:#eceffc;background:var(--psg-type-bg)}.type-fairy{--psg-type-bg:#fff0f8;background:var(--psg-type-bg)}
.dex-controls{background:#fff;border:1px solid var(--line);border-radius:16px;padding:10px;margin-bottom:10px}
.filter-title{font-size:11px;color:var(--muted);font-weight:800;margin:6px 0}
.filter-row{display:flex;gap:6px;overflow:auto;padding-bottom:2px}.filter-btn{white-space:nowrap;border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 9px;font-size:11px;font-weight:800}.filter-btn.on{background:#e7f6ef;border-color:#79bea0}
.detail-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-bottom:10px}.detail-tabs button{border:1px solid var(--line);background:#fff;border-radius:10px;padding:8px;font-weight:900}.detail-tabs button.on{background:#e7f6ef;border-color:#79bea0}
.detail-pane{display:none}.detail-pane.on{display:block}
.hero{border-radius:18px;padding:14px;margin-bottom:10px}.hero-top{display:flex;align-items:center;gap:12px}.hero-art{width:92px;height:92px;background:rgba(255,255,255,.72);border-radius:18px;display:grid;place-items:center;font-size:42px}.hero-info{flex:1}.hero-info h2{margin:0 0 7px}.white-row{background:#fff;border-radius:10px;padding:7px 9px;font-size:12px;margin-top:5px}
.detail-nav{display:grid;grid-template-columns:70px 1fr 70px;align-items:center;gap:5px;margin-bottom:9px}.detail-nav strong{text-align:center;font-size:13px}.detail-nav button{border:1px solid var(--line);background:#fff;border-radius:10px;padding:8px 5px;font-weight:800}
.food-row{display:grid;grid-template-columns:32px 1fr auto;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #edf1ef}.food-row:last-child{border:0}.food-letter{font-weight:900}.unknown{color:#8b9792;font-size:12px}

/* source: stable-v3-filter-style */
.compact-filter{margin:0 0 10px}
.psg-list-sticky{position:sticky;top:var(--psg-header-height);z-index:65;background:var(--bg);margin:0 -12px 4px;padding:0 12px 1px}
.psg-list-sticky .compact-filter{margin-bottom:0}
.psg-list-sticky .toolbar{align-items:center;margin-bottom:5px}
.psg-list-sticky .toolbar h2{margin:0;min-width:0}
.psg-list-sticky .toolbar input{padding:7px 8px;font-size:16px}
#dexCompactFilters .filter-main,#boxCompactFilters .filter-main{padding-block:7px}
.filter-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:7px}
.filter-select{position:relative}
.filter-main{width:100%;border:1px solid var(--line);background:#fff;border-radius:11px;padding:9px 10px;font-weight:850;text-align:left;display:flex;justify-content:space-between;align-items:center}
.filter-main.active{background:#e7f6ef;border-color:#79bea0}
.filter-panel{display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1px solid var(--line);border-radius:12px;padding:7px;z-index:15;box-shadow:0 8px 20px rgba(35,55,48,.12);max-height:220px;overflow:auto}
.filter-select.open .filter-panel{display:block}
.filter-option{width:100%;border:0;background:#fff;border-radius:8px;padding:8px;text-align:left;font-weight:750}
.filter-option.on{background:#e7f6ef}
.dex-filter-controls{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:4px}
.dex-filter-controls>.filter-select{position:static}
.dex-filter-controls .filter-panel{left:0;right:0;top:calc(100% + 4px)}
.dex-filter-controls .filter-select.open .filter-panel{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:4px}
.dex-filter-controls .filter-select.open #typeFilters{grid-template-columns:repeat(4,minmax(0,1fr))}
.dex-filter-controls .filter-option{min-height:49px;padding:3px;display:grid;place-items:center;text-align:center;border:1px solid #e2ebe6}
.dex-filter-controls .filter-option.on{border-color:#46a477}
.dex-filter-controls .filter-pictogram{font-size:23px;line-height:1}
.dex-filter-controls .filter-pictogram img{width:26px;height:26px;object-fit:contain}
.dex-filter-controls .filter-type-label{font-size:10px;line-height:1.1}
.dex-filter-controls .filter-option.text-fallback{grid-column:span 2;font-size:11px;line-height:1.2;overflow-wrap:anywhere}
.dex-filter-controls .filter-option,.box-filter-row:first-child .filter-option{min-height:60px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:2px;text-align:center;min-width:0}
.dex-filter-controls .filter-option img,.box-filter-row:first-child .filter-option img{width:30px;height:30px;object-fit:contain}
.dex-filter-controls .filter-option .filter-caption,.box-filter-row:first-child .filter-option .filter-caption{font-size:9px;line-height:1.12;overflow-wrap:anywhere}
.spec-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px}
.spec-row .filter-main{justify-content:center}
.spec-row .filter-main{min-width:0;gap:2px;font-size:clamp(10px,2.8vw,14px);white-space:nowrap;padding-inline:3px}
.box-filter-row{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:4px}
.box-filter-row:first-child{position:relative}
.box-filter-row:first-child>.filter-select{position:static}
.box-filter-row:first-child .filter-panel{left:0;right:0;top:calc(100% + 4px)}
.box-filter-row:first-child .filter-select.open .filter-panel{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}
.tag-note{font-size:10px;color:var(--muted);padding:5px 7px 2px}

/* source: stable-v5-dex-detail-style */
#dexDetail{--accent:#168fe6}
#dexDetail .detail-head{margin:0 0 8px}
#dexDetail .detail-head h2{text-align:center;font-size:18px}
#dexDetail .detail-nav{grid-template-columns:1fr 1.35fr 1fr;margin-bottom:10px}
#dexDetail .detail-nav button{min-height:52px;border-radius:14px}
#dexDetail .detail-nav strong{font-size:15px;line-height:1.25}
#dexDetail .hero{padding:10px;border-radius:18px}
#dexDetail .hero-top{align-items:stretch}
#dexDetail .hero-art{width:34%;min-width:104px;height:154px;font-size:44px}
#dexDetail .hero-info{gap:8px}
#dexDetail .hero-info h2{text-align:center;font-size:26px;margin:0}
#dexDetail .white-row{margin:0;padding:10px;min-height:44px;font-weight:900}
#dexDetail .stats{gap:0;border-radius:15px;border:1px solid var(--line)}
#dexDetail .stat{min-height:68px;padding:10px}
#dexDetail .stat:nth-child(odd){border-right:1px solid var(--line)}
#dexDetail .stat:nth-child(-n+2){border-bottom:1px solid var(--line)}
#dexDetail .stat small{font-weight:800}
#dexDetail .stat b{font-size:18px}
#dexDetail .detail-tabs{margin:10px 0}
#dexDetail .detail-tabs button{border-radius:13px}
#dexDetail .detail-tabs button.on{background:#0aa05a;border-color:#0aa05a}
#dexDetail .ability-card{padding:0;overflow:hidden}
#dexDetail .ability-title{gap:10px;padding:12px 14px 9px;font-weight:950}
#dexDetail .rate-badge{background:#ffe7ef;color:#e93170;padding:6px 9px}
.food-table-head,.food-line{grid-template-columns:minmax(118px,1.35fr) repeat(3,minmax(48px,.58fr)) minmax(112px,1.4fr);align-items:center}
.food-table-head{font-weight:900}
.food-table-head span{margin:0 2px}
.food-table-head span:first-child,.food-table-head span:last-child{background:transparent}
.food-line{min-height:68px;padding:6px 10px}
.food-id{grid-template-columns:34px 34px 1fr;min-width:0}
.food-letter{height:42px;color:#11965b}
.food-line:nth-of-type(3) .food-letter{background:#fff0f4;color:#e52e68}
.food-line:nth-of-type(4) .food-letter{background:#fff5df;color:#b86c00}
.food-icon{font-size:25px;text-align:center}
.food-name{font-weight:900;overflow:hidden;text-overflow:ellipsis}
.food-qty{font-weight:950;font-size:14px}
.recipe-strip{gap:5px;align-items:center;min-width:0}
.recipe-ph{flex:0 0 31px;height:31px;border:1px solid #f3dfc3;font-size:13px}
.recipe-more{font-weight:900}
.skill-box{padding:12px}
.skill-top{display:flex;gap:8px;align-items:center}
.skill-icon{width:48px;height:48px;font-size:24px}
.skill-name{font-weight:950;flex:1}
.skill-level{padding:7px 9px;font-weight:900}
.skill-desc{margin:8px 0 0;color:#53625c}
@media(max-width:430px){
 #dexDetail .hero-top{display:grid;grid-template-columns:35% 1fr;gap:8px}
 #dexDetail .hero-art{width:100%;min-width:0;height:145px}
 #dexDetail .hero-info h2{font-size:23px}
 .food-table-head,.food-line{grid-template-columns:minmax(112px,1.3fr) repeat(3,48px) minmax(86px,1fr)}
 .recipe-ph:nth-child(n+4){display:none}
}

/* source: stable-v6-rebuild */
/* v6: rebuild only the Dex individual screen. Bottom navigation and master foundation stay intact. */
#dexDetail{padding-top:8px}
#dexDetail .detail-head{display:flex;align-items:center;justify-content:space-between;margin:0 0 8px}
#dexDetail .detail-head h2{font-size:18px;margin:0}
#dexDetail .detail-head .btn{border:0;background:transparent;color:#118fe6;font-weight:900;padding:8px}
#dexDetail .dex-fav{font-size:25px;color:#102066}
#dexDetail .detail-nav{display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:8px;align-items:center;margin-bottom:10px}
#dexDetail .detail-nav button{background:#fff;border:1px solid var(--line);border-radius:14px;min-height:56px;padding:7px}
#dexDetail .detail-nav .current{border:0;background:transparent;text-align:center;line-height:1.15}
#dexDetail .detail-nav .current small{font-weight:900}
#dexDetail .detail-nav .current strong{display:block;font-size:26px;margin-top:3px}
#dexDetail .hero{padding:0;background:transparent;border:0;box-shadow:none}
#dexDetail .hero-top{display:grid;grid-template-columns:35% 1fr;gap:9px}
#dexDetail .hero-art{width:100%;height:176px;border-radius:16px;background:rgba(255,255,255,.46);border:1px solid rgba(0,0,0,.06);display:grid;place-items:center;font-size:45px}
#dexDetail .hero-info{display:flex;flex-direction:column;gap:9px}
#dexDetail .hero-info>h2{display:none}
#dexDetail .white-row{background:#fff;border-radius:14px;min-height:52px;padding:9px;display:flex;align-items:center;justify-content:center;font-weight:950;font-size:15px}
#dexDetail .stats{display:grid;grid-template-columns:1fr 1fr;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;flex:1}
#dexDetail .stat{min-height:74px;border:0;border-radius:0;padding:10px;display:flex;flex-direction:column;justify-content:center}
#dexDetail .stat:nth-child(odd){border-right:1px solid #e7ece9}
#dexDetail .stat:nth-child(-n+2){border-bottom:1px solid #e7ece9}
#dexDetail .stat small{font-size:11px;font-weight:850}
#dexDetail .stat b{font-size:20px;margin-top:4px}
#dexDetail .detail-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}
#dexDetail .detail-tabs button{min-height:48px;border-radius:13px;background:#fff;border:1px solid var(--line);font-size:15px;font-weight:950}
#dexDetail .detail-tabs button.on{background:#08a35b;color:#fff;border-color:#08a35b}
#dexDetail .ability-card{background:#fff;border-radius:17px;margin-bottom:10px;overflow:hidden}
#dexDetail .ability-title{display:flex;align-items:center;gap:9px;padding:12px 13px 8px;font-size:23px;font-weight:950}
#dexDetail .rate-badge{font-size:12px;background:#ffe6ef;color:#e72d70;border-radius:8px;padding:6px 9px}
.food-table-head,.food-line{display:grid;grid-template-columns:minmax(120px,1.35fr) repeat(3,50px) minmax(92px,1fr);align-items:center}
.food-table-head{padding:0 10px 5px;color:#168fe6;font-size:10px;font-weight:950}
.food-table-head span{text-align:center;background:#eaf5ff;border-radius:7px;padding:4px 2px;margin:0 2px}
.food-table-head span:first-child,.food-table-head span:last-child{background:transparent}
.food-line{min-height:70px;border-top:1px solid #edf1ef;padding:6px 10px}
.food-id{display:grid;grid-template-columns:34px 32px 1fr;align-items:center;gap:5px;min-width:0}
.food-letter{width:32px;height:43px;border-radius:8px;display:grid;place-items:center;font-size:21px;font-weight:950;background:#e8f7ef;color:#11965b}
.food-line:nth-child(2) .food-letter{background:#fff0f4;color:#e52e68}
.food-line:nth-child(3) .food-letter{background:#fff5df;color:#b86c00}
.food-icon{font-size:24px;text-align:center}.food-name{font-size:11px;font-weight:900}
.food-qty{text-align:center;font-size:14px;font-weight:950}
.recipe-strip{display:flex;gap:4px;overflow:hidden;align-items:center}
.recipe-ph{flex:0 0 30px;height:30px;border-radius:50%;background:#fff4e5;border:1px solid #f0dfc7;display:grid;place-items:center;font-size:13px}
.recipe-more{margin-left:auto;color:#ef8a00;font-size:22px;font-weight:950}
.skill-box{margin:0 10px 10px;border:1px solid #e4eaf1;border-radius:13px;padding:12px}
.skill-top{display:grid;grid-template-columns:50px 1fr auto;gap:9px;align-items:center}
.skill-icon{width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:#b648df;color:#fff;font-size:25px}
.skill-name{font-weight:950}.skill-level{white-space:nowrap;background:#edf6ff;border-radius:9px;padding:7px;color:#168fe6;font-weight:950}
.skill-desc{font-size:12px;line-height:1.55;margin:8px 0 0}
.skill-detail-toggle{width:100%;border:0;border-top:1px solid #edf1ef;background:#fff;padding:10px;font-weight:900;color:#32423b}
.skill-levels{display:none;border-top:1px solid #edf1ef;padding:7px 10px 10px}
.skill-levels.open{display:block}
.skill-level-row{display:grid;grid-template-columns:54px 1fr;gap:8px;padding:7px 4px;border-bottom:1px solid #f0f2f1;font-size:12px}
.skill-level-row:last-child{border-bottom:0}
.skill-level-row b{color:#168fe6}
#evolutionCard{border-radius:17px}
@media(max-width:430px){
 #dexDetail .hero-art{height:158px}
 #dexDetail .detail-nav .current strong{font-size:23px}
 .food-table-head,.food-line{grid-template-columns:minmax(110px,1.3fr) repeat(3,45px) minmax(82px,.95fr)}
 .recipe-ph:nth-child(n+4){display:none}
}

/* source: stable-v7-hero-fix */
#dexDetail .hero-top{grid-template-columns:minmax(105px,35%) minmax(0,65%)!important;align-items:stretch!important}
#dexDetail .hero-art{grid-column:1!important;grid-row:1!important;width:100%!important;height:100%!important;min-height:205px!important}
#dexDetail .hero-info{grid-column:2!important;grid-row:1!important;gap:8px!important}
#dexDetail .white-row{flex:0 0 auto!important;min-height:48px!important}
#dexDetail .stats{min-width:0!important;flex:1 1 auto!important;grid-template-columns:1fr 1fr!important}
#dexDetail .stat{min-width:0!important;padding:8px!important}
#dexDetail .stat b{font-size:17px!important;word-break:keep-all}
@media(max-width:430px){
 #dexDetail .hero-top{grid-template-columns:34% 66%!important;gap:7px!important}
 #dexDetail .hero-art{min-height:190px!important}
 #dexDetail .stat{padding:6px!important}
 #dexDetail .stat small{font-size:9px!important}
 #dexDetail .stat b{font-size:15px!important}
}

/* source: stable-v9-layout */
/* v9 test case: left is art; right owns navigation, name, traits and all four metrics */
#dexDetail .detail-nav{display:none!important}
#dexDetail .hero-top{gap:8px!important}
#dexDetail .hero-art{min-height:255px!important}
#dexDetail .hero-info{gap:7px!important}
.v9-poke-nav{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.v9-poke-nav button{min-width:0;border:1px solid #dbe4df;background:#fff;border-radius:11px;padding:6px 4px;font-size:10px;font-weight:900;line-height:1.25}
.v9-poke-nav button:disabled{opacity:.35}
.v9-name{text-align:center;background:#fff;border-radius:12px;padding:7px 5px}
.v9-name small{display:block;font-weight:900;font-size:10px}
.v9-name strong{display:block;font-size:21px;line-height:1.05}
.v9-traits{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.v9-trait{background:#fff;border-radius:9px;padding:6px 2px;text-align:center;font-size:10px;font-weight:900}
#dexDetail .stats{flex:1!important}
#dexDetail .stat{min-height:62px!important}
#dexDetail .stat small{font-size:9px!important}
#dexDetail .stat b{font-size:14px!important}
.v9-est{font-size:8px;color:#8a6c00;font-weight:800}
.v9-skill-level-select{display:flex;gap:4px;overflow-x:auto;margin-top:10px;padding-bottom:2px}
.v9-skill-level-select button{flex:0 0 38px;border:1px solid #dbe4df;background:#fff;border-radius:8px;padding:6px 2px;font-size:11px;font-weight:900}
.v9-skill-level-select button.on{background:#168fe6;color:#fff;border-color:#168fe6}
.v9-skill-tags{display:flex;gap:5px;margin-top:7px}
.v9-skill-tag{font-size:10px;background:#edf7ef;border-radius:999px;padding:4px 7px;font-weight:900}
.v9-evo-btn{width:100%;border:1px solid #dbe4df;background:#fff;border-radius:10px;padding:9px;font-weight:900}

/* source: stable-v10-detail-cleanup */
/* Single-detail-controller cleanup */
#dexDetail .detail-nav{display:none!important}
#dexDetail .hero-info>.white-row{display:none!important} /* remove duplicate type/sleep/specialty row */
#dexDetail .hero-top{gap:9px!important}
#dexDetail .hero-art{min-height:250px!important;height:100%!important}
#dexDetail .hero-info{gap:7px!important;min-width:0!important}
.v10-nav{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.v10-nav button{border:1px solid #dbe4df;background:#fff;border-radius:11px;padding:7px 4px;font-size:10px;font-weight:900;min-width:0}
.v10-nav button:disabled{opacity:.35}
.v10-name{text-align:center;background:#fff;border-radius:11px;padding:6px}
.v10-name small{display:block;font-size:10px;font-weight:900}
.v10-name strong{display:block;font-size:21px;line-height:1.1}
.v10-traits{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.v10-traits span{background:#fff;border-radius:9px;padding:6px 2px;text-align:center;font-size:10px;font-weight:900}
#dexDetail .stats{width:100%!important;display:grid!important;grid-template-columns:1fr 1fr!important;flex:1!important}
#dexDetail .stat{min-height:61px!important;padding:7px!important}
#dexDetail .stat small{font-size:9px!important} #dexDetail .stat b{font-size:15px!important}
.food-table-head{font-size:14px!important}
.food-table-head span{padding:7px 3px!important}
.food-qty{font-size:17px!important}
.skill-desc{font-size:16px!important;font-weight:700}
.skill-level-row{font-size:14px!important;line-height:1.5}
.v10-evo{width:100%;border:1px solid #dbe4df;background:#fff;border-radius:10px;padding:10px;font-weight:900}

/* source: stable-v11-fixes */
/* Actual DOM structure fix: stats is moved inside .hero-info by JS */
#dexDetail .hero{padding:10px!important}
#dexDetail .hero-top{gap:9px!important;align-items:stretch!important}
#dexDetail .hero-art{min-height:265px!important;height:100%!important}
#dexDetail .hero-info{min-width:0!important;gap:7px!important}
#dexDetail .hero-info>.stats{margin-top:0!important;flex:1!important}
.v11-nav{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.v11-nav button{border:1px solid #dbe4df;background:#fff;border-radius:11px;padding:7px 4px;font-size:10px;font-weight:900}
.v11-nav button:disabled{opacity:.35}
.v11-name{text-align:center;background:#fff;border-radius:11px;padding:6px}
.v11-name small{display:block;font-size:10px;font-weight:900}
.v11-name strong{display:block;font-size:22px}
.v11-traits{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.v11-traits span{background:#fff;border-radius:9px;padding:7px 2px;text-align:center;font-size:11px;font-weight:900}
#dexDetail .stat{min-height:62px!important}
.food-table-head{font-size:15px!important;font-weight:950!important}
.food-qty{font-size:18px!important}
.skill-desc{font-size:17px!important;line-height:1.65!important;font-weight:750!important}
.skill-level-row{font-size:15px!important}
.v11-lv{display:flex;align-items:center;gap:3px}
.v11-lv button{border:0;background:#edf6ff;color:#168fe6;border-radius:8px;padding:7px 9px;font-size:18px;font-weight:950}
.v11-lv b{background:#edf6ff;color:#168fe6;border-radius:8px;padding:8px 10px;white-space:nowrap}
.v11-evo{width:100%;border:1px solid #dbe4df;background:#fff;border-radius:10px;padding:10px;font-weight:900}
/* source: stable-v14-detail-ui */
/* v12: fixed hero, right-side information, tabs switch only the content below */
#dexDetail{--type-bg:#eaf7ed;--type-accent:#55a66b}
#dexDetail .hero{
  background:var(--type-bg)!important;
  border-color:color-mix(in srgb,var(--type-accent) 22%, #dfe8e2)!important;
}
#dexDetail .hero-top{
  display:grid!important;
  grid-template-columns:36% minmax(0,64%)!important;
  gap:10px!important;
  align-items:stretch!important;
}
#dexDetail .hero-art{
  min-height:285px!important;
  background:rgba(255,255,255,.58)!important;
}
#dexDetail .hero-info{
  display:flex!important;
  flex-direction:column!important;
  gap:8px!important;
}
.v12-title-row{
  display:grid;
  grid-template-columns:minmax(150px,1fr) auto;
  align-items:center;
  gap:8px;
  background:rgba(255,255,255,.72);
  border-radius:12px;
  padding:8px 10px;
}
.v12-name{text-align:left}
.v12-name small{display:block;font-size:10px;font-weight:900}
.v12-name strong{display:block;font-size:22px;line-height:1.12}
.v12-traits{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}
.v12-traits span{
  background:#fff;border-radius:999px;padding:6px 8px;
  font-size:10px;font-weight:900;white-space:nowrap
}
.v12-nav{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.v12-nav button{
  border:1px solid rgba(0,0,0,.08);background:rgba(255,255,255,.78);
  border-radius:11px;padding:7px 4px;font-size:10px;font-weight:900
}
.v12-nav button:disabled{opacity:.32}
#dexDetail .hero-info>.stats{
  display:grid!important;grid-template-columns:1fr 1fr!important;
  width:100%!important;margin:0!important;flex:1!important;
  background:rgba(255,255,255,.68)!important
}
#dexDetail .stat{min-height:59px!important}
.v12-tabs{
  display:grid;grid-template-columns:repeat(3,1fr);gap:6px;
  margin-top:auto
}
.v12-tabs button{
  min-height:43px;border:1px solid rgba(0,0,0,.08);
  border-radius:10px;background:rgba(255,255,255,.82);
  font-size:14px;font-weight:950
}
.v12-tabs button.active{
  background:var(--type-accent);color:#fff;border-color:var(--type-accent)
}
/* old tab row is no longer part of layout */
#dexDetail>.detail-tabs,#dexDetail .detail-tabs:not(.v12-tabs){display:none!important}
.v12-panel{display:none}
.v12-panel.active{display:block}
#dexDetail .ability-content{display:block!important}
#dexDetail .section-head{
  display:flex!important;align-items:center!important
}
#dexDetail .section-head .badge{align-self:center!important}
#skillDetailToggle{
  font-size:11px!important;font-weight:800!important;padding:5px 8px!important
}
.v11-lv button,.v12-lv button{
  min-width:48px!important;min-height:44px!important;font-size:24px!important
}
.v12-placeholder{
  background:#fff;border:1px solid #e4ebe7;border-radius:14px;
  padding:20px;text-align:center;font-weight:800;color:#6f7c75
}
@media(max-width:620px){
  #dexDetail .hero-top{grid-template-columns:38% minmax(0,62%)!important;gap:6px!important}
  .v12-title-row{grid-template-columns:1fr;padding:6px}
  .v12-traits{justify-content:flex-start}
  .v12-name strong{font-size:18px}
  .v12-traits span{font-size:9px;padding:5px}
  .v12-tabs button{font-size:12px}
}

/* Team ingredient coverage is based on the selected individual and unlocked slots. */
.psg-home-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
.psg-home-heading h2{margin:0;flex:none}
.psg-home-field{display:flex;align-items:center;gap:5px;min-width:0;font-size:12px;font-weight:700}
.psg-home-field select{min-width:0;max-width:min(54vw,240px);min-height:40px;padding:5px 8px;border:1px solid #d7e0da;border-radius:10px;background:#fff;color:#111;font:inherit;font-size:14px}
.psg-team-face-dock:not([hidden]){position:fixed;top:var(--psg-header-height);left:50%;transform:translateX(-50%);z-index:66;box-sizing:border-box;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;width:min(100%,720px);padding:5px 12px;background:var(--bg);border-bottom:1px solid #dce5df;box-shadow:0 3px 8px #1b36241a}
.psg-team-face-dock-cell{min-width:0;padding:2px;border:1px solid #dfe8e3;border-radius:9px;background:#fff;cursor:pointer}
.psg-team-face-dock-cell .psg-team-face{width:100%;height:42px;border-radius:6px}
.psg-team-face-dock[hidden]{display:none}
.psg-team-row{display:flex;align-items:center;gap:7px;margin:7px 0}
.psg-team-choose{display:flex;align-items:center;gap:9px;flex:1;min-width:0;min-height:58px;padding:5px 9px;text-align:left;background:#fff;color:#111;border:1px solid #dfe8e3;border-radius:12px;cursor:pointer;font:inherit}
.psg-team-face{display:grid;place-items:center;flex:0 0 46px;width:46px;height:46px;border-radius:10px;background:#f2f6f4;color:#83918a;font-size:9px;font-weight:700;overflow:hidden}
.psg-team-face img{width:100%;height:100%;object-fit:contain}
.psg-team-identity{display:flex;flex-direction:column;gap:2px;min-width:0}
.psg-team-identity strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px}
.psg-team-identity small,.psg-team-option small{color:#68776f;font-size:11px}
.psg-team-identity .psg-team-speed{color:#111;line-height:1.2}
.psg-team-choose-arrow{margin-left:auto;font-size:10px;color:#668677}
.psg-team-actions{display:flex;gap:3px}
.psg-team-actions button{min-width:37px;min-height:44px;padding:5px;border:1px solid #dfe8e3;background:#fff;border-radius:9px;color:#376d53;font:inherit;font-weight:800;cursor:pointer}
.psg-team-actions button:disabled{opacity:.28;cursor:default}
.psg-team-actions .psg-team-remove{font-size:10px;color:#69776f;min-width:42px}
.psg-team-picker{margin:0 0 11px;padding:10px;border:1px solid #dfe8e3;border-radius:12px;background:#f7faf8}
.psg-team-picker>input{box-sizing:border-box;width:100%;margin:0 0 9px;padding:9px 10px;border:1px solid #dfe8e3;border-radius:9px;font:inherit;font-size:16px}
.psg-team-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;max-height:240px;overflow:auto;overscroll-behavior:contain}
.psg-team-option{display:flex;align-items:center;gap:7px;min-width:0;padding:6px;text-align:left;border:1px solid #dfe8e3;border-radius:10px;background:#fff;color:#111;cursor:pointer;font:inherit}
.psg-team-option>.psg-team-face{flex-basis:40px;width:40px;height:40px}
.psg-team-option>span:last-child{display:flex;flex-direction:column;min-width:0}
.psg-team-option strong{font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.psg-team-option:disabled{opacity:.5;cursor:default}
.psg-team-option[hidden]{display:none}
.psg-team-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px}
.psg-team-toolbar .note{flex:1}
.psg-team-toolbar button,.psg-team-picker-remove{min-height:44px;padding:7px 11px;border:1px solid #d5e3db;border-radius:10px;background:#fff;color:#276747;font:inherit;font-size:12px;font-weight:700;cursor:pointer}
.psg-team-toolbar button[aria-pressed="true"]{background:#e5f4e9;border-color:#70af82}
.psg-team-toolbar button:disabled{opacity:.45;cursor:default}
.psg-team-hint,.psg-team-picker-hint{font-size:12px;color:#40644f;line-height:1.4;margin:4px 0 8px}
.psg-team-row{margin:5px 0}
.psg-team-number{flex:none;display:grid;place-items:center;width:20px;color:#5a7564;font-size:13px;font-weight:700}
.psg-team-choose{min-height:60px}
.psg-team-row.is-reorder-source .psg-team-choose{border:2px solid #388c55;background:#ecf8ee}
.psg-team-row.is-reordering .psg-team-choose-arrow{font-size:11px;white-space:nowrap}
.psg-team-picker{margin-left:27px}
.psg-team-picker-remove{margin-bottom:5px}
/* Home team cards share the Box's five-column rhythm. The picker spans the row. */
#teamSlots{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;align-items:start}
#teamSlots .psg-team-row{position:relative;display:flex;flex-direction:column;min-width:0;margin:0;gap:0}
#teamSlots .psg-team-number{position:absolute;top:4px;left:4px;z-index:1;width:15px;height:15px;border-radius:50%;background:#fff;color:#345944;font-size:10px}
#teamSlots .psg-team-choose{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:1px;width:100%;min-height:123px;padding:3px 2px;text-align:center;border-radius:10px}
#teamSlots .psg-team-choose[class*="type-"]{background:var(--psg-type-bg)}
#teamSlots .psg-team-card-name{display:block;width:100%;padding-left:13px;box-sizing:border-box;color:#111;font-size:11px;line-height:1.15;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#teamSlots .psg-team-card-art{position:relative;display:block;width:100%}
#teamSlots .psg-team-face{flex:0 0 auto;width:100%;height:62px;border-radius:6px}
#teamSlots .psg-team-card-level{position:absolute;right:1px;bottom:1px;padding:1px 2px;border-radius:3px;background:#ffffffe8;color:#111;font-size:10px;font-weight:950;line-height:1.15}
#teamSlots .psg-team-identity{width:100%;gap:0}
#teamSlots .psg-team-identity strong{font-size:11px}
#teamSlots .psg-team-identity small{font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#teamSlots .psg-team-speed{display:none}
#teamSlots .psg-team-choose-arrow{margin:0;font-size:9px}
#teamSlots .psg-team-picker{grid-column:1/-1;margin:0 0 4px}
.psg-box-team-mode{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin:0 0 10px;padding:10px;border:1px solid #83bc98;border-radius:12px;background:#edf8f0;font-size:12px}
.psg-box-team-mode[hidden]{display:none}
.psg-box-team-mode strong{font-size:14px}
.psg-box-team-mode span{flex:1 1 100%}
.psg-box-team-mode button{min-height:38px;padding:5px 9px;border:1px solid #78ab8a;border-radius:8px;background:#fff;color:#286a47;font-weight:700}
.psg-team-option.is-selected{border-color:#70af82;background:#eff8f1}
.psg-team-toolbar button:focus-visible,.psg-team-picker-remove:focus-visible{outline:2px solid #438ac8;outline-offset:2px}
.psg-team-choose:focus-visible,.psg-team-actions button:focus-visible,.psg-team-option:focus-visible{outline:2px solid #438ac8;outline-offset:2px}
@media(max-width:355px){.psg-team-choose{gap:5px;padding:5px}.psg-team-face{flex-basis:40px;width:40px;height:40px}.psg-team-actions button{min-width:31px}.psg-team-actions .psg-team-remove{min-width:37px}}
.psg-team-food-card,.psg-team-recipe-card{margin-top:12px}
.psg-day-card{margin-top:12px}
.psg-day-header{display:flex;align-items:center;justify-content:space-between;gap:6px}
.psg-day-header .section-title{margin:0;min-width:0}
.psg-day-setting{display:flex;align-items:center;justify-content:flex-end;gap:5px;white-space:nowrap;font-size:12px;font-weight:700}
.psg-day-setting select{font:inherit;color:#111;background:#fff;border:1px solid #d7e0da;border-radius:9px;padding:6px 3px;min-width:0;max-width:76px}
.psg-day-toggles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
.psg-day-camp{font:inherit;font-weight:700;color:#285843;background:#fff;border:1px solid #b8d3c0;border-radius:12px;padding:9px 12px;min-height:42px}
.psg-day-camp[aria-pressed="true"]{background:#dff2e6;border-color:#61a878;color:#174b30}
.psg-day-energy{border:0;padding:0;margin:12px 0 0;min-width:0}
.psg-day-energy legend{font-weight:700;padding:0;margin-bottom:7px;color:#111}
.psg-day-energy-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}
.psg-day-energy-options button{font:inherit;font-weight:700;color:#111;background:#fff;border:1px solid #d7e0da;border-radius:12px;min-height:42px;padding:6px}
.psg-day-energy-options button[aria-pressed="true"]{background:#e8f2fc;border-color:#3888d8;color:#145c9e}
.psg-day-field{border:1px solid #dce4df;border-radius:12px;padding:8px 10px 10px;margin:12px 0;min-width:0}
.psg-day-field legend{font-weight:700;padding:0 5px;color:#111}
.psg-day-berries{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-bottom:8px}
.psg-day-berries label{font-size:.8em;color:#52645b;min-width:0}
.psg-day-berries select{width:100%;font:inherit;font-size:1.12em;color:#111;background:#fff;border:1px solid #d7e0da;border-radius:9px;padding:7px 2px;min-height:38px}
.psg-day-field-link{width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px;margin:12px 0;padding:10px 12px;text-align:left;font:inherit;font-size:.88em;font-weight:700;color:#24583d;background:#f1f8f3;border:1px solid #cbded0;border-radius:12px}
.psg-day-field-link span{min-width:0}.psg-day-field-link b{font-size:1.4em}
.psg-field-settings>label{display:block;margin:12px 0 5px;font-weight:700}
.psg-field-settings>select{width:100%;font:inherit;padding:9px;color:#111;background:#fff;border:1px solid #d7e0da;border-radius:10px}
.psg-field-percent{display:flex;align-items:center;gap:6px}
#fieldAreaBonus{font:inherit;color:#111;background:#fff;border:1px solid #d7e0da;border-radius:9px;padding:8px;width:5.5em;text-align:right}
.psg-field-week{margin:15px 0 5px;color:#617269;font-size:.85em}
.psg-field-settings .psg-day-field{margin:8px 0}.psg-field-settings .psg-day-berries{margin-bottom:0}
.psg-field-reset{margin-top:8px;color:#316caa}.psg-field-reset[hidden]{display:none}
.psg-field-encounters{margin-top:12px}
.psg-field-rank-label{display:flex;align-items:center;justify-content:space-between;gap:10px;font-weight:800;margin:12px 0}
.psg-field-rank-label select{font:inherit;max-width:55%;min-height:40px;border:1px solid #d7e0da;border-radius:10px;background:#fff;color:#111;padding:6px}
.psg-field-rank-details{margin:10px 0 16px;border:1px solid #dce6e0;border-radius:12px;background:#fff;padding:9px 12px}
.psg-field-rank-details summary{cursor:pointer;color:#316caa;font-weight:800}
.psg-field-rank-details .psg-field-encounter-row{padding:5px 0}
.psg-field-species{background:#fff;border:1px solid #dce6e0;border-radius:14px;padding:12px;margin:10px 0}
.psg-field-species h4{margin:0 0 8px;font-size:1em}
.psg-field-species-name{display:block;width:100%;background:none;border:0;padding:0 0 8px;text-align:left;color:#316caa;font:inherit;font-weight:800;cursor:pointer}
.psg-field-encounter-row{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:7px 0;border-top:1px solid #e9eeeb;font-size:.92em}
.psg-field-encounter-row strong{white-space:nowrap;font-size:.92em}
#v12Field{padding:10px 4px 24px}
#v12Field>h3{margin:10px 4px}
#v12Field>.note{margin:4px 4px 12px}
.psg-day-method{margin-top:10px;color:#596861;font-size:.85em}
.psg-day-method summary{cursor:pointer;color:#316caa;font-weight:700;padding:4px 0}
.psg-day-method p{line-height:1.5;margin:5px 0 0}
.psg-day-list{display:grid;gap:0;border:1px solid #dce4df;border-radius:14px;overflow:hidden}
.psg-day-row{display:grid;gap:4px;padding:9px 12px;background:#fff;color:#111}
.psg-day-row+.psg-day-row{border-top:1px solid #e6ebe8}
.psg-day-row span{font-size:.86em;line-height:1.4}
.psg-day-total{font-weight:700;line-height:1.45;margin:10px 0}
.psg-day-food-list{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px}
.psg-day-food-tile{display:flex;align-items:center;gap:5px;min-width:0;max-width:100%;padding:3px 6px;border:1px solid #dfe8e3;border-radius:9px;background:#f7faf8}
.psg-day-food-tile>img,.psg-day-food-tile>span:first-child{width:28px;height:28px;flex:none;object-fit:contain}
.psg-day-food-tile>span:last-child{display:flex;flex-direction:column;min-width:0;line-height:1.12}
.psg-day-food-tile small{font-size:10px;font-weight:600;white-space:nowrap}.psg-day-food-tile strong{font-size:12px;white-space:nowrap}
.psg-team-food-list{display:grid;gap:8px}
.psg-team-food-item{display:flex;align-items:center;gap:10px;padding:9px 11px;border:1px solid #e2e9e5;border-radius:13px;background:#fafcfb;min-width:0}
.psg-team-food-item>img,.psg-team-food-item>span:first-child{width:34px;height:34px;object-fit:contain;flex:none}
.psg-team-food-item>span:last-child{display:flex;flex-direction:column;gap:2px;min-width:0}
.psg-team-food-item strong{color:#111}.psg-team-food-item small{color:#60716a;line-height:1.45;overflow-wrap:anywhere}
.psg-team-food-card>.note{margin:8px 0 0}
#teamRecipeList{display:grid;gap:8px;margin-top:10px}
.psg-team-recipe-group{border:1px solid #dfe8e3;border-radius:13px;background:#fff;overflow:hidden}
.psg-team-recipe-group-title{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px;cursor:pointer;color:#111;list-style:none}
.psg-team-recipe-group-title::-webkit-details-marker{display:none}
.psg-team-recipe-group-title>strong{flex:1}.psg-team-recipe-group-title>small{font-size:.77em;color:#66766f;white-space:nowrap}
.psg-team-recipe-group-title:after{content:'▾';font-size:13px;color:#66766f}
.psg-team-recipe-group[open]>.psg-team-recipe-group-title:after{transform:rotate(180deg)}
.psg-team-recipe-items{display:grid;gap:7px;padding:0 9px 9px}
.psg-team-recipe-row{display:flex;flex-direction:column;gap:3px;width:100%;padding:10px 12px;text-align:left;background:#f9fbfa;color:#111;border:1px solid #e2e9e5;border-radius:10px;cursor:pointer}
.psg-team-recipe-row>strong{overflow-wrap:anywhere}
.psg-team-recipe-meta{color:#64756d;font-size:.78em}
.psg-team-recipe-status{color:#68766f;font-size:.8em;line-height:1.35;overflow-wrap:anywhere}
.psg-team-recipe-status.is-covered{color:#267650;font-weight:700}
.psg-team-recipe-row:focus-visible,.psg-team-recipe-group-title:focus-visible{outline:2px solid #438ac8;outline-offset:-2px}

/* v13: slightly larger navigation and number */
#dexDetail .v12-nav button{
  min-height:42px!important;
  font-size:12px!important;
  padding:9px 6px!important;
}
#dexDetail .v12-name small{
  font-size:14px!important;
  line-height:1.15!important;
  margin-bottom:2px!important;
}
/* Three compact metrics in one row */
#dexDetail .hero-info>.stats{
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:5px!important;
  flex:0 0 auto!important;
  background:transparent!important;
  padding:0!important;
}
#dexDetail .hero-info>.stats .stat{
  min-height:64px!important;
  padding:7px 4px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  text-align:center!important;
  background:rgba(255,255,255,.76)!important;
  border-radius:10px!important;
}
#dexDetail .hero-info>.stats .stat small{
  font-size:9px!important;
  white-space:nowrap!important;
}
#dexDetail .hero-info>.stats .stat b{
  margin-top:5px!important;
  font-size:15px!important;
}
/* Berry is a compact standalone chip rather than a fourth metric */
.v13-berry{
  display:inline-flex;align-items:center;gap:5px;
  align-self:flex-start;
  padding:5px 8px;border-radius:999px;
  background:rgba(255,255,255,.78);
  font-size:10px;font-weight:900;
}
/* Food table: fixed shared vertical axes */
.v13-food-head,.v13-food-row{
  display:grid!important;
  grid-template-columns:minmax(118px,1.35fr) 46px 50px 50px minmax(110px,1.2fr)!important;
  align-items:center!important;
  column-gap:0!important;
  width:100%!important;
}
.v13-food-head{
  min-height:38px;
  font-size:10px;font-weight:950;
  border-bottom:1px solid #e8ece9;
}
.v13-food-title{
  display:flex;align-items:center;gap:6px;min-width:0;
}
.v13-food-rate{
  display:inline-flex;align-items:center;
  padding:3px 6px;border-radius:999px;
  background:#f1f5f2;font-size:9px;white-space:nowrap;
}
.v13-food-head>div:not(:first-child),
.v13-food-row>.v13-level{text-align:center}
.v13-food-row{
  min-height:54px;border-bottom:1px solid #edf0ee;
}
.v13-food-name{
  display:flex;align-items:center;gap:5px;min-width:0;
  font-size:11px;font-weight:850;
}
.v13-food-name .food-letter{
  flex:0 0 auto;width:18px;height:18px;display:grid;place-items:center;
  border-radius:6px;background:#f1f4f2;font-size:9px
}
.v13-food-name .food-icon{font-size:17px}
.v13-food-name .food-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.v13-level{font-size:12px;font-weight:900}
.v13-recipes{
  min-width:0;overflow-x:auto;white-space:nowrap;
  scrollbar-width:none;padding:3px 2px
}
.v13-recipes::-webkit-scrollbar{display:none}
.v13-recipes span{display:inline-block;margin-right:3px}
@media(max-width:620px){
  .v13-food-head,.v13-food-row{
    grid-template-columns:minmax(105px,1.25fr) 39px 43px 43px minmax(92px,1.1fr)!important;
  }
  .v13-food-rate{font-size:8px;padding:3px 4px}
  .v13-food-head{font-size:9px}
  .v13-food-name{font-size:10px}
}

#v12Ability .section-head:has(#foodRateBadge){display:none!important}

/* source: stable-v19-three-fixes */
/* Identity and traits */
#dexDetail .v19-identity{
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  padding:8px 10px;background:rgba(255,255,255,.74);border-radius:12px;
}
#dexDetail .v19-identity .v19-no{font-size:14px;font-weight:950}
#dexDetail .v19-identity strong{font-size:21px;line-height:1.1}
#dexDetail .v19-type{
  margin-left:auto;padding:5px 8px;background:#fff;border-radius:999px;
  font-size:11px;font-weight:950;white-space:nowrap
}
#dexDetail .v19-traits{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px
}
#dexDetail .v19-traits span{
  min-height:34px;display:flex;align-items:center;justify-content:center;
  padding:5px;background:rgba(255,255,255,.76);border-radius:9px;
  font-size:10px;font-weight:900;text-align:center
}
#v13Berry{display:none!important}

/* Food: larger, readability-first; no strict vertical-axis requirement */
#detailFoods{font-size:13px!important}
#detailFoods .v13-food-head{
  min-height:46px!important;
  grid-template-columns:minmax(145px,1.5fr) 50px 54px 54px minmax(130px,1.25fr)!important;
  font-size:11px!important;
}
#detailFoods .v13-food-row{
  min-height:68px!important;
  grid-template-columns:minmax(145px,1.5fr) 50px 54px 54px minmax(130px,1.25fr)!important;
}
#detailFoods .v13-food-name{font-size:13px!important;gap:7px!important}
#detailFoods .v13-food-name .food-letter{
  width:23px!important;height:23px!important;font-size:11px!important
}
#detailFoods .v13-food-name .food-icon{font-size:23px!important}
#detailFoods .v13-level{font-size:15px!important}
#detailFoods .v13-recipes{font-size:22px!important;padding:6px 3px!important}
#detailFoods .v13-food-rate{padding:4px 7px!important}

/* Keep only one current skill level controller visible */
