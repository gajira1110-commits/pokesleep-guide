/* source: stable-v22-skill-root-fix */
/* Single authoritative skill header layout */
#v12Ability .skill-top{
  grid-template-columns:auto minmax(0,1fr) auto auto!important;
  width:100%!important;
}
#v12Ability .skill-name{min-width:0!important}
#v12Ability .skill-rate-inline{
  font-size:11px!important;
  padding:5px 8px!important;border-radius:999px!important;background:#f2f5f3!important
}
