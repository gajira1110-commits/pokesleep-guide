#v12Ability .skill-level{display:none!important}
@media(max-width:620px){
 #v12Ability .skill-top{gap:6px!important}
 #v12Ability .skill-rate-inline{font-size:10px!important;padding:4px 5px!important}
}

/* source: stable-v24-food-root-fix */
/* v24 owns the actual #detailFoods DOM generated by renderFood(). */
#detailFoods{display:block!important;overflow:visible!important;font-size:inherit!important}
#detailFoods .v24-food-title{gap:12px!important;
  min-height:48px!important;padding:0 8px!important;border-bottom:1px solid #e8edf4!important
}
#detailFoods .v24-food-title b{font-size:23px!important}
#detailFoods .v24-food-title span{
  padding:6px 12px!important;border-radius:10px!important;background:#ffe7ef!important;
  font-size:13px!important;font-weight:900!important;color:#e83269!important
}
#detailFoods .v24-food-row{
  display:grid!important;
  grid-template-columns:minmax(155px,1.45fr) 68px 68px 68px minmax(180px,1.65fr)!important;
  align-items:stretch!important;min-height:78px!important;width:100%!important;
  border-bottom:1px solid #e8edf4!important
}
#detailFoods .v24-food-name{
  display:grid!important;grid-template-columns:48px minmax(0,1fr)!important;
  align-items:center!important;gap:6px!important;padding:7px 8px!important
}
#detailFoods .v24-letter{
  display:grid!important;place-items:center!important;width:42px!important;height:48px!important;
  border-radius:10px!important;font-size:27px!important;font-weight:950!important
}
#detailFoods .v24-food-main{
  display:flex!important;flex-direction:column!important;align-items:center!important;
  justify-content:center!important;min-width:0!important
}
#detailFoods .v24-food-icon{font-size:30px!important;line-height:1!important}
#detailFoods .v24-food-icon img{display:block;width:1em;height:1em;object-fit:contain}
#detailFoods .v24-food-main b{
  margin-top:4px!important;font-size:12px!important;line-height:1.1!important;
  text-align:center!important;white-space:normal!important
}
#detailFoods .v24-level{
  display:flex!important;flex-direction:column!important;align-items:center!important;
  justify-content:center!important;border-left:1px solid #e8edf4!important
}
#detailFoods .v24-level small{
  padding:3px 7px!important;border-radius:7px!important;background:#eaf5ff!important;
  color:#078be8!important;font-size:11px!important;font-weight:900!important
}
#detailFoods .v24-level b{margin-top:9px!important;font-size:16px!important}
#detailFoods .v24-recipes{gap:9px!important;
  overflow-x:auto!important;padding:8px 9px!important;border-left:1px solid #e8edf4!important;
  background:#fffaf5!important;scrollbar-width:none!important
}
#detailFoods .v24-recipes::-webkit-scrollbar{display:none}
#detailFoods .v24-placeholder{
  flex:0 0 48px!important;height:48px!important;display:grid!important;place-items:center!important;
  border-radius:50%!important;background:#fff!important;font-size:26px!important
}
#detailFoods .v24-more{margin-left:auto!important;font-size:32px!important;font-weight:900!important;color:#ef8a00!important}
#detailFoods .slot-A .v24-food-name{background:#effbf5!important}
#detailFoods .slot-B .v24-food-name{background:#fff2f6!important}
#detailFoods .slot-C .v24-food-name{background:#fff8eb!important}
#detailFoods .slot-A .v24-letter{background:#d9f7e7!important;color:#079b57!important}
#detailFoods .slot-B .v24-letter{background:#ffe1eb!important;color:#e91e63!important}
#detailFoods .slot-C .v24-letter{background:#ffefd1!important;color:#ae6800!important}
@media(max-width:620px){
 #detailFoods{overflow-x:auto!important}
 #detailFoods .v24-food-title,#detailFoods .v24-food-row{min-width:590px!important}
 #detailFoods .v24-food-row{grid-template-columns:155px 66px 66px 66px minmax(180px,1fr)!important}
}

/* source: stable-v25-food-skill-unified */
/* The food heading alone needs a fixed minimum height. The skill heading
   follows its content so its Lv.1 effect sits directly below it. */
#detailFoods .v24-food-title{
  min-height:52px!important;
  box-sizing:border-box!important;
  border-bottom:1px solid #e8edf4!important;
}

/* Food heading: one compact label */
#detailFoods .v24-food-title{
  display:flex!important;
  align-items:center!important;
  gap:8px!important;
  padding:0 10px!important;
}
#detailFoods .v24-food-title b{
  font-size:18px!important;
  line-height:1!important;
  font-weight:950!important;
}
#detailFoods .v24-food-title span{
  background:transparent!important;
  padding:0!important;
  border-radius:0!important;
  color:#e83269!important;
  font-size:16px!important;
  font-weight:950!important;
}

/* Skill heading: name | trigger rate | one right-side level control */
#v12Ability .skill-top{
  grid-template-columns:minmax(0,1fr) auto auto!important;
}
#v12Ability .skill-icon:not(.has-image){display:none!important}
#v12Ability .skill-icon.has-image{display:grid!important;background:transparent!important}
#v12Ability .skill-icon.has-image img{display:block;width:100%;height:100%;object-fit:contain}
#v12Ability .skill-name{
  line-height:1.1!important;
}
#v12Ability .skill-name::before{
  content:"✨ ";
}
#v12Ability .skill-rate-inline{
  border-radius:0!important;
  font-size:13px!important;
}
#v12Ability #v12SkillLv{
  margin:0!important;
  justify-self:end!important;
  display:flex!important;
  align-items:center!important;
  gap:5px!important;
}
#v12Ability #v12SkillLv button{
  min-width:38px!important;
  min-height:38px!important;
  font-size:21px!important;
}
#v12Ability #v12SkillLv b{
  white-space:nowrap!important;
  font-size:14px!important;
}
#v12Ability .skill-desc{
  padding-top:12px!important;
}
@media(max-width:620px){
  #v12Ability .skill-top{
    grid-template-columns:minmax(0,1fr) auto auto!important;
    gap:6px!important;
    padding:0 7px!important;
  }
  #v12Ability .skill-name{font-size:15px!important}
  #v12Ability .skill-rate-inline{font-size:11px!important}
  #v12Ability #v12SkillLv button{min-width:34px!important;min-height:36px!important}
  #detailFoods .v24-food-title b{font-size:17px!important}
  #detailFoods .v24-food-title span{font-size:15px!important}
}

/* source: stable-v26-layout-refine */
/* Keep the Pokémon type color inside the identity block; the page follows its active tab. */
#dexDetail{
  --pane-bg:#f1f7ff;
  background:#f1f7ff!important;
  border-radius:18px!important;
}
#dexDetail:has(#v12Sleep.active){--pane-bg:#f6f1fb;background:#f6f1fb!important}
#dexDetail:has(#v12Field.active){--pane-bg:#f0f6f1;background:#f0f6f1!important}
#dexDetail .hero{
  background:color-mix(in srgb,var(--type-bg) 76%, white 24%)!important;
  border:1px solid color-mix(in srgb,var(--type-accent) 22%, transparent)!important;
}

/* Upper-right block: one consistent three-column rhythm. */
#dexDetail .hero-info{gap:7px!important}
#dexDetail .v19-identity{flex-wrap:nowrap!important;
  min-height:46px!important;padding:7px 10px!important;gap:7px!important;
  background:rgba(255,255,255,.78)!important;
}
#dexDetail .v19-identity strong{
}
#dexDetail .v19-type{
  margin-left:0!important;font-size:13px!important;
  background:color-mix(in srgb,var(--type-bg) 70%, white 30%)!important;
  border:1px solid color-mix(in srgb,var(--type-accent) 28%, transparent)!important;
}
#dexDetail .v26-variant-slot{
  margin-left:auto!important;min-width:0!important;
}
/* Future style/form selector goes here only when the master has variants. */
#dexDetail .v26-variant-slot:empty{display:block!important}

#dexDetail .v19-traits,
#dexDetail .hero-info>.stats,
#dexDetail .v12-tabs{
  display:grid!important;
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:7px!important;width:100%!important;
}
#dexDetail .v19-traits span{
  min-height:42px!important;font-size:11px!important;
  border:1px solid rgba(0,0,0,.035)!important;
}
#dexDetail .hero-info>.stats .stat{
  min-height:68px!important;border:1px solid rgba(0,0,0,.035)!important;
}
#dexDetail .hero-info>.stats .stat small{font-size:10px!important}
#dexDetail .hero-info>.stats .stat b{font-size:16px!important}

/* Bigger previous/next Pokémon controls. */
#dexDetail .v12-nav{gap:8px!important}
#dexDetail .v12-nav button{
  min-height:48px!important;font-size:13px!important;padding:10px 8px!important;
  border-radius:12px!important;
}

/* Tabs use fixed semantic colors, independent of Pokémon type. */
#dexDetail .v12-tabs{margin-top:0!important}
#dexDetail .v12-tabs button{
  min-height:48px!important;font-size:14px!important;border-width:1px!important;
  transition:filter .15s ease,transform .15s ease!important;
}
#dexDetail .v12-tabs button[data-v12tab="ability"]{
  background:#eaf4ff!important;color:#1768a6!important;border-color:#b8d9f5!important;
}
#dexDetail .v12-tabs button[data-v12tab="sleep"]{
  background:#f2ecff!important;color:#704bb2!important;border-color:#d8c7f5!important;
}
#dexDetail .v12-tabs button[data-v12tab="field"]{
  background:#eaf7ee!important;color:#347a4b!important;border-color:#bfe1c9!important;
}
#dexDetail .v12-tabs button[data-v12tab="ability"].active{
  background:#2f80c9!important;color:#fff!important;border-color:#2f80c9!important;
}
#dexDetail .v12-tabs button[data-v12tab="sleep"].active{
  background:#7957b8!important;color:#fff!important;border-color:#7957b8!important;
}
#dexDetail .v12-tabs button[data-v12tab="field"].active{
  background:#4d9662!important;border-color:#4d9662!important;
}

/* Food: probability + Lv.1/Lv.30/Lv.60 + recipes share one header grid. */
#detailFoods .v24-food-title{display:none!important}
#detailFoods .v26-food-head,
#detailFoods .v24-food-row{
  display:grid!important;
  grid-template-columns:minmax(155px,1.45fr) 68px 68px 68px minmax(180px,1.65fr)!important;
  width:100%!important;
}
#detailFoods .v26-food-head{
  align-items:center!important;color:#111!important;border-bottom:1px solid #e8edf4!important;
  background:#fff!important;
}
#detailFoods .v26-food-rate{
  text-align:center!important;font-size:16px!important;font-weight:950!important;
}
#detailFoods .v26-food-rate strong{font-size:16px!important}
#detailFoods .v26-level-pill{
  justify-self:center!important;padding:5px 10px!important;border-radius:8px!important;
  background:#eaf5ff!important;color:#078be8!important;
  font-size:13px!important;font-weight:950!important;white-space:nowrap!important;
}
#detailFoods .v26-recipe-head{
  text-align:center!important;font-size:13px!important;font-weight:950!important;
}
#detailFoods .v24-level small{display:none!important}
#detailFoods .v24-level b{margin-top:0!important;font-size:17px!important}

/* Skill: true left group (name + probability) and one right-side level control. */
#v12Ability .skill-top{
  gap:10px!important;padding:0 10px!important;
}
#v12Ability .skill-name{
  display:inline!important;
}
#v12Ability .skill-rate-inline{
  justify-self:start!important;margin-left:8px!important;
}
#v12Ability .skill-name,
#v12Ability .skill-rate-inline{grid-row:1!important}
#v12Ability .skill-name{grid-column:1!important}
#v12Ability .skill-rate-inline{
  grid-column:1!important;
  /* place the rate directly after the rendered skill name instead of in a separate wide column */
  padding-left:150px!important;
}
#v12Ability #v12SkillLv{grid-column:2!important;grid-row:1!important;justify-self:end!important}

/* Keep the skill name/rate visually joined without changing the single level controller. */
@supports(selector(:has(*))){
  #v12Ability .skill-top:has(.skill-rate-inline){
    grid-template-columns:minmax(0,1fr) auto!important;
  }
}

@media(max-width:620px){
  #dexDetail .v19-identity strong{font-size:20px!important}
  #dexDetail .v19-type{font-size:10px!important;padding:4px 6px!important}
  #dexDetail .v12-nav button{min-height:46px!important;font-size:11px!important}
  #dexDetail .v12-tabs button{min-height:46px!important;font-size:12px!important}
  #detailFoods{overflow-x:auto!important}
  #detailFoods .v26-food-head,#detailFoods .v24-food-row{min-width:590px!important}
  #v12Ability .skill-rate-inline{padding-left:126px!important;font-size:10px!important}
}

/* source: stable-v26-skill-group-fix */
#v12Ability .skill-top{
  display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
}
#v12Ability .v26-skill-left{flex-wrap:wrap!important;
}
#v12Ability .v26-skill-left .skill-name,
#v12Ability .v26-skill-left .skill-rate-inline{
  grid-column:auto!important;grid-row:auto!important;padding-left:0!important;margin-left:0!important;
}
#v12Ability .v26-skill-left .skill-rate-inline{white-space:nowrap!important}
@media(max-width:620px){
  #v12Ability .v26-skill-left{gap:6px!important}
  #v12Ability .v26-skill-left .skill-name{font-size:15px!important}
}

/* source: stable-v27-basic-block-check */
/* v27 confirmation pass: basic ability block only */

/* Line 1: equal white outlined previous/next controls. */
#dexDetail .v12-nav{
  gap:8px!important;
}
#dexDetail .v12-nav button,
#dexDetail .v12-nav button:disabled{
  min-height:50px!important;
  padding:10px 8px!important;
  border:1px solid rgba(0,0,0,.72)!important;
  border-radius:12px!important;
  background:#fff!important;
  color:#111!important;
  opacity:1!important;
  font-size:13px!important;
  font-weight:900!important;
}
#dexDetail .v12-nav button:disabled{cursor:default!important}

/* Give line 2 (name) and line 3 (traits) a little more breathing room. */
#dexDetail .v19-identity{margin-bottom:6px!important}

/* Lines 3 and 4: same three-column geometry and almost identical box height. */
#dexDetail .v19-traits,
#dexDetail .hero-info>.stats{
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:7px!important;
}
#dexDetail .v19-traits span,
#dexDetail .hero-info>.stats .stat{
  box-sizing:border-box!important;
  min-height:70px!important;
  border-radius:12px!important;
  padding:8px 5px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  text-align:center!important;
}
#dexDetail .v19-traits span{
  font-size:12px!important;
  font-weight:900!important;
}
#dexDetail .hero-info>.stats .stat{
  flex-direction:column!important;
  gap:2px!important;
}
#dexDetail .hero-info>.stats .stat small{
  line-height:1.15!important;
}
#dexDetail .hero-info>.stats .stat b{
  font-size:22px!important;
  line-height:1.05!important;
  letter-spacing:-.35px!important;
  white-space:nowrap!important;
}

/* Field tab: deeper green, independent from Pokémon type color. */
#dexDetail .v12-tabs button[data-v12tab="field"]{
  background:#e8f2eb!important;
  color:#214f31!important;
  border-color:#8db49a!important;
}
#dexDetail .v12-tabs button[data-v12tab="field"].active{
  border-color:#245b36!important;
}

@media(max-width:620px){
  #dexDetail .v12-nav button,
  #dexDetail .v12-nav button:disabled{
    min-height:48px!important;
    font-size:11px!important;
    padding:9px 5px!important;
  }
  #dexDetail .v19-identity{margin-bottom:5px!important}
  #dexDetail .v19-traits span,
  #dexDetail .hero-info>.stats .stat{
    min-height:66px!important;
    padding:6px 3px!important;
  }
  #dexDetail .v19-traits span{font-size:10px!important}
  #dexDetail .hero-info>.stats .stat small{font-size:9px!important}
  #dexDetail .hero-info>.stats .stat b{font-size:19px!important}
}

/* source: stable-v28-basic-block-refine */
/* v28: refinement of Basic Ability block */

/* 1st line: keep symmetry but reduce visual dominance. */
#dexDetail .v12-nav button,
#dexDetail .v12-nav button:disabled{
  min-height:41px!important;
  padding:7px 8px!important;
  border:1px solid rgba(45,52,48,.38)!important;
  border-radius:10px!important;
  background:rgba(255,255,255,.90)!important;
  color:#303733!important;
  font-size:11px!important;
  font-weight:800!important;
}

/* 2nd line: make the whole name strip the Pokémon type-color surface. */
#dexDetail .v19-identity{
  border:1px solid var(--type-accent)!important;
  border-radius:12px!important;
  padding:8px 10px!important;
  margin-bottom:7px!important;
  box-shadow:inset 4px 0 0 var(--type-accent)!important;
}
#dexDetail .v19-identity .v19-no{
  color:var(--type-accent)!important;
}
#dexDetail .v19-identity strong{
  color:#172019!important;
}
#dexDetail .v19-type{
  background:rgba(255,255,255,.64)!important;
  border-color:color-mix(in srgb,var(--type-accent) 45%, transparent)!important;
  color:var(--type-accent)!important;
}

/* 3rd line: stronger than before, but still below the main numeric values. */
#dexDetail .v19-traits span{
  min-height:66px!important;
  font-size:14px!important;
  font-weight:950!important;
  border-radius:12px!important;
}
#dexDetail .v19-traits span:first-letter{
  font-size:17px!important;
}

/* 4th line: match line 3 geometry and keep values as the visual focus. */
#dexDetail .hero-info>.stats .stat{
  min-height:66px!important;
  border-radius:12px!important;
}
#dexDetail .hero-info>.stats .stat small{
  font-size:10px!important;
  font-weight:850!important;
}
#dexDetail .hero-info>.stats .stat b{
  font-size:23px!important;
  font-weight:1000!important;
  line-height:1!important;
}

/* Tabs remain UI colors, not type colors. Field green stays clearly distinct. */
#dexDetail .v12-tabs button[data-v12tab="field"]{
  background:#f7faf8!important;
  color:#174a2b!important;
  border:1.5px solid #245b36!important;
}
#dexDetail .v12-tabs button[data-v12tab="field"].active{
  background:#245b36!important;
  color:#fff!important;
  border-color:#174526!important;
}

@media(max-width:620px){
  #dexDetail .v12-nav button,
  #dexDetail .v12-nav button:disabled{
    min-height:40px!important;
    font-size:10px!important;
  }
  #dexDetail .v19-traits span,
  #dexDetail .hero-info>.stats .stat{min-height:62px!important}
  #dexDetail .v19-traits span{font-size:12px!important}
  #dexDetail .hero-info>.stats .stat b{font-size:20px!important}
}

/* source: stable-v29-nav-image-check */
/* Line 1: mirror-symmetric around the center. */
#dexDetail .v12-nav{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
#dexDetail .v12-nav button,#dexDetail .v12-nav button:disabled{
 min-height:42px!important;padding:5px 9px!important;border:1px solid rgba(45,52,48,.30)!important;
 border-radius:10px!important;background:rgba(255,255,255,.90)!important;color:#303733!important;
 opacity:1!important;font-size:11px!important;font-weight:800!important;display:flex!important;align-items:center!important;gap:7px!important
}
#dexDetail #v12Prev{justify-content:flex-end!important;text-align:right!important}
#dexDetail #v12Next{justify-content:flex-start!important;text-align:left!important}
#dexDetail .v29-nav-img{
 width:31px!important;height:31px!important;flex:0 0 31px!important;border-radius:50%!important;
 display:flex!important;align-items:center!important;justify-content:center!important;
 background:rgba(255,255,255,.78)!important;color:var(--type-accent)!important;font-size:12px!important;overflow:hidden!important
}
#dexDetail .v29-nav-img img{width:100%!important;height:100%!important;object-fit:contain!important}
#dexDetail .v29-nav-name{white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
#dexDetail .v29-arrow{font-size:15px!important;line-height:1!important}
#dexDetail .v29-empty{width:100%!important;text-align:center!important;font-size:16px!important}

/* Agreed follow-ups: lighter name line, stronger line 3. */
#dexDetail .v19-identity{
 border:0!important;box-shadow:none!important;background:var(--type-bg)!important;
 padding:7px 9px!important;margin-bottom:5px!important
}
#dexDetail .v19-traits span{font-size:15px!important;font-weight:950!important}
@media(max-width:620px){
 #dexDetail .v12-nav button,#dexDetail .v12-nav button:disabled{min-height:40px!important;padding:4px 7px!important;font-size:10px!important;gap:5px!important}
 #dexDetail .v29-nav-img{width:28px!important;height:28px!important;flex-basis:28px!important}
 #dexDetail .v19-traits span{font-size:13px!important}
}

/* source: stable-v30-blocks-1to4-history */
/* v30 — reserved refinements for blocks 1–4. Keep borders quiet; use surfaces, spacing and hierarchy. */

/* 1-2: simple type surface, black Pokédex number, no framed/accent-strip treatment. */
#dexDetail .v19-identity .v19-no{color:#172019!important}

/* 2 block: remove the cheap white-card feel while preserving the accepted food grid. */
#v12Ability .ability-card:has(#detailFoods){
  background:#f7f9f8!important;
  border:0!important;
  box-shadow:none!important;
  border-radius:16px!important;
  padding:6px!important;
  overflow:hidden!important;
}
#detailFoods{background:transparent!important;border:0!important}
#detailFoods .v26-food-head{
  min-height:64px!important;
  background:#eef3f1!important;
  border-radius:12px!important;
  margin-bottom:5px!important;
}
#detailFoods .v26-food-rate{font-size:18px!important}
#detailFoods .v26-food-rate strong{font-size:19px!important}
#detailFoods .v26-level-pill,#detailFoods .v26-recipe-head{font-size:14px!important}
#detailFoods .v24-food-row{
  border-bottom:1px solid rgba(40,55,47,.08)!important;
}
#detailFoods .v24-food-row:last-child{border-bottom:0!important}

/* 3 block: one surface, no double frame. 3-1 is a real left group + right level control. */
#v12Ability .ability-card:has(#detailSkill){
  background:#f7f9f8!important;
  border:0!important;
  box-shadow:none!important;
  border-radius:16px!important;
  padding:14px!important;
}
#v12Ability .skill-box{
  margin:0!important;padding:0!important;border:0!important;border-radius:0!important;
  background:transparent!important;box-shadow:none!important;
}
#v12Ability .skill-top{padding:0!important;gap:12px!important}
#v12Ability .v26-skill-left{align-items:center!important;gap:8px!important;flex-wrap:nowrap!important;min-width:0!important;
}
#v12Ability .skill-icon{flex:0 0 auto!important}
#v12Ability .skill-name{flex:0 1 auto!important;white-space:nowrap!important;font-size:18px!important}
#v12Ability .skill-rate-inline{
  flex:0 0 auto!important;white-space:nowrap!important;margin:0!important;padding:0!important;
  font-size:12px!important;color:#68736d!important;background:transparent!important;
}
#v12Ability #v12SkillLv{flex:0 0 auto!important;justify-self:end!important}
#v12Ability .skill-desc{margin:13px 0 5px!important;padding-top:11px!important;border-top:1px solid rgba(40,55,47,.08)!important}
#v12Ability .skill-detail-toggle{opacity:.72!important;font-size:12px!important}

/* 4 block: forward evolution only. Variable-height requirements -> arrow -> destination image/type. */
#v12Ability #evolutionCard{
  background:#f7f9f8!important;border:0!important;box-shadow:none!important;border-radius:16px!important;padding:14px!important;
}
#v12Ability #evolutionCard .section-title{margin-bottom:8px!important}
#detailEvolution{display:flex!important;flex-direction:column!important;gap:8px!important}
.v30-evo-row{
  width:100%!important;display:grid!important;grid-template-columns:minmax(95px,1fr) 34px minmax(92px,1fr)!important;
  align-items:center!important;gap:8px!important;border:0!important;background:#eef3f1!important;border-radius:13px!important;padding:10px 12px!important;
  color:#26312b!important;text-align:left!important;cursor:pointer!important;
}
.v30-evo-conditions{display:flex!important;flex-direction:column!important;gap:4px!important;font-weight:900!important;font-size:13px!important;line-height:1.25!important}
.v30-evo-arrow{text-align:center!important;font-size:22px!important;font-weight:900!important;color:#65716b!important}
.v30-evo-target{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:4px!important;min-width:0!important}
.v30-evo-image{width:58px!important;height:58px!important;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important}
.v30-evo-image img{width:100%!important;height:100%!important;object-fit:contain!important}
.v30-evo-image .fallback{font-size:26px!important;color:var(--type-accent)!important}
.v30-evo-type{font-size:11px!important;font-weight:900!important;padding:3px 7px!important;border-radius:999px!important;background:#fff!important;border:1px solid rgba(40,55,47,.10)!important;white-space:nowrap!important}

@media(max-width:620px){
  #detailFoods .v26-food-rate{font-size:16px!important}
  #detailFoods .v26-food-rate strong{font-size:17px!important}
  #detailFoods .v26-level-pill,#detailFoods .v26-recipe-head{font-size:13px!important}
  #v12Ability .v26-skill-left{gap:5px!important}
  #v12Ability .skill-name{font-size:15px!important}
  #v12Ability .skill-rate-inline{font-size:10px!important}
  .v30-evo-row{grid-template-columns:minmax(82px,1fr) 26px minmax(78px,.9fr)!important;padding:9px!important;gap:6px!important}
  .v30-evo-image{width:52px!important;height:52px!important}
}

/* source: stable-v31-reserved-refine */
/* v31 — execute the approved refinement reservations. */
/* 1-1: lightweight image-only previous/next navigation. */
#dexDetail .v12-nav{align-items:center!important;min-height:42px!important}
#dexDetail .v12-nav button,#dexDetail .v12-nav button:disabled{background:transparent!important;border:0!important;box-shadow:none!important;padding:2px 6px!important;min-height:38px!important;min-width:66px!important;color:#39463f!important;opacity:1!important}
#dexDetail .v12-nav button:first-child{justify-self:start!important;justify-content:flex-start!important}
#dexDetail .v12-nav button:last-child{justify-self:end!important;justify-content:flex-end!important}
#dexDetail .v29-nav-name{display:none!important}
#dexDetail .v29-arrow{font-size:22px!important;font-weight:800!important}
#dexDetail .v29-nav-img{width:34px!important;height:34px!important;flex-basis:34px!important;font-size:22px!important;border:0!important;background:transparent!important}
#dexDetail .v29-empty{font-size:20px!important;color:#9aa39e!important}

/* Active-tab surface: type identity stays above; content below follows tab semantics. */
#v12Ability,#v12Sleep,#v12Field{border-radius:0 0 18px 18px!important;padding:10px 8px 16px!important}
#v12Ability{background:#f1f7ff!important}
#v12Sleep{background:#f6f1fb!important}
#v12Field{background:#f0f6f1!important}
#v12Ability>.ability-card,#v12Ability>#evolutionCard{background:transparent!important;border:0!important;box-shadow:none!important;border-radius:0!important;margin:0!important;padding:14px 6px!important}
#v12Ability>.ability-card+#v12Ability>.ability-card{}
#v12Ability>.ability-card:not(:first-child),#v12Ability>#evolutionCard{border-top:0!important}

/* 2: one table surface; stronger plain headers, no pill backgrounds. */
#v12Ability .ability-card:has(#detailFoods){background:transparent!important;padding:8px 4px 14px!important}
#detailFoods .v26-food-head{background:transparent!important;border:0!important;border-radius:0!important;min-height:58px!important;margin-bottom:2px!important}
#detailFoods .v26-food-rate{font-size:18px!important;font-weight:900!important}
#detailFoods .v26-food-rate strong{font-size:21px!important}
#detailFoods .v26-level-pill,#detailFoods .v26-recipe-head{background:transparent!important;border:0!important;box-shadow:none!important;border-radius:0!important;padding:0!important;font-size:16px!important;color:#111!important}
#detailFoods .v24-food-row{background:transparent!important;border:0!important;border-bottom:1px solid rgba(55,83,112,.08)!important;border-radius:0!important}
#detailFoods .v24-food-name{padding-left:14px!important}
#detailFoods .v24-letter{margin-left:5px!important}

/* 3: Dex is read-only. Skill + rate are prominent; details expands all levels. */
#v12Ability .ability-card:has(#detailSkill){background:transparent!important;padding:14px 6px!important}
#v12Ability .skill-box{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;column-gap:14px!important;row-gap:7px!important}
#v12Ability .skill-top{display:block!important;grid-column:1!important;grid-row:1!important}
#v12Ability .v26-skill-left{display:flex!important;align-items:baseline!important;gap:9px!important;flex-wrap:wrap!important}
#v12Ability .skill-name{font-size:18px!important;font-weight:950!important}
#v12Ability .skill-rate-inline{font-size:16px!important;font-weight:900!important;color:#23835a!important}
#v12Ability .skill-rate-inline strong{font-size:20px!important;color:inherit!important}
#v12Ability #v12SkillLv{display:none!important}
#v12Ability .skill-desc{grid-column:1!important;grid-row:2!important;margin:0!important;padding:2px 0 0!important;border:0!important;font-size:14px!important;line-height:1.45!important}
#v12Ability .skill-detail-toggle{grid-column:2!important;grid-row:1 / span 2!important;align-self:center!important;width:auto!important;border:0!important;background:transparent!important;padding:8px 2px!important;font-size:13px!important;font-weight:900!important;color:#52645b!important;white-space:nowrap!important}
#v12Ability .skill-levels{grid-column:1 / -1!important;grid-row:3!important}

/* 4: full known evolution family. Current Pokémon is larger. Type icon overlays image bottom-right. */
#v12Ability #evolutionCard{background:transparent!important;padding:14px 6px!important}
#detailEvolution{display:block!important}
.v31-evo-line{display:flex!important;align-items:center!important;justify-content:center!important;gap:8px!important;overflow-x:auto!important;padding:8px 2px 4px!important}
.v31-evo-node{border:0!important;background:transparent!important;padding:2px!important;display:flex!important;flex-direction:column!important;align-items:center!important;gap:3px!important;min-width:68px!important;color:#26312b!important}
.v31-evo-image{position:relative!important;width:58px!important;height:58px!important;display:flex!important;align-items:center!important;justify-content:center!important}
.v31-evo-node.is-current .v31-evo-image{width:72px!important;height:72px!important}
.v31-evo-image img{width:100%!important;height:100%!important;object-fit:contain!important}
.v31-evo-image img.psg-asset-preview{width:68%!important;height:68%!important}
.v31-evo-image>.fallback{font-size:30px!important;color:var(--type-accent)!important}
.v31-evo-type{position:absolute!important;right:-2px!important;bottom:-2px!important;width:23px!important;height:23px!important;border-radius:50%!important;display:grid!important;place-items:center!important;background:#fff!important;box-shadow:0 1px 5px rgba(0,0,0,.14)!important;font-size:13px!important}
.v31-evo-name{font-size:11px!important;font-weight:900!important;white-space:nowrap!important}
.v31-evo-step{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;min-width:68px!important;gap:3px!important}
.v31-evo-cond{display:flex!important;flex-direction:column!important;align-items:center!important;gap:1px!important;font-size:10px!important;line-height:1.2!important;text-align:center!important}
.v31-big-arrow{font-size:22px!important;font-weight:900!important;color:#6b7972!important}
.v31-branch-layout{display:grid!important;grid-template-columns:78px 26px minmax(0,1fr)!important;align-items:center!important;gap:6px!important;padding:6px 0!important}
.v31-branch-root{align-self:center!important}
.v31-branch-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:10px 4px!important;align-items:start!important}
.v31-branch-grid.is-two{grid-template-columns:repeat(2,minmax(0,1fr))!important}
.v31-branch-cell{display:flex!important;flex-direction:column!important;align-items:center!important;gap:2px!important;min-width:0!important}
.v31-branch-cell .v31-evo-node{min-width:0!important;width:100%!important}
.v31-branch-cell .v31-evo-image{width:48px!important;height:48px!important}
.v31-branch-cell .v31-evo-node.is-current .v31-evo-image{width:60px!important;height:60px!important}

@media(max-width:620px){
 #detailFoods .v26-level-pill,#detailFoods .v26-recipe-head{font-size:15px!important}
 #detailFoods .v26-food-rate{font-size:16px!important} #detailFoods .v26-food-rate strong{font-size:19px!important}
 #v12Ability .skill-name{font-size:16px!important} #v12Ability .skill-rate-inline{font-size:14px!important} #v12Ability .skill-rate-inline strong{font-size:18px!important}
 .v31-evo-line{gap:4px!important;justify-content:flex-start!important}
 .v31-evo-node{min-width:62px!important}.v31-evo-image{width:52px!important;height:52px!important}.v31-evo-node.is-current .v31-evo-image{width:66px!important;height:66px!important}
 .v31-evo-step{min-width:58px!important}.v31-evo-cond{font-size:9px!important}
 .v31-branch-layout{grid-template-columns:70px 20px minmax(0,1fr)!important;gap:3px!important}
 .v31-branch-grid{gap:8px 2px!important}.v31-branch-cell .v31-evo-image{width:42px!important;height:42px!important}.v31-branch-cell .v31-evo-node.is-current .v31-evo-image{width:54px!important;height:54px!important}
}

/* source: stable-v32-page-refine */
/* v32 — approved finishing reservations for blocks 1–3. */
/* 1-2: subtle alignment only; keep the accepted type surface. */
#dexDetail .v19-identity{align-items:center!important}
#dexDetail .v19-identity .v19-no{position:relative!important;top:-2px!important;color:#172019!important}
#dexDetail .v19-identity strong{position:relative!important;left:-4px!important}
/* 1-4/1-5: neutral black labels; values remain dominant by size. */
#dexDetail .hero-info>.stats .stat small{color:#111!important;font-weight:950!important}

/* 2: move the useful columns left and give recipes more room. */
#v12Ability .ability-card:has(#detailFoods){padding-left:0!important;padding-right:2px!important}
#detailFoods .v26-food-head,#detailFoods .v24-food-row{grid-template-columns:minmax(142px,1.25fr) 62px 62px 62px minmax(210px,1.9fr)!important}
#detailFoods .v26-food-head{min-height:60px!important}
#detailFoods .v26-food-rate{font-size:19px!important;text-align:left!important;padding-left:6px!important}
#detailFoods .v26-food-rate strong{font-size:22px!important}
#detailFoods .v26-level-pill,#detailFoods .v26-recipe-head{font-size:17px!important;font-weight:950!important;background:transparent!important}
#detailFoods .v24-food-name{padding-left:8px!important}
#detailFoods .v24-letter{margin-left:8px!important}
#detailFoods .v24-recipes{gap:7px!important;justify-content:center!important}
#detailFoods .v24-placeholder{flex:0 0 auto!important}

/* 3: semantic variable colors + compact 2-column x 3-row level detail. */
:root{--skill-effect-food:#d82f67;--skill-effect-energy:#d56b16;--skill-effect-berry:#c64a43;--skill-effect-energy-recovery:#4f9a58;--skill-effect-help:#287fc0;--skill-effect-skill:#7557b4;--skill-effect-zone:#405aa8}
#v12Ability .skill-var{font-weight:1000!important}
#v12Ability .effect-food{color:var(--skill-effect-food)!important}
#v12Ability .effect-energy{color:var(--skill-effect-energy)!important}
#v12Ability .effect-berry{color:var(--skill-effect-berry)!important}
#v12Ability .effect-energy-recovery{color:var(--skill-effect-energy-recovery)!important}
#v12Ability .effect-help{color:var(--skill-effect-help)!important}
#v12Ability .effect-skill{color:var(--skill-effect-skill)!important}
#v12Ability .effect-zone{color:var(--skill-effect-zone)!important}
#v12Ability .skill-levels.open{padding:9px 0 0!important;border-top:0!important;margin-top:8px!important}
#v12Ability .v32-skill-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:0 18px!important;max-width:430px!important;margin:0 auto!important}
#v12Ability .v32-skill-cell{display:grid!important;grid-template-columns:52px 1fr!important;align-items:center!important;gap:8px!important;min-height:42px!important;padding:6px 8px!important;border-bottom:1px solid rgba(55,83,112,.09)!important;font-size:14px!important}
#v12Ability .v32-skill-cell>b{color:#33443c!important;font-weight:950!important}
#v12Ability .v32-skill-cell>.skill-var{font-size:17px!important}
@media(max-width:620px){
 #detailFoods .v26-food-head,#detailFoods .v24-food-row{min-width:590px!important;grid-template-columns:140px 60px 60px 60px 270px!important}
 #detailFoods .v26-food-rate{font-size:17px!important} #detailFoods .v26-food-rate strong{font-size:20px!important}
 #detailFoods .v26-level-pill,#detailFoods .v26-recipe-head{font-size:16px!important}
 #v12Ability .v32-skill-grid{gap:0 10px!important}
 #v12Ability .v32-skill-cell{padding:5px 4px!important;font-size:13px!important}
 #v12Ability .v32-skill-cell>.skill-var{font-size:16px!important}
}

/* source: stable-v33-blocks-finish-responsive */
/* v33 — approved finishing pass. Mobile-first, viewport-responsive presentation. */
/* 1-2: Pokémon name is the visual focus; number stays secondary and type stays to the right. */
#dexDetail .v19-identity{display:grid!important;grid-template-columns:auto auto auto minmax(0,1fr)!important;align-items:center!important;column-gap:0!important}
#dexDetail .v19-identity .v19-no{font-size:12px!important;font-weight:900!important;top:-4px!important;color:#172019!important;white-space:nowrap!important}
#dexDetail .v19-identity strong{font-size:25px!important;font-weight:1000!important;left:0!important;min-width:0!important;white-space:nowrap!important;margin-left:1em!important}
#dexDetail .v19-identity .v19-type{justify-self:start!important;white-space:nowrap!important;margin-left:.35em!important}

/* 2: recipe data stays intact; only the visible preview count changes with viewport width. */
#detailFoods .v24-recipes{display:flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;min-width:0!important}
#detailFoods .v24-placeholder{display:inline-grid!important;place-items:center!important}
/* Wide: 5 previews. Medium: 4. Narrow: 3. */
@media(max-width:760px){#detailFoods .v24-recipes .v24-placeholder:nth-of-type(5){display:none!important}}
@media(max-width:520px){#detailFoods .v24-recipes .v24-placeholder:nth-of-type(4),#detailFoods .v24-recipes .v24-placeholder:nth-of-type(5){display:none!important}}

/* 3: probability styling matches ingredient probability. Normal effect/detail copy is black. */
#v12Ability .skill-rate-inline{color:#26312b!important}
#v12Ability .skill-rate-inline strong{color:#e83269!important}
#v12Ability .v33-skill-effect-row{grid-template-columns:minmax(0,1fr) auto!important;grid-column:1 / -1!important;grid-row:2!important;align-items:center!important;gap:10px!important;padding-top:0!important;border-top:0!important}
#v12Ability .v33-skill-effect-row .skill-desc{grid-column:auto!important;grid-row:auto!important;margin:0!important;padding:0!important;border:0!important;color:#111!important;font-size:14px!important;line-height:1.5!important}
#v12Ability .v33-skill-effect-row .skill-detail-toggle{grid-column:auto!important;grid-row:auto!important;align-self:center!important;width:auto!important;border:0!important;background:transparent!important;padding:7px 2px!important;font-size:13px!important;font-weight:900!important;white-space:nowrap!important}
#v12Ability .v32-skill-cell{color:#111!important}
#v12Ability .v32-skill-cell>b{color:#111!important}

/* 4: keep Level/Candy stacked; improve readability and scale of the evolution family. */
#v12Ability #evolutionCard .section-title{font-size:18px!important}
.v31-evo-line{gap:10px!important;padding:12px 4px 8px!important}
.v31-evo-node{min-width:82px!important;gap:5px!important}
.v31-evo-image{width:72px!important;height:72px!important}
.v31-evo-node.is-current .v31-evo-image{width:88px!important;height:88px!important}
.v31-evo-name{font-size:13px!important;font-weight:950!important;color:#111!important}
.v31-evo-step{min-width:76px!important;gap:5px!important}
.v31-evo-cond{font-size:12px!important;font-weight:850!important;line-height:1.3!important;color:#111!important}
.v31-evo-cond span{color:#111!important}
.v31-evo-cond span:first-child{font-weight:950!important}
.v31-big-arrow{color:#39453f!important;font-weight:950!important}
.v31-branch-cell .v31-evo-image{width:62px!important;height:62px!important}
.v31-branch-cell .v31-evo-node.is-current .v31-evo-image{width:76px!important;height:76px!important}
.v31-branch-cell .v31-evo-cond{font-size:11px!important;color:#111!important}

/* Responsive finishing: preserve information, adjust density rather than shrinking everything. */
@media(max-width:620px){
 #dexDetail .v19-identity{column-gap:0!important}
 #dexDetail .v19-identity .v19-no{font-size:11px!important;top:-3px!important}
 #dexDetail .v19-identity strong{font-size:21px!important;left:0!important;margin-left:1em!important}
 #v12Ability .v33-skill-effect-row{gap:6px!important}
 #v12Ability .v33-skill-effect-row .skill-desc{font-size:13px!important}
 #v12Ability .v33-skill-effect-row .skill-detail-toggle{font-size:12px!important}
 .v31-evo-line{gap:5px!important;justify-content:flex-start!important}
 .v31-evo-node{min-width:70px!important}
 .v31-evo-image{width:62px!important;height:62px!important}
 .v31-evo-node.is-current .v31-evo-image{width:76px!important;height:76px!important}
 .v31-evo-name{font-size:12px!important}
 .v31-evo-step{min-width:64px!important}
 .v31-evo-cond{font-size:11px!important}
}
@media(max-width:390px){
 #dexDetail .v19-identity strong{font-size:19px!important}
 #dexDetail .v19-identity .v19-type{font-size:12px!important}
 .v31-evo-image{width:58px!important;height:58px!important}
 .v31-evo-node.is-current .v31-evo-image{width:70px!important;height:70px!important}
 .v31-evo-step{min-width:58px!important}
}

/* source: dex-detail-final-skill-style */
/* v38 structure cleanup — frozen visual design from v37.
   Block 2 row separators + Block 3 skill presentation are centralized here. */

/* Block 2: A/B/C rows are separated by spacing/background, not rules. */
#detailFoods .v24-food-row{border-bottom:0!important;}
/* v39: requested text-color refinements only. */
#detailFoods .v26-level-pill,
#detailFoods .v26-recipe-head{color:#111!important;}

/* Block 3 heading: same visual scale as Block 2 heading. */
#v12Ability .skill-name{font-size:19px!important;font-weight:950!important;}

/* Block 3 surface: no internal separator rules or legacy pseudo-rules. */
#v12Ability .skill-box,
#v12Ability .skill-top,
#v12Ability .v33-skill-effect-row,
#v12Ability .v33-skill-effect-row .skill-desc,
#v12Ability .skill-levels,
#v12Ability .skill-levels.open,
#v12Ability .v32-skill-grid,
#v12Ability .v32-skill-cell{
  border:0!important;border-top:0!important;border-bottom:0!important;
  outline:0!important;box-shadow:none!important;background-image:none!important;
}
#v12Ability .skill-top::before,
#v12Ability .skill-top::after,
#v12Ability .v33-skill-effect-row::before,
#v12Ability .v33-skill-effect-row::after,
#v12Ability .v33-skill-effect-row .skill-desc::before,
#v12Ability .v33-skill-effect-row .skill-desc::after,
#v12Ability .v32-skill-cell::before,
#v12Ability .v32-skill-cell::after{
  content:none!important;display:none!important;border:0!important;box-shadow:none!important;
}

/* 3-2: Lv.1 begins under the skill-name text, excluding the icon column. */
#v12Ability .v33-skill-effect-row{
  display:grid!important;
  grid-template-columns:auto minmax(0,auto) auto!important;
  justify-content:start!important;align-items:start!important;
  column-gap:10px!important;row-gap:3px!important;
  padding-left:27px!important;margin-top:7px!important;
}
#v12Ability .v33-skill-effect-row .skill-desc{
  display:grid!important;grid-template-columns:auto minmax(0,1fr)!important;
  align-items:baseline!important;column-gap:10px!important;
  min-width:0!important;max-width:100%!important;
  font-size:15px!important;line-height:1.55!important;
}
#v12Ability .v35-effect-level{white-space:nowrap!important;font-size:15px!important;}
#v12Ability .v35-effect-copy{min-width:0!important;color:#111!important;font-size:15px!important;}
#v12Ability .v33-skill-effect-row .skill-detail-toggle{
  justify-self:start!important;align-self:start!important;
  padding:1px 2px!important;margin:0!important;font-size:14px!important;
  color:#111!important;
}

/* Responsive behavior from frozen v37 design. */
@media(max-width:620px){
  #v12Ability .skill-name{font-size:17px!important;}
  #v12Ability .v33-skill-effect-row{
    grid-template-columns:minmax(0,1fr) auto!important;
    padding-left:25px!important;column-gap:6px!important;
  }
  #v12Ability .v33-skill-effect-row .skill-desc{min-width:0!important;font-size:14px!important;}
  #v12Ability .v35-effect-level,#v12Ability .v35-effect-copy{font-size:14px!important;}
  #v12Ability .v33-skill-effect-row .skill-detail-toggle{font-size:13px!important;}
}
@media(max-width:430px){
  #v12Ability .v33-skill-effect-row{grid-template-columns:minmax(0,1fr)!important;}
  #v12Ability .v33-skill-effect-row .skill-detail-toggle{margin-left:calc(2.4em + 10px)!important;}
}

/* source: psg-v42-mobile-finish */
/* PSG v42 — smartphone finishing pass + consolidation of v40/v41 mobile overrides.
   Desktop rules and the completed Block 3 alignment model remain unchanged. */

/* Natural No./name/type flow on all widths; remove old fixed-character offsets. */
#dexDetail .v19-identity{
  display:flex!important;align-items:baseline!important;justify-content:flex-start!important;
  flex-wrap:wrap!important;gap:4px 7px!important;
}
#dexDetail .v19-identity .v19-no{position:static!important;top:auto!important;margin:0!important;}
#dexDetail .v19-identity strong{position:static!important;left:auto!important;margin:0!important;}
#dexDetail .v19-identity .v19-type{margin:0 0 0 2px!important;}

/* 3-2 toggle must be true black, not inherited translucent gray. */
#v12Ability .v33-skill-effect-row .skill-detail-toggle{color:#000!important;opacity:1!important;}

@media(max-width:620px){
  /* Block 1 — full-width 1-4/1-5. Keep artwork size, lower its visual center slightly. */
  #dexDetail .hero{padding:8px!important;}
  #dexDetail .hero-top{
    grid-template-columns:minmax(88px,29%) minmax(0,1fr)!important;
    grid-template-rows:auto auto auto!important;
    gap:7px 8px!important;
  }
  #dexDetail .hero-art{height:138px!important;min-height:138px!important;transform:translateY(8px)!important;
  }
  #dexDetail .hero-info{display:contents!important;}
  #dexDetail #v12Header{grid-column:2!important;grid-row:1!important;align-self:start!important;}
  #dexDetail .hero-info>.stats{
    grid-column:1 / -1!important;grid-row:2!important;margin:8px 0 0!important;
    grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:5px!important;
  }
  #dexDetail .hero-info>.stats .stat{min-height:58px!important;padding:6px 4px!important;}
  #dexDetail .hero-info>.stats .stat small{font-size:9.5px!important;letter-spacing:-.02em!important;}
  #dexDetail .hero-info>.stats .stat b{font-size:18px!important;}
  #dexDetail .v12-tabs{grid-column:1 / -1!important;grid-row:3!important;}
  #dexDetail .v12-tabs button{min-height:44px!important;font-size:13px!important;}

  /* Block 2 — compact two-row rate header; column labels centered to its total height. */
  #v12Ability .ability-card:has(#detailFoods){padding:5px 2px 10px!important;}
  #detailFoods{margin:0!important;width:100%!important;overflow:visible!important;}
  #detailFoods .v26-food-head,#detailFoods .v24-food-row{
    min-width:0!important;width:100%!important;
    grid-template-columns:minmax(100px,1.08fr) 39px 39px 39px minmax(108px,1.35fr)!important;
    column-gap:1px!important;
  }
  #detailFoods .v26-food-head{min-height:48px!important;margin-bottom:0!important;}
  #detailFoods .v26-food-rate{
    gap:0!important;padding:0 0 0 4px!important;font-size:13px!important;line-height:1.15!important;white-space:normal!important;
  }
  #detailFoods .v26-food-rate strong{display:block!important;line-height:1.1!important;margin-top:2px!important;}
  #detailFoods .v26-level-pill,#detailFoods .v26-recipe-head{
    align-self:center!important;font-size:12px!important;line-height:1.1!important;white-space:nowrap!important;
  }
  #detailFoods .v24-food-row{min-height:70px!important;}
  #detailFoods .v24-food-name{padding-left:3px!important;gap:2px!important;min-width:0!important;}
  #detailFoods .v24-letter{margin-left:0!important;flex:0 0 auto!important;}
  #detailFoods .v24-food-main{}
  #detailFoods .v24-food-main b{font-size:10.5px!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;}
  #detailFoods .v24-food-icon{font-size:18px!important;}
  #detailFoods .v24-level{font-size:12px!important;}
  #detailFoods .v24-recipes{gap:3px!important;justify-content:flex-start!important;overflow:hidden!important;}
  #detailFoods .v24-placeholder{font-size:18px!important;min-width:20px!important;}
  #detailFoods .v24-more{flex:0 0 auto!important;}

  /* Block 3 — same usable width as Block 2; preserve the accepted text alignment. */
  #v12Ability .ability-card:has(#detailSkill){padding:10px 2px!important;}
  #v12Ability .skill-box{row-gap:4px!important;}
  #v12Ability .skill-name{font-size:18px!important;}
  #v12Ability .skill-rate-inline{font-size:14px!important;}
  #v12Ability .skill-rate-inline strong{font-size:18px!important;}
  #v12Ability .v33-skill-effect-row{row-gap:1px!important;}
  #v12Ability .v33-skill-effect-row .skill-desc,
  #v12Ability .v35-effect-level,#v12Ability .v35-effect-copy{font-size:15px!important;}
  #v12Ability .v33-skill-effect-row .skill-detail-toggle{font-size:14px!important;padding-top:2px!important;padding-bottom:2px!important;}

  /* Simple level tables: keep 2x3 structure but remove the oversized vertical air. */
  #v12Ability .skill-levels.open{padding-top:4px!important;margin-top:3px!important;}
  #v12Ability .v32-skill-grid{gap:0 10px!important;}
  #v12Ability .v32-skill-cell{
    grid-template-columns:44px 1fr!important;min-height:30px!important;
    padding:2px 4px!important;font-size:13px!important;line-height:1.25!important;
  }
  #v12Ability .v32-skill-cell>.skill-var{font-size:16px!important;}
}
@media(max-width:390px){
  /* Keep three recipe previews on narrow phones; underlying recipe data remains intact. */
  #detailFoods .v24-recipes .v24-placeholder:nth-of-type(3){display:inline-grid!important;}
  #detailFoods .v24-recipes .v24-placeholder:nth-of-type(n+4){display:none!important;}
}

/* source: psg-v43-mobile-blocks23 */
/* PSG v43 — smartphone Block 2/3 finishing.
   Desktop presentation and Block 4 are intentionally untouched. */
@media(max-width:620px){
  /* Block 2: A/B/C + ingredient icon on phone. When an icon is not
     registered, show the known ingredient name instead of an empty circle. */
  #detailFoods .v26-food-head,
  #detailFoods .v24-food-row{
    grid-template-columns:minmax(58px,.72fr) 42px 42px 42px minmax(116px,1.48fr)!important;
    column-gap:2px!important;
  }
  #detailFoods .v24-food-main:not(.name-fallback) b{display:none!important;}
  #detailFoods .v24-food-main.name-fallback .v24-food-icon{display:none!important;}
  #detailFoods .v24-food-main.name-fallback b{
    display:block!important;
    margin:0!important;
    font-size:11px!important;
    line-height:1.2!important;
    text-align:center!important;
    white-space:normal!important;
    overflow-wrap:anywhere!important;
  }
  #detailFoods .v24-food-name{
    padding-left:4px!important;gap:5px!important;justify-content:flex-start!important;
  }
  #detailFoods .v24-food-main{display:flex!important;justify-content:flex-start!important;}
  #detailFoods .v24-food-icon{font-size:20px!important;}

  /* 2-1: three visual groups — rate / unlock level / recipes. */
  #detailFoods .v26-food-head{
    min-height:50px!important;
    align-items:center!important;
  }
  #detailFoods .v26-food-rate{
    grid-column:1!important;
    display:flex!important;flex-direction:column!important;align-items:flex-start!important;justify-content:center!important;
    padding-left:3px!important;
  }
  #detailFoods .v43-food-title{
    display:flex!important;align-items:center!important;gap:3px!important;
    font-size:13px!important;font-weight:950!important;white-space:nowrap!important;
  }
  #detailFoods .v43-food-icon{display:inline-block!important;width:18px!important;text-align:center!important;}
  #detailFoods .v26-food-rate strong{
    margin:2px 0 0 21px!important; /* starts under 食, not under 🥕 */
    font-size:16px!important;line-height:1.05!important;
  }
  #detailFoods .v43-unlock-head{
    grid-column:2 / 5!important;
    align-self:stretch!important;
    display:grid!important;grid-template-rows:1fr 1fr!important;
    align-items:center!important;justify-items:stretch!important;
    font-size:12px!important;font-weight:950!important;line-height:1!important;
  }
  #detailFoods .v43-unlock-head>span:first-child{
    align-self:end!important;justify-self:center!important;padding-bottom:3px!important;white-space:nowrap!important;
  }
  #detailFoods .v43-unlock-levels{
    align-self:start!important;display:grid!important;grid-template-columns:repeat(3,42px)!important;
    justify-content:center!important;text-align:center!important;padding-top:3px!important;
  }
  #detailFoods .v43-unlock-levels b{font-size:12px!important;font-weight:950!important;}
  #detailFoods .v26-recipe-head{
    grid-column:5!important;align-self:center!important;justify-self:center!important;
    width:100%!important;text-align:center!important;font-size:12px!important;line-height:1.1!important;
  }

  /* Block 3: make 3-1 + 3-2 read as one compact skill unit. */
  #v12Ability .ability-card:has(#detailSkill){padding-bottom:7px!important;}
  #v12Ability .skill-box{}
  #v12Ability .v33-skill-effect-row{
    margin-top:0!important;padding-top:1px!important;row-gap:0!important;
  }
  #v12Ability .v33-skill-effect-row .skill-desc{
    margin-top:0!important;margin-bottom:0!important;
  }
  #v12Ability .v33-skill-effect-row .skill-detail-toggle{
    margin-top:0!important;padding-top:1px!important;padding-bottom:1px!important;line-height:1.25!important;
  }
  #v12Ability .skill-levels.open{padding-top:2px!important;}

  /* Short/simple Lv.2–Lv.7: Lv.2–4 left, Lv.5–7 right. */
  #v12Ability .v32-skill-grid.v43-compact-3{
    display:grid!important;
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    grid-template-rows:repeat(3,auto)!important;
    grid-auto-flow:column!important;
  }
  #v12Ability .v32-skill-grid.v43-compact-3 .v32-skill-cell{
    grid-template-columns:auto 1fr!important;
    min-height:25px!important;
    column-gap:4px!important;font-size:12px!important;line-height:1.15!important;
  }
  #v12Ability .v32-skill-grid.v43-compact-3 .v32-skill-cell>.skill-var{font-size:14px!important;}

  /* Medium detail falls back to 2 columns; long/complex content remains content-driven. */
  #v12Ability .v32-skill-grid.v43-compact-2{
    display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:2px 8px!important;
  }
  #v12Ability .v32-skill-grid.v43-detail-long{
    display:grid!important;grid-template-columns:1fr!important;gap:3px!important;
  }
}

/* source: psg-v44-mobile-ability-finish */
@media(max-width:620px){
  /* 1-3: image + quantity / sleep type / specialty, all one line.
     berryImage can be supplied by master data later; emoji is only the current fallback. */
  #dexDetail .v19-traits{
    gap:5px!important;
  }
  #dexDetail .v19-traits span{
    min-height:38px!important;
    padding:5px 4px!important;
    gap:4px!important;
    font-size:12px!important;
  }
  #dexDetail .v19-traits .v44-berry-trait b{font-size:13px!important;font-weight:950!important;}
  #dexDetail .v44-berry-visual{
    width:24px!important;height:24px!important;flex:0 0 24px!important;
    padding:0!important;overflow:visible!important;font-size:20px!important;
  }
  #dexDetail .v44-berry-visual img{
    display:block!important;width:24px!important;height:24px!important;object-fit:contain!important;
  }

  /* 3 block root fix:
     stop using the legacy grid for the skill box on phone.
     Normal document flow now determines the 3-1 -> 3-2 distance. */
  #v12Ability .skill-box{
    width:100%!important;
  }
  #v12Ability .skill-top{
    display:block!important;
    width:100%!important;
  }
  #v12Ability .v33-skill-effect-row{
    width:100%!important;
  }
  #v12Ability .v33-skill-effect-row .skill-desc{
    display:grid!important;
    grid-template-columns:auto minmax(0,1fr)!important;
    align-items:baseline!important;
    column-gap:9px!important;
    width:100%!important;
    line-height:1.42!important;
  }
  #v12Ability .v33-skill-effect-row .skill-detail-toggle{
    display:block!important;
    width:auto!important;
    min-width:118px!important;
    margin:1px 0 0 auto!important;
    padding:5px 2px 4px 18px!important;
    text-align:right!important;
    line-height:1.2!important;
    color:#000!important;
    opacity:1!important;
    background:transparent!important;
    border:0!important;
    touch-action:manipulation!important;
  }
  #v12Ability .skill-levels,
  #v12Ability .skill-levels.open{
    margin:1px 0 0!important;
    padding:2px 0 0!important;
  }
  #v12Ability .skill-levels{}
  #v12Ability .skill-levels.open{}

  /* Keep v43's content-aware detail layouts, but tighten the simple case. */
  #v12Ability .v32-skill-grid.v43-compact-3{
    max-width:none!important;
    gap:1px 5px!important;
  }
  #v12Ability .v32-skill-grid.v43-compact-3 .v32-skill-cell{
    min-height:24px!important;
    padding:1px 3px!important;
  }
}

/* source: psg-v49-mobile-polish */
/* PSG v49 — cleanup polish only.
   Consolidates the v45–v47 smartphone overrides into one valid cascade layer.
   No reserved new feature (such as max carry) is added here. */
@media(max-width:620px){
  /* 1-4: visual centering by the whole stat, not by label text excluding the icon. */
  #dexDetail .hero-info>.stats .stat{
  }
  #dexDetail .hero-info>.stats .stat small{
  }
  #dexDetail .hero-info>.stats .v45-stat-icon,
  #dexDetail .hero-info>.stats .v45-stat-text{
    display:inline!important;
    width:auto!important;
    min-width:0!important;
    text-align:inherit!important;
  }
  #dexDetail .hero-info>.stats .stat>b{
  }

  /* Probability values are neutral information, not semantic effect colors. */
  #dexDetail .hero-info>.stats .stat:nth-child(2)>b,
  #dexDetail .hero-info>.stats .stat:nth-child(3)>b,
  #detailFoods .v26-food-rate>strong,
  #v12Ability .skill-rate-inline,
  #v12Ability .skill-rate-inline strong{color:#111!important;}

  /* Block 3: four explicit visual rows: title/rate, Lv.1, toggle, detail. */
  #v12Ability .ability-card:has(#detailSkill){
    padding-top:6px!important;
    padding-bottom:5px!important;
  }
  #v12Ability .skill-box{display:block!important;margin:0!important;padding:0!important;}
  #v12Ability .skill-top{margin:0!important;padding:0!important;}
  #v12Ability .v33-skill-effect-row{
    display:block!important;
    margin:3px 0 0!important;
    padding:0 0 0 25px!important;
  }
  #v12Ability .v33-skill-effect-row .skill-desc{
    padding:0!important;
  }
  #v12Ability .v47-skill-toggle-row{
    display:flex!important;
    justify-content:flex-end!important;
    align-items:center!important;
    width:100%!important;
    min-height:25px!important;
    margin:1px 0 0!important;
    padding:0 8px 0 25px!important;
  }
  #v12Ability .v47-skill-toggle-row .skill-detail-toggle{
    display:block!important;
    width:auto!important;
    min-width:126px!important;
    margin:0!important;
    padding:4px 0 4px 18px!important;
    border:0!important;
    background:transparent!important;
    color:#000!important;
    opacity:1!important;
    text-align:right!important;
    font-size:14px!important;
    line-height:1.2!important;
    touch-action:manipulation!important;
  }
  #v12Ability .skill-levels,
  #v12Ability .skill-levels.open{width:100%!important;margin:0!important;padding:0!important;}
  #v12Ability .skill-levels{display:none!important;}
  #v12Ability .skill-levels.open{display:block!important;}
  #v12Ability .v32-skill-grid.v43-compact-3{margin:0!important;row-gap:1px!important;}

  /* Tighten only the transition into Block 4; Block 4 internals stay untouched. */
  #v12Ability .ability-card:has(#detailSkill){margin-bottom:5px!important;}
  #evolutionCard{margin-top:5px!important;}
}

/* source: psg-v50-reserved-layout */
@media(max-width:600px){
#dexDetail .stats{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:3px!important}
#dexDetail .stat{min-width:0!important;padding:5px 1px!important;text-align:center!important}
#dexDetail .stat small{display:flex!important;justify-content:center!important;align-items:center!important;gap:1px!important;white-space:nowrap!important;font-size:7.4px!important;line-height:1.15!important}
#dexDetail .stat .v45-stat-icon{flex:0 0 auto!important;font-size:9px!important}
#dexDetail .stat .v45-stat-text{display:inline!important}
#dexDetail .stat b{display:block!important;text-align:center!important;font-size:12px!important;line-height:1.25!important;margin-top:3px!important;white-space:nowrap!important;color:#111!important}
.v50-unlock-empty{visibility:hidden!important}
#dexDetail .skill-box{margin-bottom:4px!important}
#dexDetail #evolutionCard{margin-top:5px!important}
#dexDetail .v31-evo-line{align-items:center!important}
#dexDetail .v31-evo-node{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:4px!important}
#dexDetail .v31-evo-node .v31-evo-name{order:0!important;margin:0!important;font-size:10px!important;line-height:1.15!important}
#dexDetail .v31-evo-node .v31-evo-image{order:1!important}
#dexDetail .v31-evo-node.is-current .v31-evo-image{transform:scale(1.16)!important;transform-origin:center!important}
#dexDetail .v31-evo-step{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:2px!important;align-self:center!important}
#dexDetail .v31-evo-step .v31-big-arrow{order:0!important;line-height:1!important}
#dexDetail .v31-evo-step .v31-evo-cond{order:1!important;margin:0!important;text-align:center!important;line-height:1.2!important}
}

/* source: psg-v51-block1-3223 */
/* v51 — Block 1 mobile 3-2-2-3 layout. v50 Blocks 2–4 are intentionally untouched. */
@media(max-width:620px){
  #dexDetail .detail-head{top:0!important;z-index:50!important;
    display:grid!important;grid-template-columns:auto minmax(0,1fr) auto!important;
    align-items:center!important;gap:6px!important;padding:6px 10px!important;
    min-height:44px!important;background:rgba(255,255,255,.96)!important;backdrop-filter:blur(10px);
  }
  #dexDetail .detail-head>[data-back]{grid-column:1!important;padding:6px 4px!important;white-space:nowrap!important;}
  #dexDetail .detail-head h2{
    grid-column:2!important;display:flex!important;align-items:baseline!important;justify-content:center!important;
    gap:5px!important;min-width:0!important;margin:0!important;white-space:nowrap!important;overflow:hidden!important;
    font-size:15px!important;line-height:1.15!important;
  }
  #dexDetail .v51-head-no{color:#68736d!important;flex:0 0 auto!important;}
  #dexDetail .v51-head-name{}
  #dexDetail .v51-head-nav{grid-column:3!important;display:flex!important;gap:3px!important;}
  #dexDetail .v51-head-nav button{
    width:28px!important;height:30px!important;padding:0!important;border:1px solid rgba(0,0,0,.15)!important;
    border-radius:9px!important;background:#fff!important;color:#26332c!important;font-size:20px!important;line-height:1!important;
  }
  #dexDetail .v51-head-nav button:disabled{opacity:.28!important;}

  #dexDetail .hero{padding:7px!important;}
  #dexDetail .hero-top{
    display:grid!important;grid-template-columns:minmax(108px,37%) minmax(0,1fr)!important;
    grid-template-rows:1fr!important;gap:6px!important;align-items:stretch!important;
  }
  #dexDetail .hero-art{
    position:relative!important;grid-column:1!important;grid-row:1!important;min-height:166px!important;transform:none!important;align-self:stretch!important;
  }
  #dexDetail .v51-type-badge{
    position:absolute!important;right:5px!important;bottom:5px!important;z-index:2!important;
    display:inline-flex!important;align-items:center!important;gap:2px!important;
    padding:4px 6px!important;border-radius:999px!important;background:rgba(255,255,255,.90)!important;
    border:1px solid var(--type-accent)!important;color:var(--type-accent)!important;
    font-size:10px!important;font-weight:950!important;line-height:1!important;white-space:nowrap!important;
  }
  #dexDetail .hero-info{display:flex!important;flex-direction:column!important;
    justify-content:space-between!important;gap:4px!important;min-width:0!important;
  }
  #dexDetail #v12Header{width:100%!important;min-width:0!important;margin:0!important;}
  #dexDetail .v19-identity{display:none!important;}
  #dexDetail .v19-traits{
    display:grid!important;grid-template-columns:31fr 38fr 31fr!important;gap:3px!important;width:100%!important;margin:0!important;
  }
  #dexDetail .v19-traits span{
    min-width:0!important;min-height:31px!important;padding:3px 2px!important;display:flex!important;align-items:center!important;
    justify-content:center!important;gap:2px!important;white-space:nowrap!important;overflow:hidden!important;font-size:9.5px!important;line-height:1!important;
  }
  #dexDetail .v44-berry-visual{width:19px!important;height:19px!important;flex:0 0 19px!important;font-size:16px!important;}
  #dexDetail .v44-berry-visual img{width:19px!important;height:19px!important;}
  #dexDetail .v19-traits .v44-berry-trait b{font-size:10.5px!important;}

  /* middle two rows = 1-4, 2 columns x 2 rows */
  #dexDetail .hero-info>.stats{
    display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:repeat(2,auto)!important;
    gap:3px!important;width:100%!important;margin:0!important;
  }
  #dexDetail .hero-info>.stats .stat{
    min-width:0!important;min-height:48px!important;padding:4px 2px!important;gap:2px!important;
  }
  #dexDetail .hero-info>.stats .stat small{gap:1px!important;
    margin:0!important;padding:0!important;font-size:7.8px!important;letter-spacing:-.04em!important;white-space:nowrap!important;line-height:1.05!important;
  }
  #dexDetail .hero-info>.stats .stat .v45-stat-icon{font-size:8.5px!important;flex:0 0 auto!important;}
  #dexDetail .hero-info>.stats .stat b{
    display:block!important;width:100%!important;margin:0!important;text-align:center!important;font-size:13px!important;line-height:1.1!important;
    white-space:nowrap!important;color:#111!important;
  }

  /* bottom row = former 1-5, 3 columns */
  #dexDetail .v12-tabs{gap:3px!important;margin:0!important;
  }
  #dexDetail .v12-tabs button{min-width:0!important;min-height:32px!important;padding:4px 2px!important;font-size:10px!important;border-radius:9px!important;}
}

/* source: psg-v52-block1-refine */
/* v52 — agreed mobile refinements: 1-1 black No., 1-2 square, 1-3 larger, 1-4/1-5 natural centering, 1-6 full width, quieter A/B/C, stronger skill name. */
@media(max-width:620px){
  /* 1-1 */
  #dexDetail .v51-head-no{font-size:10.5px!important;}

  /* 1-2: artwork area is a true square; it no longer stretches to the right column height. */
  #dexDetail .hero-top{align-items:start!important;}
  #dexDetail .hero-art{height:auto!important;
    align-self:start!important;
  }

  /* 1-3: keep three columns, but give the labels more presence. */
  #dexDetail .v19-traits span{font-size:11px!important;font-weight:850!important;}
  #dexDetail .v19-traits .v44-berry-trait b{font-size:11.5px!important;}

  /* 1-4 / 1-5: center icon+label as one unit, then center the value below it. */
  #dexDetail .hero-info>.stats .stat{}
  #dexDetail .hero-info>.stats .stat small{gap:2px!important;
  }
  #dexDetail .hero-info>.stats .stat>b{}

  /* 1-6: independent full-width row below image + 3/2/2 information area. */
  #dexDetail .hero{display:flex!important;flex-direction:column!important;}
  #dexDetail .hero-top{width:100%!important;}
  #dexDetail .v12-tabs{
    order:2!important;display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;
    gap:5px!important;width:100%!important;margin:6px 0 0!important;
  }
  #dexDetail .v12-tabs button{min-height:38px!important;padding:5px 3px!important;font-size:12px!important;border-radius:10px!important;}

  /* Block 2: A/B/C are guides, not the visual focus. */
  #detailFoods .v24-letter{font-size:11px!important;opacity:.68!important;}

  /* Block 3: skill name is the primary heading; activation probability stays secondary. */
  #v12Ability .skill-name{}
  #v12Ability .skill-rate-inline{font-weight:750!important;}
}


/* PSG v57 — approved visual refinement pass (based on verified v56 behavior). */
@media(max-width:620px){
  :root{--psg-header-height:calc(38px + env(safe-area-inset-top))}
  /* Unified app header + 1-1. Safe-area aware; left/right top labels preserve the center zone. */
  .psg-app-header{
    position:sticky!important;top:0!important;z-index:70!important;
    height:calc(38px + env(safe-area-inset-top))!important;
    min-height:calc(38px + env(safe-area-inset-top))!important;
    padding:env(safe-area-inset-top) 12px 0!important;
    display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;
    align-items:center!important;background:rgba(255,255,255,.97)!important;
    border-bottom:0!important;backdrop-filter:blur(12px)!important;
  }
  .psg-app-title{justify-self:start!important;font-size:14px!important;white-space:nowrap!important;}
  .psg-app-version{justify-self:end!important;margin:0!important;color:#7d8a85!important;font-size:10px!important;white-space:nowrap!important;}
  #dexDetail .detail-head{
    position:sticky!important;top:calc(38px + env(safe-area-inset-top))!important;z-index:69!important;
    margin:0 -10px 7px!important;padding:5px 10px 6px!important;min-height:42px!important;
    background:rgba(255,255,255,.97)!important;border-top:0!important;border-bottom:1px solid rgba(0,0,0,.08)!important;
    box-shadow:0 2px 7px rgba(0,0,0,.035)!important;backdrop-filter:blur(12px)!important;
  }

  /* 1-2: square stays fixed; the artwork display region is vertically centered within it. */
  #dexDetail .hero-art{
    display:flex!important;align-items:center!important;justify-content:center!important;
    aspect-ratio:1 / 1!important;overflow:hidden!important;
  }
  #dexDetail .hero-art>img{
    display:block!important;max-width:100%!important;max-height:100%!important;width:auto!important;height:auto!important;
    object-fit:contain!important;object-position:center center!important;margin:auto!important;
  }
  #dexDetail .hero-art .v31-evo-type,
  #dexDetail .hero-art .v51-type,
  #dexDetail .hero-art [class*="type-badge"]{align-self:auto!important;}

  /* 1-4 / 1-5: center the icon+label as one visual group and the value beneath it. */
  #dexDetail .hero-info>.stats .stat{
    display:flex!important;flex-direction:column!important;gap:3px!important;
  }
  #dexDetail .hero-info>.stats .stat small{gap:3px!important;
    width:auto!important;max-width:100%!important;margin:0 auto!important;
  }
  #dexDetail .hero-info>.stats .stat>b{display:block!important;margin:0!important;}

  /* Block 2: A/B/C are quiet guides. Within the ingredient-name area use label:ingredient = 3:7. */
  #detailFoods .v24-food-name{
    display:grid!important;grid-template-columns:3fr 7fr!important;align-items:stretch!important;gap:3px!important;padding:4px!important;
  }
  #detailFoods .v24-letter{
    width:100%!important;height:100%!important;min-width:0!important;min-height:42px!important;
    display:grid!important;place-items:center!important;border-radius:8px!important;
    font-size:10px!important;font-weight:750!important;opacity:.72!important;
  }
  #detailFoods .v24-food-main{width:100%!important;min-width:0!important;align-items:center!important;justify-content:center!important;}
  #detailFoods .v24-food-icon{font-size:25px!important;line-height:1!important;}
  #detailFoods .slot-A .v24-food-name{background:#f7fcf9!important;}
  #detailFoods .slot-B .v24-food-name{background:#fff8fa!important;}
  #detailFoods .slot-C .v24-food-name{background:#fffbf4!important;}
  #detailFoods .slot-A .v24-letter{background:#edf9f2!important;color:#16885a!important;}
  #detailFoods .slot-B .v24-letter{background:#fff0f5!important;color:#bd4b72!important;}
  #detailFoods .slot-C .v24-letter{background:#fff5e5!important;color:#8e6727!important;}

  /* Block 3: skill name leads; probability remains secondary/neutral. */
  #v12Ability .skill-name{font-size:22px!important;line-height:1.12!important;color:#111!important;}
  #v12Ability .skill-rate-inline,
  #v12Ability .skill-rate-inline strong{font-size:12px!important;font-weight:750!important;color:#111!important;}
}


/* PSG v58 — focused mobile refinement: attached header, stronger Pokémon name, A/B/C tint through quantities. */
@media(max-width:620px){
  /* Keep the app header at its normal safe-area position and attach 1-1 directly beneath it. */
  main:has(#dexDetail.active){padding-top:0!important;}
  #dexDetail{padding-top:0!important;}
  .psg-app-header{margin-bottom:0!important;}
  #dexDetail .detail-head{margin-top:0!important;}

  /* 1-1: Pokémon name is the visual focus; No. remains secondary. */
  #dexDetail .v51-head-name{
    font-size:19px!important;font-weight:950!important;line-height:1.08!important;
    overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;
  }
  #dexDetail .v51-head-no{font-size:10px!important;font-weight:750!important;}

  /* Block 2: carry each A/B/C tint through all ingredient quantity cells; recipe area stays separate. */
  #detailFoods .slot-A .v24-food-name,
  #detailFoods .slot-A .v24-level{}
  #detailFoods .slot-B .v24-food-name,
  #detailFoods .slot-B .v24-level{}
  #detailFoods .slot-C .v24-food-name,
  #detailFoods .slot-C .v24-level{}
}


/* PSG v59 — focused visual polish only.
   No navigation/routing changes. Skill-specific icon data is reserved for a later version. */
@media(max-width:620px){

  /* 1-1: No. is black; Pokémon name keeps the accepted v58 emphasis. */
  #dexDetail .v51-head-no{
    color:#111!important;
  }

  /* 1-4 / 1-5: remove decorative icons so labels themselves can be truly centered. */
  #dexDetail .hero-info>.stats .stat{
    text-align:center!important;
    align-items:center!important;
    justify-content:center!important;
  }
  #dexDetail .hero-info>.stats .stat small{
    display:flex!important;
    justify-content:center!important;
    align-items:center!important;
    width:100%!important;
    text-align:center!important;
  }
  #dexDetail .hero-info>.stats .stat .v45-stat-icon{
    display:none!important;
  }
  #dexDetail .hero-info>.stats .stat .v45-stat-text{
    display:block!important;
    width:100%!important;
    text-align:center!important;
  }
  #dexDetail .hero-info>.stats .stat>b{
    width:100%!important;
    text-align:center!important;
  }

  /* Block 2 header: remove carrot decoration and center the rate label/value. */
  #detailFoods .v43-food-icon{
    display:none!important;
  }
  #detailFoods .v43-food-title{
    justify-content:center!important;
    width:100%!important;
    text-align:center!important;
  }
  #detailFoods .v26-food-rate{
    align-items:center!important;
    padding-left:0!important;
    text-align:center!important;
  }
  #detailFoods .v26-food-rate strong{
    margin:2px 0 0!important;
    text-align:center!important;
  }

  /* Block 2 rows: one continuous tint from A/B/C through all quantity cells.
     Recipe area remains a separate white surface. */
  #detailFoods .v26-food-head,
  #detailFoods .v24-food-row{
    grid-template-columns:minmax(58px,.70fr) 40px 40px 40px minmax(128px,1.62fr)!important;
    column-gap:0!important;
  }
  #detailFoods .v24-food-name,
  #detailFoods .v24-level{
    border-left:0!important;
  }
  #detailFoods .slot-A .v24-food-name,
  #detailFoods .slot-A .v24-level{background:#f7fcf9!important;}
  #detailFoods .slot-B .v24-food-name,
  #detailFoods .slot-B .v24-level{background:#fff8fa!important;}
  #detailFoods .slot-C .v24-food-name,
  #detailFoods .slot-C .v24-level{background:#fffbf4!important;}

  /* No second capsule behind A/B/C; letters use a darker semantic color only. */
  #detailFoods .v24-letter{
    background:transparent!important;
    border-radius:0!important;
    box-shadow:none!important;
    width:auto!important;
    min-width:18px!important;
    height:auto!important;
    padding:0!important;
    font-size:14px!important;
    font-weight:950!important;
  }
  #detailFoods .slot-A .v24-letter{background:transparent!important;color:#14784d!important;}
  #detailFoods .slot-B .v24-letter{background:transparent!important;color:#ad3f67!important;}
  #detailFoods .slot-C .v24-letter{background:transparent!important;color:#84601f!important;}

  /* Give recipe previews a little more visual weight without changing recipe data. */
  #detailFoods .v24-recipes{
    background:#fff!important;
    gap:4px!important;
    padding-left:6px!important;
    padding-right:6px!important;
  }
  #detailFoods .v24-placeholder{
    font-size:20px!important;
    min-width:24px!important;
  }
  #detailFoods .v26-recipe-head{
    font-size:13px!important;
  }

  /* Block 3: skill name is the clear visual headline; closed state stays compact. */
  #v12Ability .ability-card:has(#detailSkill){
    padding-top:3px!important;
    padding-bottom:3px!important;
    margin-bottom:1px!important;
  }
  #v12Ability .skill-box{
    row-gap:0!important;
    margin-bottom:0!important;
  }
  #v12Ability .v26-skill-left{
    gap:8px!important;
    line-height:1.1!important;
  }
  #v12Ability .skill-name{
    font-size:29px!important;
    line-height:1.1!important;
    font-weight:950!important;
  }
  #v12Ability .skill-rate-inline{
    font-size:12px!important;
    line-height:1.1!important;
    color:#111!important;
  }
  #v12Ability .skill-rate-inline strong{
    font-size:13px!important;
    color:#111!important;
  }
  #v12Ability .v33-skill-effect-row{
    margin-top:3px!important;
    padding-top:0!important;
  }
  #v12Ability .v33-skill-effect-row .skill-desc{
    padding-top:0!important;
    margin:0!important;
  }
  #v12Ability .v33-skill-effect-row .skill-detail-toggle{
    padding-top:0!important;
    padding-bottom:0!important;
    margin:0!important;
  }
  #v12Ability .skill-levels.open{
    margin-top:1px!important;
    padding-top:1px!important;
  }
  #evolutionCard{
    margin-top:1px!important;
  }

  /* Block 4: evolution arrows are neutral black. */
  #dexDetail .v31-big-arrow{
    color:#111!important;
  }
}


/* v95: dedicated layouts for the rebuilt Box screen and Dex food rows. */
/* Box identity remains visible while reading its long sections. */
#boxDetail .detail-head{
  position:sticky;top:56px;z-index:69;display:flex;align-items:center;
  gap:8px;min-height:48px;margin:0 -12px 10px;padding:5px 12px;
  background:rgba(255,255,255,.97);border-bottom:1px solid #e1e8e4;
  backdrop-filter:blur(12px);
}
#boxDetail .detail-head>[data-back]{flex:0 0 auto;padding:7px 9px;white-space:nowrap;font-size:13px}
#boxDetail #boxTitle{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:17px;margin:0;font-weight:950}
#boxDetail #boxHeaderMeta{flex:0 0 auto;font-size:11px;font-weight:900;color:#111;white-space:nowrap}
@media(max-width:620px){
 #boxDetail .detail-head{top:calc(38px + env(safe-area-inset-top));min-height:44px}
 #boxDetail .detail-head>[data-back]{font-size:12px}
 #boxDetail #boxTitle{font-size:16px}
}
#boxDetail .detail-head h2{display:flex;align-items:baseline;justify-content:center;gap:5px;flex:1;min-width:0}
#boxDetail #boxHeaderNo{font-size:10px;font-weight:900;white-space:nowrap;color:#111}
#boxDetail #boxHeaderMeta{min-width:34px;text-align:right}
#boxDetail #boxIdentity:empty{display:none}
#boxDetail .psg-box-art-badges{position:absolute;right:7px;bottom:7px;display:flex;align-items:center;gap:4px;z-index:2}
#boxDetail .psg-box-art-badge{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.96);border:1px solid #d8e5de;box-shadow:0 1px 5px rgba(30,57,42,.16)}
#boxDetail .psg-box-art-badge img{width:23px;height:23px;object-fit:contain;image-rendering:pixelated}
#boxDetail .psg-box-art-badge .filter-pictogram{font-size:12px;font-weight:900}
#boxDetail .psg-box-hero{background:#eef8f0;border-color:#cfe8d4}
#boxDetail .psg-box-identity{display:grid;grid-template-columns:minmax(100px,36%) 1fr;gap:10px;align-items:stretch}
#boxDetail .psg-box-artwork{min-height:220px;background:#f8faf8;border:1px solid #dfe8e4;border-radius:18px;position:relative;overflow:hidden;display:grid;place-items:center}
#boxDetail .psg-box-artwork img{max-width:100%;max-height:100%;object-fit:contain}
#boxDetail .psg-box-facts{min-width:0;display:flex;flex-direction:column;gap:8px}
#boxDetail #boxIdentity{font-weight:900;font-size:14px}
#boxDetail .psg-box-stats{display:grid;gap:7px;flex:1}
#boxDetail .psg-box-stat{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;padding:5px 3px;background:#fff;border-radius:13px;text-align:center}
#boxDetail .psg-box-stat small{font-size:10px;font-weight:900;color:#111}
#boxDetail .psg-box-stat strong{font-size:clamp(14px,4vw,22px);line-height:1.25;overflow-wrap:anywhere}
#boxDetail .psg-box-stat em{font-style:normal;color:#111;font-size:11px;font-weight:800}
#boxDetail .psg-box-level{margin-top:12px;background:#fff;padding:10px;border-radius:13px}
#boxDetail .psg-box-level label{font-weight:900}
#boxDetail .psg-box-level-controls{justify-content:center;gap:10px;margin:6px 0}
#boxDetail #boxLevelInput{width:65px;text-align:center;border:1px solid #dfe8e4;border-radius:8px;padding:8px}
#boxDetail #lvRange{width:100%}
#boxDetail .psg-box-section h3{font-size:20px;margin:0 0 12px;color:#111}
#boxDetail .psg-box-section{background:#f3f7ff}
#boxDetail .psg-box-line{display:flex;align-items:center;gap:8px;min-height:51px;border-bottom:1px solid #e2e9ed;padding:6px 0;min-width:0}
#boxDetail .psg-box-line:last-child{border-bottom:0}
#boxDetail .psg-box-line .psg-level-label{flex:0 0 62px;font-size:12px;font-weight:900}
#boxDetail .psg-box-line .psg-line-body{flex:1;min-width:0;overflow-wrap:anywhere;font-weight:800}
#boxDetail .psg-box-line .psg-subskill-badge{width:36px;height:36px;object-fit:contain;vertical-align:middle;margin-right:7px;flex:none}
#boxDetail .psg-box-line .psg-line-state{font-size:11px;color:#111;white-space:nowrap;font-weight:800}
#boxDetail .psg-box-line.is-locked{opacity:.63}
#boxDetail .psg-box-ingredient-art{width:36px;height:36px;object-fit:contain;vertical-align:middle;margin-right:6px}
#boxDetail .psg-box-ingredient-art img,#boxDetail .psg-box-skill-art img{width:36px;height:36px;object-fit:contain;vertical-align:middle}
#boxDetail .psg-box-forecast{margin-top:10px;background:#fff;border-radius:10px;padding:10px}
#boxDetail .psg-box-forecast p{margin:4px 0 0;color:#111}
#boxDetail .psg-box-lead{font-weight:950;font-size:19px;line-height:1.4}
#boxDetail .psg-box-skill-art{width:42px;height:42px;object-fit:contain;vertical-align:middle;margin-right:8px}
#boxDetail .psg-box-muted{color:#111;font-size:13px;line-height:1.5}
#boxDetail .psg-mint-mark{display:inline-flex;border:1px solid #8ab99e;border-radius:50%;background:#fff;color:#56966e;width:25px;height:25px;align-items:center;justify-content:center;margin-left:7px;vertical-align:middle}
#boxDetail .psg-milestone{background:#fff;border-radius:11px;padding:10px;margin-top:7px}
#boxDetail .psg-box-editor summary{font-weight:900;cursor:pointer}
#boxDetail #boxEditForm{display:grid;gap:10px;margin-top:12px}
#boxDetail #boxEditForm label{display:grid;gap:3px;font-weight:800;font-size:13px}
#boxDetail #boxEditForm input,#boxDetail #boxEditForm select{min-width:0;width:100%;border:1px solid #cbdad3;background:#fff;border-radius:8px;padding:9px;font-size:16px}
#boxDetail #boxEditForm .psg-editor-check{display:flex;align-items:center;gap:8px}
#boxDetail #boxEditForm .psg-editor-check input{width:auto}
#boxDetail #boxEditIngredients,#boxDetail #boxEditSubskills{display:grid;gap:8px}
@media(max-width:390px){#boxDetail .psg-box-artwork{min-height:190px}#boxDetail .psg-box-stat small{font-size:9px}#boxDetail .psg-box-stat strong{font-size:14px}}
/* Box Block 1 shares the Dex geometry: square artwork, facts to the right,
   and a full-width action row where the Dex shows tabs. */
#boxDetail .psg-box-hero{padding:7px;background:var(--box-type-bg,#eef8f0);border-radius:18px}
#boxDetail .psg-box-identity{grid-template-columns:minmax(108px,37%) minmax(0,1fr);gap:6px;align-items:start}
#boxDetail .psg-box-artwork{width:100%;min-height:0;aspect-ratio:1/1;background:rgba(255,255,255,.58);border-radius:16px}
#boxDetail .psg-box-artwork>img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
#boxDetail .psg-box-facts{justify-content:space-between;gap:4px;align-self:stretch}
#boxDetail .psg-box-traits{display:grid;grid-template-columns:31fr 38fr 31fr;gap:3px;min-width:0}
#boxDetail .psg-box-trait{display:flex;align-items:center;justify-content:center;gap:2px;min-width:0;min-height:31px;padding:3px 2px;border-radius:9px;background:#fff;font-size:11px;font-weight:850;white-space:nowrap;overflow:hidden;color:#111}
#boxDetail .psg-box-trait-berry img{width:19px;height:19px;object-fit:contain;flex:none}
#boxDetail .psg-box-trait-berry b{font-size:11px}
#boxDetail .psg-box-stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:3px;flex:1;background:transparent;border:0}
#boxDetail .psg-box-stat{min-height:48px;padding:3px 2px;border-radius:12px;gap:2px}
#boxDetail .psg-box-stat small{font-size:clamp(7px,2.1vw,10px);line-height:1.12;letter-spacing:-.03em}
#boxDetail .psg-box-stat strong{font-size:clamp(11px,3vw,18px);line-height:1.1}
#boxDetail .psg-box-stat em{font-size:10px;line-height:1}
#boxDetail .psg-box-level{grid-template-columns:auto 1fr;gap:4px 8px;margin-top:6px;padding:5px 8px;border-radius:10px}
#boxDetail .psg-box-level label{grid-column:1;font-size:12px;white-space:nowrap;color:#111}
#boxDetail .psg-box-level-controls{grid-column:2;justify-content:flex-end;gap:5px;margin:0}
#boxDetail .psg-box-level-controls .btn{min-width:32px;min-height:32px;padding:0 4px}
#boxDetail #lv{white-space:nowrap;font-size:13px}
#boxDetail #boxLevelInput{width:43px;padding:4px;font-size:13px}
#boxDetail #lvRange{grid-column:1/-1;min-height:20px}
@media(max-width:390px){
 #boxDetail .psg-box-identity{grid-template-columns:minmax(104px,37%) minmax(0,1fr)}
 #boxDetail .psg-box-trait{font-size:9px}
 #boxDetail .psg-box-stat{min-height:45px}
 #boxDetail .psg-box-stat small{font-size:8px}
 #boxDetail .psg-box-stat strong{font-size:12px}
}


#pane-ability .ability-card:has(#detailFoods)>.ability-title,
#pane-ability .ability-card:has(#detailFoods)>.food-table-head{display:none!important}
#detailFoods .psg-food-head{display:flex;justify-content:space-between;padding:10px 7px 12px;gap:10px;color:#111}
#detailFoods .psg-food-rate{display:flex;flex-direction:column;align-items:flex-start;font-weight:900;line-height:1.15}
#detailFoods .psg-food-rate strong{font-size:25px;color:#111}
#detailFoods .psg-food-stack{margin:0 4px 10px;border:1px solid #e0e9e5;border-radius:16px;overflow:hidden;background:#fff}
#detailFoods .psg-food-row{display:grid;grid-template-columns:minmax(90px,30%) minmax(0,1fr);background:#fff}
#detailFoods .psg-food-row:not(:last-child){border-bottom:1px solid #e0e9e5}
#detailFoods .psg-food-id{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:10px 5px;min-width:0;position:relative}
#detailFoods .psg-food-id b{position:absolute;left:8px;top:9px;font-size:20px;line-height:1}
#detailFoods .psg-food-id img{width:clamp(50px,14vw,84px);height:clamp(50px,14vw,84px);object-fit:contain}
#detailFoods .psg-food-id .psg-food-fallback{font-size:12px;text-align:center;overflow-wrap:anywhere;margin-top:12px}
#detailFoods .psg-food-row[data-slot="A"] .psg-food-id{background:#e9f8ee}
#detailFoods .psg-food-row[data-slot="B"] .psg-food-id{background:#fdf0f3}
#detailFoods .psg-food-row[data-slot="C"] .psg-food-id{background:#fdf6e9}
#detailFoods .psg-food-row[data-slot="A"] .psg-food-id b{color:#609c7a}
#detailFoods .psg-food-row[data-slot="B"] .psg-food-id b{color:#bd7289}
#detailFoods .psg-food-row[data-slot="C"] .psg-food-id b{color:#a28c5c}
#detailFoods .psg-food-content{display:grid;grid-template-rows:auto auto;min-width:0}
#detailFoods .psg-food-levels{align-items:center;min-height:67px;background:#fff}
#detailFoods .psg-food-level{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:5px 2px}
#detailFoods .psg-food-level+ .psg-food-level{border-left:1px solid #e7edea}
#detailFoods .psg-food-level small{font-size:11px;font-weight:900;background:#eaf4ff;border-radius:7px;padding:3px 5px;color:#111}
#detailFoods .psg-food-level strong{font-size:clamp(15px,4vw,22px);line-height:1.15;white-space:nowrap;color:#111}
#detailFoods .psg-food-recipes{border-top:1px solid #e8eeeb;background:#fffaf4;padding:6px 8px 8px;min-width:0;min-height:87px}
#detailFoods .psg-food-recipes.is-pending{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:35px;padding:5px 9px;background:#fffaf4}
#detailFoods .psg-food-recipes.is-pending .psg-food-recipes-label{margin:0;color:#111}
#detailFoods .psg-food-pending{font-size:11px;font-weight:750;color:#111}
#detailFoods .psg-food-recipes-label{font-size:11px;font-weight:850;color:#111;margin-bottom:5px;line-height:1.2}
#detailFoods .psg-food-recipe-strip{display:flex;gap:5px;align-items:center;min-width:0;overflow-x:auto;scrollbar-width:none}
#detailFoods .psg-food-recipe-strip::-webkit-scrollbar{display:none}
#detailFoods .psg-food-recipe-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1 0 0;min-width:0;max-width:84px;height:58px;border:1px solid #f1e8db;border-radius:9px;background:#fff}
#detailFoods .psg-food-recipe-tile img{width:37px;height:37px;object-fit:contain}
#detailFoods .psg-food-recipe-missing{display:grid;place-items:center;width:37px;height:37px;font-size:25px;line-height:1;color:#91a39b}
#detailFoods .psg-food-recipe-tile small{font-size:10px;font-weight:900}
@media(max-width:390px){#detailFoods .psg-food-row{grid-template-columns:minmax(90px,31%) minmax(0,1fr)}#detailFoods .psg-food-id img{width:52px;height:52px}#detailFoods .psg-food-recipe-tile{height:54px}}
#evolutionCard .v31-evo-node{border:1px solid #e1ebe6!important;border-radius:14px!important;background:#fff!important;padding:8px 5px!important}


/* v106: a shared, compact detail identity and aligned content columns. */
#detailFoods .psg-food-head{display:grid;grid-template-columns:minmax(64px,22%) minmax(108px,30%) minmax(0,1fr);align-items:end;gap:0;padding:5px 4px 7px}
#detailFoods .psg-food-rate span{font-size:20px;font-weight:950;color:#111}
#detailFoods .psg-food-head>b{text-align:center;font-size:13px;color:#111}
#detailFoods .psg-food-head-levels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));text-align:center;font-size:12px;font-weight:900;color:#111}
#detailFoods .psg-food-stack{border-radius:18px;box-shadow:none}
#detailFoods .psg-food-row,#detailFoods .psg-food-row[data-slot]{grid-template-columns:minmax(64px,22%) minmax(108px,30%) minmax(0,1fr);min-height:82px}
#detailFoods .psg-food-id{padding:7px 2px;gap:0}
#detailFoods .psg-food-id img{width:clamp(38px,11vw,56px);height:clamp(38px,11vw,56px)}
#detailFoods .psg-food-levels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:stretch;min-width:0}
#detailFoods .psg-food-level{min-width:0;padding:4px 1px;display:grid;place-items:center}
#detailFoods .psg-food-level+.psg-food-level{border-left:0}
#detailFoods .psg-food-level strong{font-size:clamp(12px,3.6vw,20px)}
#detailFoods .psg-food-row[data-slot="A"] .psg-food-id,#detailFoods .psg-food-row[data-slot="A"] .psg-food-levels{background:#e9f8ee}
#detailFoods .psg-food-row[data-slot="B"] .psg-food-id,#detailFoods .psg-food-row[data-slot="B"] .psg-food-levels{background:#fdf0f3}
#detailFoods .psg-food-row[data-slot="C"] .psg-food-id,#detailFoods .psg-food-row[data-slot="C"] .psg-food-levels{background:#fdf6e9}
#detailFoods .psg-food-recipes{border-top:0;border-left:1px solid #e8eeeb;min-height:82px;background:#fff;padding:6px 3px;display:flex;align-items:center;justify-content:center;min-width:0}
#detailFoods .psg-food-recipes.is-pending{min-height:82px;background:#fff;padding:5px 3px}
#detailFoods .psg-food-recipe-strip{width:100%;gap:2px}
#detailFoods .psg-food-recipe-tile{height:55px;flex:0 0 clamp(43px,11vw,60px);border-radius:12px}
#detailFoods .psg-food-recipe-tile img{width:34px;height:34px}
#detailFoods .psg-food-pending{color:#111;font-size:10px}
#v12Ability .ability-card:has(#detailSkill),#evolutionCard{border-radius:18px!important;box-shadow:none!important}
/* The skill block needs one quiet surface to balance the food and evolution sections. */
#v12Ability .ability-card:has(#detailSkill){background:rgba(255,255,255,.78)!important;border:1px solid #e1e9e6!important;border-radius:18px!important;padding:10px 9px!important;margin-bottom:8px!important}
#evolutionCard .v31-evo-node{border-radius:16px!important}
#dexDetail .v31-big-arrow{color:#39453d!important;font-size:27px!important;font-weight:500!important;line-height:1!important}
#dexDetail .v106-evo-conditions{order:2!important;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11px;font-weight:850;color:#111;white-space:nowrap;line-height:1.15}
#dexDetail .v31-evo-step{min-width:19px!important;width:19px!important}
#dexDetail .v31-evo-line{gap:3px!important}
#boxDetail #boxIngredientRows{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}
#boxDetail .psg-v106-ingredient{display:flex;flex-direction:column;align-items:center;gap:4px;min-width:0;min-height:105px;padding:6px 2px;border-radius:13px;background:#fff;color:#111}
#boxDetail .psg-v106-ingredient.is-locked{opacity:.48}
#boxDetail .psg-v106-unlock{font-size:12px;line-height:1.2;min-height:15px}
#boxDetail .psg-v106-ingredient-image{display:grid;place-items:center;width:44px;height:44px}
#boxDetail .psg-v106-ingredient-image img{width:44px;height:44px;object-fit:contain}
#boxDetail .psg-v106-ingredient strong{font-size:15px}
#boxDetail .psg-v106-unknown{font-size:18px;color:#81908a}
#boxDetail .psg-box-level{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:9px;align-items:center;padding:7px 8px;margin-top:5px}
#boxDetail .psg-box-level-controls{grid-column:1;display:flex;align-items:center;justify-content:flex-start;gap:4px;margin:0}
#boxDetail .psg-box-level-controls .btn{min-width:35px;min-height:38px}
#boxDetail #lv{min-width:34px;text-align:center;white-space:nowrap}
#boxDetail #lvRange{grid-column:2;min-width:0;width:100%;min-height:40px;margin:0;touch-action:pan-x}
@media(max-width:620px){
  main:has(#boxDetail.active),main:has(#dexDetail.active){padding-top:0!important}
  #boxDetail .detail-head,#dexDetail .detail-head{margin-top:0!important;margin-bottom:3px!important}
  #dexDetail .hero-info>.stats .stat{min-height:42px!important;padding:2px!important;gap:1px!important}
  #boxDetail .psg-box-stat{min-height:46px;padding:2px}
  #boxDetail .psg-box-stats{grid-template-rows:repeat(2,minmax(46px,1fr))}
  #boxDetail .psg-box-section{padding:10px;margin-bottom:7px}
  #boxDetail .psg-box-section h3{margin-bottom:8px}
  #boxDetail .psg-box-line{min-height:44px;padding:4px 0}
  #boxDetail .psg-v106-ingredient{min-height:96px;gap:2px;padding:5px 2px}
  #detailFoods .psg-food-row,#detailFoods .psg-food-recipes,#detailFoods .psg-food-recipes.is-pending{min-height:74px}
  #dexDetail{border-radius:0!important}
  #dexDetail .hero-top{grid-template-columns:minmax(102px,34%) minmax(0,1fr)!important;grid-template-rows:auto!important;align-items:start!important}
  #dexDetail .psg-v106-media,#boxDetail .psg-v106-media{display:flex;flex-direction:column;gap:4px;min-width:0}
  #dexDetail .hero-art{grid-column:auto!important;grid-row:auto!important;align-self:auto!important;min-height:0!important;width:100%!important;aspect-ratio:1!important}
  #dexDetail .hero-info{grid-column:2!important;grid-row:1!important;justify-content:flex-start!important;gap:3px!important}
  #dexDetail .hero-info #v12Header{width:100%!important;min-width:0!important;flex:none!important}
  #dexDetail .hero-info .v19-traits,#boxDetail .psg-box-facts .psg-box-traits{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:2px!important;width:100%!important}
  #dexDetail .hero-info .v19-traits>span,#boxDetail .psg-box-facts .psg-box-trait{height:30px!important;min-height:30px!important;min-width:0!important;padding:2px 0!important;font-size:8px!important;line-height:1!important;white-space:nowrap!important;gap:0!important;border-radius:8px!important}
  #dexDetail .hero-info .v44-berry-visual,#dexDetail .hero-info .v44-berry-visual img{width:14px!important;height:14px!important;flex:0 0 14px!important}
  #dexDetail .hero-info .v44-berry-trait b,#boxDetail .psg-box-facts .psg-box-trait b{font-size:8px!important}
  #dexDetail .hero-info .psg-specialty-icon,#boxDetail .psg-box-facts .psg-specialty-icon{width:23px!important;height:23px!important;object-fit:contain}
  #boxDetail .psg-box-facts{gap:3px!important}
  #boxDetail .psg-box-facts .psg-box-trait-berry>img{width:15px!important;height:15px!important}
  #boxDetail .psg-box-stats{flex:0 0 auto!important}
  #dexDetail .psg-v106-media #v12Header{width:100%!important}
  #dexDetail .psg-v106-media .v19-traits,#boxDetail .psg-v106-media .psg-box-traits{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:2px!important;width:100%!important}
  #dexDetail .psg-v106-media .v19-traits>span,#boxDetail .psg-v106-media .psg-box-trait{min-height:30px!important;height:30px!important;padding:2px 0!important;font-size:8px!important;line-height:1!important;gap:0!important;white-space:nowrap!important;border-radius:8px!important}
  #dexDetail .psg-v106-media .v44-berry-visual,#dexDetail .psg-v106-media .v44-berry-visual img{width:14px!important;height:14px!important;flex:0 0 14px!important}
  #dexDetail .psg-v106-media .v44-berry-trait b,#boxDetail .psg-v106-media .psg-box-trait b{font-size:8px!important}
  #dexDetail .psg-v106-media .psg-specialty-icon,#boxDetail .psg-v106-media .psg-specialty-icon{width:23px;height:23px;object-fit:contain}
  #boxDetail .psg-box-identity{grid-template-columns:minmax(102px,34%) minmax(0,1fr);align-items:start}
  #boxDetail .psg-box-facts{justify-content:flex-start}
  #boxDetail .psg-v106-media .psg-box-trait-berry>img{width:15px;height:15px}
  #boxDetail .psg-v106-media .psg-box-traits{align-items:start}
}
/* Duplicate rates are omitted only while the complete identity panel is sticky. */
@media(max-width:620px) and (orientation:portrait){
  #dexDetail>.psg-dex-sticky,#boxDetail>.psg-box-hero{position:sticky!important;top:calc(83px + env(safe-area-inset-top))!important;z-index:55!important}
  #boxDetail>.psg-box-hero{box-shadow:0 2px 5px rgba(20,40,30,.10)!important}
  #detailFoods .psg-food-rate strong,#v12Ability .skill-rate-inline{display:none!important}
  #boxDetail #boxEditor{scroll-margin-top:310px}
}
@media(max-width:620px) and (orientation:landscape){
  #dexDetail>.psg-dex-sticky,#boxDetail>.psg-box-hero{position:relative!important}
}


/* v111: align all section frames to the pinned identity card. */
@media(max-width:620px){
  #v12Ability,#v12Sleep,#v12Field{padding-inline:0!important}
  #v12Ability>.ability-card:has(#detailFoods){padding-inline:0!important;padding-top:4px!important;padding-bottom:4px!important}
  #detailFoods .psg-food-stack{margin-inline:0!important;margin-bottom:5px!important}
  #v12Ability .ability-card:has(#detailSkill){margin-inline:0!important;margin-bottom:5px!important}
  #v12Ability #evolutionCard{margin-inline:0!important;margin-top:0!important;padding:9px 7px!important;background:rgba(255,255,255,.78)!important;border:1px solid #e1e9e6!important;border-radius:18px!important}
  #boxDetail>.psg-box-hero,#boxDetail>.psg-box-section,#boxDetail>.psg-box-editor,#boxDetail>.card{box-sizing:border-box;width:100%;margin-inline:0}
  #boxDetail>.psg-box-section{margin-bottom:6px}
  #detailFoods .psg-food-head{padding-top:3px;padding-bottom:5px}
  #detailFoods .psg-food-row,#detailFoods .psg-food-recipes,#detailFoods .psg-food-recipes.is-pending{min-height:68px}
  #detailFoods .psg-food-id{padding-block:3px}
  #detailFoods .psg-food-id img{width:44px;height:44px}
  #detailFoods .psg-food-levels{min-height:68px}
  #detailFoods .psg-food-recipes,#detailFoods .psg-food-recipes.is-pending{padding:3px 2px}
  #detailFoods .psg-food-recipe-tile{height:58px;position:relative}
  #detailFoods .psg-food-recipe-tile img{width:44px;height:44px;object-fit:contain}
  #detailFoods .psg-food-recipe-tile small{position:absolute;right:1px;bottom:1px;min-width:16px;padding:1px 2px;border-radius:7px;background:rgba(255,255,255,.94);font-size:9px;line-height:1}
  #dexDetail .v51-type-badge{right:7px!important;bottom:7px!important;width:30px!important;height:30px!important;padding:0!important;border:1px solid #d8e5de!important;border-radius:50%!important;display:grid!important;place-items:center!important;background:rgba(255,255,255,.96)!important;box-shadow:0 1px 5px rgba(30,57,42,.16)!important}
  #dexDetail .v51-type-badge img{width:23px!important;height:23px!important;object-fit:contain!important;image-rendering:pixelated}
  #dexDetail .v51-type-badge .filter-pictogram{font-size:12px}
}
/* Evolution: face on the left and outgoing requirements on the right. */
#dexDetail .v31-evo-line{display:flex!important;align-items:stretch!important;gap:5px!important;padding:2px 0!important;overflow-x:visible!important}
#dexDetail .v31-evo-line>.v31-evo-node{flex:1 1 0!important;width:0!important;min-width:0!important;max-width:none!important}
#dexDetail .v31-evo-node{min-width:0!important;gap:6px!important;justify-content:flex-start!important;overflow:visible!important}
#dexDetail .v31-evo-node .v31-evo-name{max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important;line-height:1.2!important;font-size:clamp(10px,2.7vw,13px)!important}
#dexDetail .v111-evo-body{display:grid;grid-template-columns:minmax(0,56px) minmax(0,1fr);align-items:center;gap:3px;width:100%;min-width:0}
#dexDetail .v31-evo-node:not(:has(.v106-evo-conditions)) .v111-evo-body{display:flex;justify-content:center}
#dexDetail .v31-evo-line .v31-evo-image{width:clamp(44px,13vw,56px)!important;height:clamp(44px,13vw,56px)!important;transform:none!important;min-width:0!important;overflow:visible!important}
#dexDetail .v31-evo-node.is-current .v31-evo-image{transform:none!important}
#dexDetail .v31-evo-image>img{object-fit:contain!important;width:100%!important;height:100%!important}
#dexDetail .v31-evo-type{right:-2px!important;bottom:-2px!important;width:21px!important;height:21px!important;font-size:12px!important}
#dexDetail .v106-evo-conditions{display:flex!important;flex-direction:column!important;align-items:flex-start!important;gap:2px!important;min-width:0!important;max-width:100%!important;font-size:clamp(9px,2.35vw,11px)!important;line-height:1.2!important;white-space:normal!important;text-align:left!important;overflow-wrap:anywhere}
#dexDetail .v106-evo-conditions>span:first-child{white-space:nowrap!important}
#dexDetail .v111-evo-next{margin-left:2px;font-size:1.25em;line-height:.8;color:#39453d}
#dexDetail .v31-branch-layout{grid-template-columns:minmax(58px,22%) 16px minmax(0,1fr)!important;gap:2px!important}
#dexDetail .v31-branch-grid{gap:6px 2px!important}
#dexDetail .v31-branch-cell .v31-evo-node{width:100%!important}
#dexDetail .v31-branch-cell .v111-evo-body{display:flex;justify-content:center}

/* Sleep-style gallery: master entries are ordered by stars and shown two across. */
.psg-info-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:15px}
.psg-info-link{width:100%;display:grid;grid-template-columns:1fr auto;gap:3px;text-align:left;align-items:center;cursor:pointer;color:#16221b}
.psg-info-links .psg-info-link{min-width:0;min-height:104px;margin:0;padding:12px;align-content:center}
.psg-info-links .psg-info-link span{min-width:0;line-height:1.35}
.psg-info-link strong{font-size:19px}.psg-info-link span{color:var(--muted);font-size:13px}
.psg-info-link b{grid-column:2;grid-row:1/3;font-size:24px;color:#587567}
.psg-subpage-head{display:flex;align-items:center;gap:12px;margin-bottom:12px}.psg-subpage-head h2{margin:0}
.psg-recipe-categories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}
.psg-recipe-categories button{min-height:46px;padding:8px 3px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:clamp(10px,2.8vw,13px);font-weight:700;color:#24332d;cursor:pointer}
.psg-recipe-categories button.active{background:#e8f3e9;border-color:#7db88d}
.psg-recipe-sticky{position:sticky;top:var(--psg-header-height);z-index:60;padding:7px 0 9px;background:var(--bg);border-bottom:1px solid var(--line)}
.psg-recipe-sticky .psg-subpage-head{margin-bottom:8px}
.psg-recipe-filter-bar{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,3fr);gap:7px;margin-top:8px}
.psg-recipe-select .filter-panel{min-width:175px;right:auto;width:max-content;max-width:min(90vw,280px)}
.psg-recipe-filter-option{display:flex;align-items:center;gap:9px;cursor:pointer}
.psg-recipe-filter-option img{width:30px;height:30px;object-fit:contain}.psg-recipe-filter-option[aria-pressed="true"]{background:#e7f6ef}
.psg-recipe-sort-label{display:flex;align-items:center;gap:4px;white-space:nowrap;font-size:11px;font-weight:750}
.psg-recipe-sort-label select{min-width:0;width:100%;padding:9px 2px;border:1px solid var(--line);border-radius:10px;background:#fff;color:#111;font-size:12px;font-weight:700}
.psg-recipe-count{margin:10px 2px 6px}
.psg-recipe-entry{padding:0!important;overflow:hidden}
.psg-recipe-entry>.psg-recipe-heading{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:start;cursor:pointer;padding:13px;list-style:none}
.psg-recipe-entry>.psg-recipe-heading::-webkit-details-marker{display:none}
.psg-recipe-heading>strong{font-size:clamp(15px,4vw,18px);line-height:1.3;color:#111}
.psg-recipe-heading .psg-recipe-energy{display:flex;flex-direction:column;align-items:flex-end;justify-content:flex-start;gap:1px;white-space:nowrap}
.psg-recipe-energy .psg-recipe-energy-max{font-size:18px;color:#111;line-height:1.3}
.psg-recipe-energy-max small{font-size:10px;font-weight:700;color:#55645e}
.psg-recipe-energy-max span{font-size:11px}.psg-recipe-energy .psg-recipe-energy-min{font-size:10px;color:#6e7a74}
.psg-recipe-chevron{display:grid;place-items:center;flex:none;width:22px;height:28px;margin-left:3px;color:#347958;font-size:20px;line-height:1;transition:transform .15s ease}
.psg-recipe-entry[open] .psg-recipe-chevron{transform:rotate(180deg)}
.psg-recipe-heading .psg-recipe-ingredients{grid-column:1/-1;display:flex;align-items:center;flex-wrap:wrap;gap:5px;margin:1px 0 0}
.psg-recipe-chip{padding:3px 7px}.psg-recipe-chip b{font-size:14px;color:#111}
.psg-recipe-pot{margin-left:auto;font-size:13px;font-weight:800;color:#111;white-space:nowrap}
.psg-recipe-expanded{border-top:1px solid var(--line);padding:10px 13px 13px}
.psg-recipe-expanded h3{font-size:14px;margin:0 0 9px}.psg-recipe-expanded>.note{margin:9px 0 0}
.psg-recipe-provider-group{border-top:1px solid #edf0ee;padding:8px 0}
.psg-recipe-provider-group>strong{display:flex;align-items:center;gap:5px;font-size:13px}
.psg-recipe-provider-group>strong img{width:24px;height:24px;object-fit:contain}
.psg-recipe-providers{display:flex;flex-direction:column;gap:7px;border:0;padding:6px 0 0}
.psg-recipe-family{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.psg-recipe-provider{border:1px solid var(--line);border-radius:10px;background:#fff;padding:4px;min-width:58px;max-width:64px;display:grid;justify-items:center;gap:2px;color:#111;cursor:pointer}
.psg-recipe-provider-art{position:relative;display:grid;place-items:center;width:50px;height:50px;border-radius:7px;background:#f4f8f5}
.psg-recipe-provider-art img{max-width:100%;max-height:100%;object-fit:contain}
.psg-recipe-provider-art img[hidden],.psg-recipe-provider-missing[hidden]{display:none}
.psg-recipe-provider-missing{font-size:9px;color:#708178}
.psg-recipe-provider-art small{position:absolute;bottom:-2px;right:-2px;border-radius:5px;background:#fff;padding:2px;font-size:9px;color:#111}
@media(max-width:620px){.psg-recipe-sticky .psg-subpage-head h2{font-size:17px}.psg-recipe-energy .psg-recipe-energy-max{font-size:16px}}
#v12Sleep .psg-sleep-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
#v12Sleep .psg-sleep-card{min-width:0;overflow:hidden;background:#fff;border:1px solid #e4e1eb;border-radius:15px;padding:7px}
#v12Sleep .psg-sleep-photo{position:relative;aspect-ratio:4/3;display:grid;place-items:center;border-radius:10px;background:#f8f7fa;overflow:hidden}
#v12Sleep .psg-sleep-photo img{display:block;width:100%;height:100%;object-fit:cover}
#v12Sleep .psg-sleep-no-image{font-size:13px;color:#75827c;font-weight:700}
#v12Sleep .psg-sleep-toggle{position:absolute;top:7px;right:7px;display:grid;place-items:center;width:34px;height:34px;padding:0;border:1px solid #d8e1dc;border-radius:50%;background:rgba(255,255,255,.97);color:#6d7a73;font-size:21px;line-height:1;box-shadow:0 1px 5px #0002;cursor:pointer}
#v12Sleep .psg-sleep-toggle[aria-pressed="true"]{background:#47a472;border-color:#47a472;color:#fff;font-size:22px}
#v12Sleep .psg-sleep-caption{display:flex;align-items:baseline;justify-content:center;gap:6px;padding:8px 3px 3px;color:#111;font-size:12px;font-weight:800;text-align:center;overflow-wrap:anywhere}
#dexDetail .v12-tabs .psg-sleep-tab-count{display:inline;font-size:.83em;font-weight:800;white-space:nowrap}
#v12Sleep .psg-sleep-stars{flex:none;color:#b87935;font-size:14px}
#v12Sleep .psg-sleep-empty{margin:0;padding:22px 14px;border:1px solid #e4e1eb;border-radius:15px;background:#fff;color:#55645c;font-size:13px;line-height:1.6}

/* The tab strip follows the type-colored identity card and stays pinned with it. */
@media(max-width:620px){
  #dexDetail>.psg-dex-sticky{width:100%;background:var(--pane-bg);box-shadow:none!important}
  #dexDetail .psg-dex-sticky>.hero{margin-bottom:0!important;padding-bottom:7px!important;border-radius:18px!important;box-shadow:none!important}
  #dexDetail .psg-dex-sticky>.v12-tabs{box-sizing:border-box;width:100%!important;margin:0!important;padding:7px 7px 0!important;background:var(--pane-bg)!important;border-radius:0!important}
  #dexDetail .v12-tabs button.active{border-radius:0!important;box-shadow:none!important}
  #dexDetail .v12-tabs button[data-v12tab="ability"].active{background:#f1f7ff!important;color:#1768a6!important;border:0!important;border-bottom:2px solid #2f80c9!important}
  #dexDetail .v12-tabs button[data-v12tab="sleep"].active{background:#f6f1fb!important;color:#704bb2!important;border:0!important;border-bottom:2px solid #7957b8!important}
  #dexDetail .v12-tabs button[data-v12tab="field"].active{background:#f0f6f1!important;color:#347a4b!important;border:0!important;border-bottom:2px solid #4d9662!important}
}
</style>
</head>
<body>
<header class="psg-app-header"><span class="psg-app-title">PokéSleep Guide</span><small class="psg-app-version">Review v184</small></header>
<main>
<section id="home" class="screen active"><div class="psg-home-heading"><h2>ホーム</h2><label class="psg-home-field" for="homeFieldSelect"><span>フィールド</span><select id="homeFieldSelect" aria-label="今週のフィールド"></select></label></div><div id="teamFaceDock" class="psg-team-face-dock" hidden aria-label="現在のチームの顔画像"></div><div class="card psg-team-card"><div class="section-title">現在のチーム</div>
<div class="psg-team-toolbar"><p class="note">ボックスの個体から5匹まで選べます。</p><button type="button" id="teamReorder" aria-pressed="false">並び替え</button></div><p id="teamHint" class="psg-team-hint" hidden></p><div id="teamSlots"></div><p id="teamSummary" class="note" role="status"></p></div>
<div class="card psg-day-card"><div class="psg-day-header"><div class="section-title">1日の獲得予想</div><label class="psg-day-setting" for="teamCollectionInterval">回収間隔 <select id="teamCollectionInterval" aria-label="起きている間の回収間隔"><option value="2">2時間</option><option value="4" selected>4時間</option><option value="8">8時間</option></select></label></div><div class="psg-day-toggles"><button type="button" id="teamGoodCamp" class="psg-day-camp" aria-pressed="false">いいキャンプ：OFF</button><button type="button" id="teamMeals" class="psg-day-camp" aria-pressed="true">食事3回：ON</button></div><fieldset class="psg-day-energy"><legend>チーム全員の起床時げんき</legend><div class="psg-day-energy-options"><button type="button" data-energy="80" aria-pressed="false">80</button><button type="button" data-energy="100" aria-pressed="true">100</button><button type="button" data-energy="120" aria-pressed="false">120</button><button type="button" data-energy="150" aria-pressed="false">150</button></div></fieldset><button type="button" class="psg-day-field-link" id="teamFieldLink"><span id="teamFieldSummary">フィールドを設定</span><b aria-hidden="true">›</b></button><div id="teamDayEstimate" aria-live="polite"></div><details class="psg-day-method"><summary>計算条件</summary><p>起床後16時間・睡眠8時間。げんきは10分ごとに1減少し、睡眠中は回収しません。睡眠回復は翌朝に適用。食事ONでは起床直後・6時間後・12時間後に3回食べる仮定。食事前のげんきに応じて各匹が1～9回復し、最大150。食材を消費できるかは判定しません。解放済みの食材枠は等確率、所持数の満杯は期待値で判定します。いいキャンプONではおてつだい速度と所持上限を各1.2倍。鍋容量1.5倍とリサーチの効果は日産表示の対象外です。選択中の通常フィールドで指定した好物きのみはエナジー2倍、エリアボーナスはきのみと固定エナジースキルに適用します。EXフィールドやイベント固有の補正は対象外です。メインスキルは満杯前のおてつだいと回収時のストック上限から期待回数を計算。げんきオールSは回収時にチームへ期待回復量を適用し、次の時間帯からおてつだい速度へ反映。発動率の推定値と近似計算を使用し、天井や発動タイミング・10分タイマーのリセットは再現しません。料理の必要数判定には使用しません。</p></details></div>
<div class="card psg-team-food-card"><div class="section-title">チームが拾う食材</div><div id="teamIngredientList"></div></div>
<div class="card psg-team-recipe-card"><div class="section-title">料理の食材チェック</div><p class="note">確認できた食材の種類だけを照合します。必要数・鍋容量は未判定です。</p><div id="teamRecipeList"></div></div></section>
<section id="box" class="screen"><div class="psg-list-sticky"><div class="toolbar"><h2 style="flex:1">ボックス</h2><input id="boxSearch" style="max-width:150px" placeholder="名前検索" aria-label="ポケモンの名前検索"><button class="btn primary" id="addBtn" aria-expanded="false" aria-controls="boxAddPanel">＋追加</button></div>
<div class="compact-filter" id="boxCompactFilters">
 <div class="box-filter-row">
  <div class="filter-select" data-menu="box-type"><button class="filter-main">タイプ <span>▼</span></button><div class="filter-panel" id="boxTypeFilters"><button class="filter-option" disabled>データ投入後に生成</button></div></div>
  <div class="filter-select" data-menu="box-ing"><button class="filter-main">食材 <span>▼</span></button><div class="filter-panel" id="boxIngredientFilters"><button class="filter-option" disabled>データ投入後に生成</button></div></div>
 </div>
 <div class="box-filter-row">
  <div class="filter-select" data-menu="box-spec"><button class="filter-main">得意 <span>▼</span></button><div class="filter-panel" id="boxSpecialtyFilters"><button class="filter-option" data-spec="きのみ"><img class="psg-specialty-icon" data-specialty-icon="berry" alt="">きのみ</button><button class="filter-option" data-spec="食材"><img class="psg-specialty-icon" data-specialty-icon="ingredient" alt="">食材</button><button class="filter-option" data-spec="スキル"><img class="psg-specialty-icon" data-specialty-icon="skill" alt="">スキル</button><button class="filter-option" data-spec="オール"><img class="psg-specialty-icon" data-specialty-icon="all" alt="">オール</button></div></div>
  <div class="filter-select" data-menu="box-tag"><button class="filter-main">タグ <span>▼</span></button><div class="filter-panel" id="boxTagFilters">
   <button class="filter-option" data-tag="favorite">★ お気に入り</button>
   <button class="filter-option" data-tag="training">🌱 育成</button>
   <button class="filter-option" data-tag="special">✨ 特別</button>
   <button class="filter-option" data-tag="shiny">🌈 色違い</button>
   <div class="tag-note">お気に入り・育成＝ユーザー設定<br>特別＝種族属性／色違い＝個体固有属性</div>
  </div></div>
 </div>
</div></div>
<div id="boxAddPanel" class="card" hidden style="margin-bottom:12px"><label for="boxSpecies">図鑑から選ぶ</label><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px"><select id="boxSpecies" class="btn" style="flex:1;min-width:160px"></select><button class="btn primary" id="boxConfirmAdd">Boxに登録</button><button class="btn" id="boxCancelAdd">キャンセル</button></div></div>
<div id="boxUndoPanel" class="card" hidden style="margin-bottom:12px">削除しました。 <button class="btn" id="boxUndoRemove">元に戻す</button></div>
<div id="boxTeamMode" class="psg-box-team-mode" hidden><strong id="boxTeamModeTitle">チームの枠を選択中</strong><span>個体カードをタップして登録</span><button type="button" id="boxTeamRemove">この枠から外す</button><button type="button" id="boxTeamCancel">キャンセル</button></div>
<div id="boxGrid" class="grid"></div><div id="boxEmpty" class="card empty">Boxは空です。「＋追加」から登録できます。</div></section>
<section id="dex" class="screen">
<div class="psg-list-sticky">
<div class="toolbar"><h2 style="flex:1">ポケモン図鑑</h2><input id="dexSearch" style="max-width:150px" placeholder="名前検索"></div>
<div class="compact-filter" id="dexCompactFilters">
 <div class="dex-filter-controls">
  <div class="filter-select" data-menu="dex-type"><button class="filter-main" aria-expanded="false">タイプ <span>▼</span></button><div class="filter-panel" id="typeFilters" aria-label="タイプで絞り込み"></div></div>
  <div class="filter-select" data-menu="dex-ing"><button class="filter-main" aria-expanded="false">食材 <span>▼</span></button><div class="filter-panel" id="ingredientFilters" aria-label="食材で絞り込み"></div></div>
 </div>
 <div class="spec-row" id="specialtyFilters">
  <button class="filter-main" data-spec="きのみ"><img class="psg-specialty-icon" data-specialty-icon="berry" alt="">きのみ</button>
  <button class="filter-main" data-spec="食材"><img class="psg-specialty-icon" data-specialty-icon="ingredient" alt="">食材</button>
  <button class="filter-main" data-spec="スキル"><img class="psg-specialty-icon" data-specialty-icon="skill" alt="">スキル</button>
  <button class="filter-main" data-spec="オール"><img class="psg-specialty-icon" data-specialty-icon="all" alt="">オール</button>
 </div>
</div>
</div>
<div class="note" id="dexCount" style="margin:0 2px 4px">0 / 0</div>
<div id="dexGrid" class="grid"></div><div id="dexEmpty" class="card empty">図鑑データは次段階で再調査して投入します。<br>未確認値は推測で埋めません。</div>
</section>
<section id="info" class="screen"><h2>情報</h2>
<div class="psg-info-links">
 <button type="button" class="card psg-info-link" data-info-page="recipePage"><strong>🍳 料理</strong><span>食材からレシピを探す</span><b aria-hidden="true">›</b></button>
 <button type="button" class="card psg-info-link" data-info-page="skillPage"><strong>✨ スキル</strong><span>効果とレベルを見る</span><b aria-hidden="true">›</b></button>
 <button type="button" class="card psg-info-link" data-info-page="fieldPage"><strong>🗺️ フィールド</strong><span>フィールド情報を見る</span><b aria-hidden="true">›</b></button>
</div>
<div class="card"><div class="section-title">記録のバックアップ</div><p>ボックス・寝顔・チーム・フィールド設定を１つのファイルに保存できます。</p>
 <button class="btn primary" type="button" id="backupExport">バックアップを書き出す</button>
 <label for="backupFile" style="display:block;margin-top:16px">バックアップを取り込む</label>
 <input id="backupFile" type="file" accept=".json,application/json" style="max-width:100%">
 <div id="backupPreview" class="note" role="status" style="margin-top:8px">ファイルを選ぶと内容を確認できます。</div>
 <button class="btn" type="button" id="backupImport" hidden>この記録を復元する</button>
</div></section>
<section id="skillPage" class="screen"><div class="psg-subpage-head"><button class="btn" data-back>‹ 戻る</button><h2>スキル</h2></div>
<div class="card psg-skill-index"><div class="section-title">✨ スキル一覧</div>
 <label for="skillSearch">スキル名・分類で検索</label><input id="skillSearch" type="search" placeholder="例：食材" autocomplete="off">
 <div id="skillIndexCount" class="note" role="status"></div><div id="skillIndexList"></div>
</div></section>
<section id="recipePage" class="screen"><div class="psg-recipe-sticky"><div class="psg-subpage-head"><button class="btn" data-back>‹ 戻る</button><h2>料理</h2></div>
 <div class="psg-recipe-categories" role="group" aria-label="料理の部門">
  <button type="button" class="active" data-recipe-category="カレー・シチュー" aria-pressed="true">カレー・シチュー</button>
  <button type="button" data-recipe-category="サラダ" aria-pressed="false">サラダ</button>
  <button type="button" data-recipe-category="デザート・ドリンク" aria-pressed="false">デザート・ドリンク</button>
 </div>
 <div class="psg-recipe-filter-bar"><div class="filter-select psg-recipe-select" data-menu="recipe-ing"><button type="button" class="filter-main" id="recipeIngredientButton" aria-expanded="false">食材 <span>▼</span></button><div class="filter-panel" id="recipeIngredientOptions" aria-label="食材で絞り込み"></div></div><label class="psg-recipe-sort-label" for="recipeSort">並び順<select id="recipeSort"><option value="energy-desc">エナジーが多い順</option><option value="energy-asc">エナジーが少ない順</option><option value="name">名前順</option></select></label></div>
 </div><div id="recipeCount" class="note psg-recipe-count" role="status"></div><div id="recipeList"></div>
</section>
<section id="fieldPage" class="screen"><div class="psg-subpage-head"><button class="btn" data-back>‹ 戻る</button><h2>フィールド</h2></div>
 <div class="card psg-field-settings"><div class="section-title">今週のフィールド</div><label for="fieldSelect">フィールド</label><select id="fieldSelect"></select><label for="fieldAreaBonus">このフィールドのエリアボーナス</label><div class="psg-field-percent"><input id="fieldAreaBonus" type="number" inputmode="numeric" min="0" max="200" step="5" value="0"><span>％</span></div><div class="psg-field-week" id="fieldWeekLabel"></div><fieldset class="psg-day-field"><legend>今週の好物きのみ</legend><div class="psg-day-berries"><label>① <select class="psg-favorite-berry"><option value="">指定なし</option></select></label><label>② <select class="psg-favorite-berry"><option value="">指定なし</option></select></label><label>③ <select class="psg-favorite-berry"><option value="">指定なし</option></select></label></div><button type="button" class="btn psg-field-reset" id="fieldFavoriteReset">通常設定に戻す</button></fieldset><p class="note">エリアボーナスはフィールドごとに保存します。固定フィールドは通常の好物3種を表示します。ワカクサ本島は毎週指定してください。イベントで変わった場合はその週だけ変更できます。EXフィールドの補正は未対応です。</p></div><div class="card psg-field-encounters"><div class="section-title">出現する寝顔・最低ランク</div><p class="note">収録済みの15種のみ表示。未掲載は出現しないという意味ではありません。最低ランクに達しても必要ねむけパワーなどの条件があります。</p><label class="psg-field-rank-label" for="fieldRankFilter">カビゴンのランク <select id="fieldRankFilter"><option value="">すべて表示</option></select></label><div id="fieldRankEnergy" class="note"></div><details class="psg-field-rank-details"><summary>全ランクの必要エナジーを見る</summary><div id="fieldRankThresholdList"></div></details><div id="fieldEncounterCount" class="note"></div><div id="fieldEncounterList"></div></div>
</section>
<section id="dexDetail" class="screen">
<div class="detail-head"><button class="btn" data-back>‹ 戻る</button><h2 style="margin:0;flex:1">ポケモン詳細</h2></div>
<div class="detail-nav"><button id="prevPokemon">‹ 前</button><strong id="detailNoName">—</strong><button id="nextPokemon">後 ›</button></div>
<div id="dexHero" class="hero type-normal">
 <div class="hero-top"><div class="hero-art" id="detailArt">◌</div><div class="hero-info"><h2 id="detailName">—</h2><div class="white-row" id="detailTraits">タイプ / 睡眠タイプ / 得意</div></div></div>
 <div class="stats" style="margin-top:10px">
  <div class="stat"><small>きのみ</small><b id="detailBerry">未確認</b></div>
  <div class="stat"><small>おてつだい時間</small><b id="detailHelp">未確認</b></div>
  <div class="stat"><small>食材確率</small><b id="detailFoodRate">未確認</b></div>
  <div class="stat"><small>スキル確率</small><b id="detailSkillRate">未確認</b></div>
 </div>
</div>
<div class="detail-tabs"><button class="on" data-pane="ability">能力</button><button data-pane="sleep">寝顔</button><button data-pane="field">フィールド</button></div>
<div id="pane-ability" class="detail-pane on">
 <div class="card ability-card">
  <div class="ability-title">🥕 食材 <span class="rate-badge" id="foodRateBadge">食材確率 未確認</span></div>
  <div class="food-table-head"><span></span><span>Lv.1</span><span>Lv.30</span><span>Lv.60</span><span>料理</span></div>
  <div id="detailFoods"><span class="unknown" style="display:block;padding:12px">未確認</span></div>
 </div>
 <div class="card ability-card">
  <div class="ability-title">✨ スキル <span class="rate-badge" id="skillRateBadge">スキル確率 未確認</span></div>
  <div class="skill-box">
   <div class="skill-top"><div class="v26-skill-left"><div class="skill-icon">✦</div><div class="skill-name" id="detailSkill">未確認</div><span class="skill-rate-inline" id="skillRateInline">未確認</span></div><div class="v12-lv" id="v12SkillLv"></div></div>
   <div class="v33-skill-effect-row"><p class="skill-desc" id="detailSkillEffect">効果データはマスターデータ投入後に表示します。</p></div><div class="v47-skill-toggle-row"><button class="skill-detail-toggle" id="skillDetailToggle">詳細を見る ▼</button></div>
   <div class="skill-levels" id="skillLevels"><div class="skill-level-row"><b>Lv.1</b><span>効果データ未確認</span></div></div>
  </div>
 </div>
 <div class="card" id="evolutionCard"><div class="section-title">進化</div><div id="detailEvolution" class="unknown">未確認</div></div>
</div>
<div id="pane-sleep" class="detail-pane"><div class="card"><div class="section-title">寝顔</div><div class="pills"><span class="pill">★1</span><span class="pill">★2</span><span class="pill">★3</span><span class="pill">★4</span></div><p class="unknown">寝顔データ投入後に表示します。</p></div></div>
<div id="pane-field" class="detail-pane"><div class="card"><div class="section-title">フィールド</div><p class="unknown">フィールドデータ投入後に表示します。</p></div></div>
</section>
<section id="boxDetail" class="screen">
 <div class="detail-head"><button class="btn" data-back>‹ 戻る</button><h2><small id="boxHeaderNo"></small><span id="boxTitle">個体詳細</span></h2><span id="boxHeaderMeta" aria-label="現在レベル"></span></div>
 <div class="psg-box-hero card">
  <div class="psg-box-identity"><div class="psg-v106-media"><div id="boxArtwork" class="psg-box-artwork" aria-label="ポケモンの画像"></div></div>
   <div class="psg-box-facts"><div id="boxTraits" class="psg-box-traits"></div><div id="boxStats" class="psg-box-stats"></div></div></div>
  <div class="psg-box-level"><div class="psg-box-level-controls"><button class="btn" id="minus" aria-label="レベルを１下げる">−</button><b id="lv">Lv.1</b><button class="btn" id="plus" aria-label="レベルを１上げる">＋</button></div><input id="lvRange" type="range" min="1" max="70" value="1" aria-label="レベルを選択"></div>
 </div>
 <section class="psg-box-section card"><h3>食材</h3><div id="boxIngredientRows"></div><div class="psg-box-forecast"><b>１日の獲得予想</b><p>計算データ未確認</p></div></section>
 <section class="psg-box-section card"><h3>サブスキル</h3><div id="boxSubskillRows"></div></section>
 <section class="psg-box-section card"><h3>メインスキル</h3><div id="boxMainSkill"></div></section>
 <section class="psg-box-section card"><h3>性格と補正</h3><div id="boxNature"></div></section>
 <section class="psg-box-section card"><h3>個体の評価</h3><div id="boxEvaluation"></div></section>
 <section class="psg-box-section card"><h3>育成・進化</h3><div id="boxGrowth"></div></section>
 <details class="psg-box-editor card" id="boxEditor"><summary>⚙️ 個体を編集</summary>
   <form id="boxEditForm"><label>性格<select name="nature" id="boxEditNature"></select></label>
    <label class="psg-editor-check"><input name="mint" type="checkbox">まっしろミント適用済み</label>
    <label>スキルLv<input name="skillLevel" type="number" min="1" max="7" inputmode="numeric"></label>
    <label>役割<input name="role" maxlength="40" placeholder="例：食材役"></label>
    <div id="boxEditIngredients"></div><div id="boxEditSubskills"></div>
    <button type="submit" class="btn primary">個体データを保存</button><p id="boxEditMessage" role="status"></p>
   </form>
 </details>
 <div class="card"><details><summary><b>… サブメニュー</b></summary><div class="pills" style="margin-top:10px"><button class="btn" type="button" id="boxEditShortcut">⚙️ 個体値設定</button><button class="btn" type="button" id="boxRemoveBtn">削除</button></div></details></div>
</section>
</main>
<nav><button class="active" data-tab="home">⌂<br>ホーム</button><button data-tab="box">▣<br>ボックス</button><button data-tab="dex">▦<br>図鑑</button><button data-tab="info">ⓘ<br>情報</button></nav>

<!-- PSG v57 JS cleanup
  - CSS consolidated in original cascade order (visual behavior preserved)
  - Active controllers intentionally retained until post-cleanup device verification
  - Dex public entry point: window.openDexCard(no)
  - Detail renderer: window.openPokemonDetail(no, opts)
-->
<script id="stable-v2-controller">
(()=>{'use strict';
const state={screen:'home',history:[],box:[],selected:null,selectedDex:null,
filters:{types:new Set(),ingredients:new Set(),specs:new Set()},
boxFilters:{types:new Set(),ingredients:new Set(),specs:new Set(),tags:new Set()}};
/* One source of truth. No Pokémon values are carried over from the unstable builds. */
const master={
 pokemon:[], ingredients:[],
 rules:{version:'stable-v3',verifiedAt:null}
};
const BOX_STORAGE_KEY='psg.box.instances.v1';
const SLEEP_STORAGE_KEY='psg-sleep-discoveries-v1';
const TEAM_STORAGE_KEY='psg.team.primary.v1';
const FIELD_STORAGE_KEY='psg.field.profile.v1';
const boxCatalog=()=>Object.values(window.PS_CATALOG?.pokemon||{}).filter(p=>p.dexVisible);
function normalizeBox(raw){
  if(!Array.isArray(raw))return [];
  const known=new Map(boxCatalog().map(p=>[Number(p.no),p]));
  const seen=new Set();
  return raw.filter(x=>{
    if(!x||typeof x.id!=='string'||! /^[a-zA-Z0-9-]{1,100}$/.test(x.id)||seen.has(x.id)||!known.has(Number(x.no))||!Number.isInteger(x.level)||x.level<1||x.level>100)return false;
    seen.add(x.id);return true;
  })
   .map(x=>({id:x.id,no:Number(x.no),level:Math.min(70,x.level),name:known.get(Number(x.no)).name,
    specialty:known.get(Number(x.no)).specialty,
    ingredients:x.ingredients&&typeof x.ingredients==='object'?x.ingredients:{},
    subskills:Array.isArray(x.subskills)?x.subskills.slice(0,5).map(s=>String(s||'').slice(0,80)):[],
    nature:String(x.nature||'').slice(0,40),mint:x.mint===true,
    skillLevel:Number.isInteger(x.skillLevel)?Math.max(1,Math.min(7,x.skillLevel)):1,
    role:String(x.role||'').slice(0,40),favorite:x.favorite===true,training:x.training===true}));
}
function readBox(){
 try{return normalizeBox(JSON.parse(localStorage.getItem(BOX_STORAGE_KEY)||'[]'))}
 catch{return []}
}
function commitBox(next){
 try{
  localStorage.setItem(BOX_STORAGE_KEY,JSON.stringify(next.map(({id,no,level,ingredients,subskills,nature,mint,skillLevel,role,favorite,training})=>
   ({id,no,level,ingredients,subskills,nature,mint,skillLevel,role,favorite,training}))));
  state.box=next;
  renderBox();
  return true;
 }catch{alert('保存できませんでした。ブラウザーの保存設定を確認してください。');return false}
}
state.box=readBox();
function normalizeTeam(raw,box){
 const byId=new Map(box.map(x=>[x.id,x])),seen=new Set();let hasSpecial=false;
 return Array.from({length:5},(_,i)=>{
  const id=Array.isArray(raw)?raw[i]:null;
  if(typeof id!=='string'||!byId.has(id)||seen.has(id))return null;
  const special=window.PS_CATALOG?.pokemon?.[byId.get(id).no]?.specialTeamLimited===true;
  if(special&&hasSpecial)return null;
  if(special)hasSpecial=true;
  seen.add(id);return id;
 });
}
function readTeam(){
 try{return normalizeTeam(JSON.parse(localStorage.getItem(TEAM_STORAGE_KEY)||'[]'),state.box)}catch{return [null,null,null,null,null]}
}
let team=readTeam();
// Team composition for skill-specific rules. IDs are individual records;
// species/type/skill grouping is computed only when an effect asks for it.
function teamContext(){
 const members=team.map((id,slot)=>{
  const individual=state.box.find(x=>x.id===id);
  const species=individual&&window.PS_CATALOG?.pokemon[individual.no];
  return species?{slot,instanceId:individual.id,speciesNo:Number(species.no),type:species.type,mainSkillId:species.mainSkillId}:null;
 }).filter(Boolean);
 const speciesCounts={},skillCounts={},speciesByType={};
 members.forEach(member=>{
  speciesCounts[member.speciesNo]=(speciesCounts[member.speciesNo]||0)+1;
  if(member.mainSkillId)skillCounts[member.mainSkillId]=(skillCounts[member.mainSkillId]||0)+1;
  (speciesByType[member.type]??=new Set()).add(member.speciesNo);
 });
 return {members,speciesCounts,skillCounts,distinctSpeciesByType:Object.fromEntries(Object.entries(speciesByType).map(([type,ids])=>[type,ids.size]))};
}
function teamFoodContext(ids=team,box=state.box,catalog=window.PS_CATALOG){
 const confirmed=new Map(),unconfirmed=[];
 ids.forEach((id,position)=>{
  const individual=box.find(x=>x.id===id);
  if(!individual)return;
  const species=catalog?.pokemon?.[individual.no];
  const label=`${position+1}匹目 ${individual.name} Lv.${individual.level}`;
  if(!species?.ingredientSlots?.length){unconfirmed.push(`${label}：食材データ未確認`);return}
  species.ingredientSlots.filter(slot=>slot.unlock<=individual.level).forEach(slot=>{
   const candidates=slot.candidates||[];
   const chosen=individual.ingredients?.[slot.unlock];
   const candidate=candidates.length===1?candidates[0]:candidates.find(item=>item.name===chosen);
   if(!candidate){unconfirmed.push(`${label}：Lv.${slot.unlock}の食材未確認`);return}
   const providers=confirmed.get(candidate.name)||[];
   providers.push({id:individual.id,label,unlock:slot.unlock,qty:candidate.qty});
   confirmed.set(candidate.name,providers);
  });
 });
 return {confirmed,unconfirmed};
}
function teamFoodIcon(name){
 const img=document.createElement('img');
 const visual=window.PS_CATALOG?.ingredientVisual?.(name);
 const src=visual?.image||window.PS_INGREDIENT_FALLBACK_ICON?.(name);
 if(src){img.src=src;img.alt='';return img}
 const fallback=document.createElement('span');fallback.textContent=visual?.fallback||'◌';return fallback;
}
function renderTeamFood(){
 const ingredients=document.getElementById('teamIngredientList'),recipes=document.getElementById('teamRecipeList');
 if(!ingredients||!recipes)return;
 const openCategories=new Set([...recipes.querySelectorAll('.psg-team-recipe-group[open]')].map(node=>node.dataset.category));
 ingredients.replaceChildren();recipes.replaceChildren();
 const {confirmed,unconfirmed}=teamFoodContext();
 if(!team.some(Boolean)){
  const empty=document.createElement('p');empty.className='note';empty.textContent='チームを選ぶと、拾える食材を表示します。';ingredients.append(empty);
 }else{
  if(confirmed.size){
   const list=document.createElement('div');list.className='psg-team-food-list';
   for(const [name,providers] of confirmed){
    const chip=document.createElement('div');chip.className='psg-team-food-item';chip.append(teamFoodIcon(name));
    const words=document.createElement('span');const title=document.createElement('strong');title.textContent=name;
    const detail=document.createElement('small');detail.textContent=providers.map(x=>`${x.label}（Lv.${x.unlock} ×${x.qty}）`).join('、');
    words.append(title,detail);chip.append(words);list.append(chip);
   }ingredients.append(list);
  }else{const empty=document.createElement('p');empty.className='note';empty.textContent='確認できた食材はありません。';ingredients.append(empty)}
  if(unconfirmed.length){const note=document.createElement('p');note.className='note';note.textContent=`未確認：${unconfirmed.join('、')}`;ingredients.append(note)}
 }
 const catalogRecipes=Object.values(window.PS_CATALOG?.recipes||{});
 for(const category of ['カレー・シチュー','サラダ','デザート・ドリンク']){
  const categoryRecipes=catalogRecipes.filter(r=>r.category===category).sort((a,b)=>(b.energy?.max?.value||0)-(a.energy?.max?.value||0));
  if(!categoryRecipes.length)continue;
  const group=document.createElement('details');group.className='psg-team-recipe-group';group.dataset.category=category;
  group.open=openCategories.has(category);
  const heading=document.createElement('summary');heading.className='psg-team-recipe-group-title';
  const title=document.createElement('strong');title.textContent=category;
  const count=document.createElement('small');
  const covered=categoryRecipes.filter(r=>r.ingredients.every(item=>confirmed.has(item.name))).length;
  count.textContent=team.some(Boolean)?`食材の種類 ${covered}/${categoryRecipes.length}品`:`${categoryRecipes.length}品`;
  heading.append(title,count);group.append(heading);
  const list=document.createElement('div');list.className='psg-team-recipe-items';
  for(const recipe of categoryRecipes){
   const missing=recipe.ingredients.filter(item=>!confirmed.has(item.name));
   const row=document.createElement('button');row.type='button';row.className='psg-team-recipe-row';
   const name=document.createElement('strong');name.textContent=recipe.name;
   const meta=document.createElement('span');meta.className='psg-team-recipe-meta';meta.textContent=`Lv.${recipe.energy?.max?.level||'?'} ${Number(recipe.energy?.max?.value||0).toLocaleString()} エナジー`;
   const status=document.createElement('span');status.className=`psg-team-recipe-status ${missing.length?'is-unconfirmed':'is-covered'}`;
   status.textContent=!team.some(Boolean)?'チーム未設定':missing.length?`未確認：${missing.map(item=>item.name).join('・')}`:'食材の種類が揃う';
   row.append(name,meta,status);
   row.setAttribute('aria-label',`${recipe.name}、${status.textContent}、料理の詳細へ`);
   row.onclick=()=>window.PS_OPEN_RECIPE?.(recipe.id);
   list.append(row);
  }
  group.append(list);recipes.append(group);
 }
}
let teamBoxSlot=null;
let teamReorderMode=false,teamReorderFrom=null;
function saveTeamSelection(next){
 try{team=normalizeTeam(next,state.box);localStorage.setItem(TEAM_STORAGE_KEY,JSON.stringify(team));teamReorderFrom=null;renderTeam()}
 catch{document.getElementById('teamSummary').textContent='チームを保存できませんでした。端末の設定を確認してください。'}
}
function teamFace(individual){
 const art=document.createElement('span');art.className='psg-team-face';
 if(!individual){art.textContent='＋';return art}
 if(window.PS_FACE_ART?.usesSheet(individual.no)){art.append(window.PS_FACE_ART.element(individual.no,''));return art}
 const species=window.PS_CATALOG?.pokemon[individual.no];
 const src=window.PS_IMAGE_FILES.pokemonFaces?.[individual.no]||species?.faceImage||species?.image;
 if(!src){art.textContent='No image';return art}
 const img=document.createElement('img');img.src=src;img.alt='';img.onerror=()=>{img.remove();art.textContent='No image'};
 art.append(img);return art;
}
function subskillCardBadges(individual){
 return `<span class="psg-subskill-card-grid" aria-label="サブスキル">${SUBSKILL_LEVELS.map((unlock,i)=>{
  const name=individual?.subskills?.[i],src=window.PS_IMAGE_FILES.subskills?.[name];
  return `<span class="psg-box-mini-badge ${name?'':'is-unknown'} ${individual?.level<unlock?'is-locked':''}" title="Lv.${unlock}：${boxEsc(name||'未確認')}" aria-label="Lv.${unlock} ${boxEsc(name||'未確認')}">${src?`<img src="${src}" alt="">`:`<span>${name?'・':'?'}</span>`}</span>`;
 }).join('')}</span>`;
}
function renderTeam(){
 const panel=document.getElementById('teamSlots');panel.replaceChildren();
 team=normalizeTeam(team,state.box);
 const reorder=document.getElementById('teamReorder'),hint=document.getElementById('teamHint');
 reorder.disabled=team.filter(Boolean).length<2;
 if(reorder.disabled)teamReorderMode=false;
 reorder.textContent=teamReorderMode?'並び替えを終了':'並び替え';
 reorder.setAttribute('aria-pressed',String(teamReorderMode));
 hint.hidden=!teamReorderMode;
 hint.textContent=teamReorderFrom===null?'移動する個体を選び、移動先の枠をタップしてください。':`${teamReorderFrom+1}匹目を選択中。移動先の枠をタップしてください。`;
 const teamSpeeds=teamSpeedContext();
 team.forEach((id,index)=>{
  const individual=state.box.find(x=>x.id===id),boxPosition=state.box.findIndex(x=>x.id===id)+1;
  const row=document.createElement('div');row.className='psg-team-row';
  if(teamReorderMode)row.classList.add('is-reordering');
  if(teamReorderFrom===index)row.classList.add('is-reorder-source');
  const choose=document.createElement('button');choose.type='button';choose.className='psg-team-choose';
  if(individual)choose.classList.add(`type-${typeClass(window.PS_CATALOG?.pokemon?.[individual.no]?.type)}`);
  choose.setAttribute('aria-label',`${index+1}匹目：${individual?individual.name:'未設定'}。${teamReorderMode?'並び替える枠を選ぶ':'Boxで個体を選ぶ'}`);
  const name=document.createElement('strong');name.className='psg-team-card-name';name.textContent=individual?.name||'個体を選ぶ';choose.append(name);
  const artwork=document.createElement('span');artwork.className='psg-team-card-art';artwork.append(teamFace(individual));
  if(individual){const level=document.createElement('span');level.className='psg-team-card-level';level.textContent=`Lv.${individual.level}`;artwork.append(level)}
  choose.append(artwork);
  const identity=document.createElement('span');identity.className='psg-team-identity';
  const detail=document.createElement('small');detail.textContent=individual?`Box ${boxPosition}番`:'未設定';
  identity.append(detail);
  if(individual){
   const speed=document.createElement('small');speed.className='psg-team-speed';
   const corrected=teamSpeeds.members.get(individual.id);
   speed.textContent=corrected?.speed==null?'チームのおてつだい時間：未確認':`チーム：${corrected.speed.toLocaleString()}秒${corrected.speed!==corrected.soloSpeed&&corrected.soloSpeed!=null?`（単体 ${corrected.soloSpeed.toLocaleString()}秒）`:''}`;
   identity.append(speed);
  }
  choose.append(identity);
  if(individual)choose.insertAdjacentHTML('beforeend',subskillCardBadges(individual));
  const arrow=document.createElement('span');arrow.className='psg-team-choose-arrow';arrow.textContent=teamReorderMode?(teamReorderFrom===index?'選択中':'移動先'):'Boxで選ぶ';choose.append(arrow);
  choose.onclick=()=>{
   if(teamReorderMode){
    if(teamReorderFrom===null){if(!id)return;teamReorderFrom=index;renderTeam();return}
    if(teamReorderFrom===index){teamReorderFrom=null;renderTeam();return}
    const next=[...team];[next[index],next[teamReorderFrom]]=[next[teamReorderFrom],next[index]];saveTeamSelection(next);return;
   }
   teamBoxSlot=index;renderBoxTeamMode();renderBox();go('box');
  };
  const number=document.createElement('span');number.className='psg-team-number';number.textContent=String(index+1);
  row.append(number,choose);panel.append(row);
 });
 const selected=team.map(id=>state.box.find(x=>x.id===id)).filter(Boolean);
 const summary=document.getElementById('teamSummary');
 summary.textContent=state.box.length?`${selected.length} / 5匹を登録中${selected.length?`・得意：${[...new Set(selected.map(x=>x.specialty))].join('、')}`:''}${teamSpeeds.bonusCount?`・おてつだいボーナス ${teamSpeeds.bonusCount}匹（計${Math.round(teamSpeeds.bonus*100)}%短縮、個体ごと上限35%）`:''}`:'ボックスに個体を登録すると、ここでチームを組めます。';
 renderTeamFood();
 renderTeamDay();
 renderTeamFaceDock();
}
function renderTeamFaceDock(){
 const dock=document.getElementById('teamFaceDock');dock.replaceChildren();
 team.forEach((id,index)=>{
  const individual=state.box.find(item=>item.id===id);
  const cell=document.createElement('button');cell.type='button';cell.className='psg-team-face-dock-cell';
  cell.setAttribute('aria-label',`${index+1}匹目：${individual?.name||'未設定'}。チームへ戻る`);
  cell.append(teamFace(individual));cell.onclick=()=>document.querySelector('#home .psg-team-card').scrollIntoView({behavior:'smooth',block:'start'});
  dock.append(cell);
 });
 updateTeamFaceDock();
}
function updateTeamFaceDock(){
 const dock=document.getElementById('teamFaceDock');
 const teamCard=document.querySelector('#home .psg-team-card');
 dock.hidden=!document.getElementById('home').classList.contains('active')||teamCard.getBoundingClientRect().bottom>document.querySelector('.psg-app-header').getBoundingClientRect().bottom+8;
}
window.addEventListener('scroll',updateTeamFaceDock,{passive:true});
window.addEventListener('resize',updateTeamFaceDock,{passive:true});
document.getElementById('teamReorder').onclick=()=>{teamReorderMode=!teamReorderMode;teamReorderFrom=null;renderTeam()};
const backupBoxFields=({id,no,level,ingredients,subskills,nature,mint,skillLevel,role,favorite,training})=>({id,no,level,ingredients,subskills,nature,mint,skillLevel,role,favorite,training});
const knownSleepIds=new Set(Object.values(window.PS_CATALOG?.sleepStyles||{}).flat().map(s=>s.id));
function normalizeSleepFound(raw){
 if(!raw||typeof raw!=='object'||Array.isArray(raw))return {};
 return Object.fromEntries(Object.entries(raw).filter(([id,found])=>knownSleepIds.has(id)&&found===true));
}
function readSleepBackup(){
 try{return normalizeSleepFound(JSON.parse(localStorage.getItem(SLEEP_STORAGE_KEY)||'{}'))}
 catch{return {}}
}
const knownFieldIds=new Set(Object.keys(window.PS_CATALOG?.fields||{}));
const knownBerryNames=new Set(window.PS_CATALOG?.berryNames||Object.keys(window.PS_CATALOG?.berries||{}));
// Use the device's local week, beginning Monday at 04:00.
function currentFieldWeek(now=new Date()){
 const date=new Date(now.getTime()-4*60*60*1000);
 date.setDate(date.getDate()-((date.getDay()+6)%7));
 return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
}
function normalizeFieldProfile(raw){
 const selectedFieldId=knownFieldIds.has(raw?.selectedFieldId)?raw.selectedFieldId:(knownFieldIds.has('greengrass')?'greengrass':[...knownFieldIds][0]||'');
 const areaBonuses={};
 for(const [id,value] of Object.entries(raw?.areaBonuses||{})){
  if(knownFieldIds.has(id)&&Number.isFinite(Number(value)))areaBonuses[id]=Math.max(0,Math.min(200,Number(value)));
 }
 const weekly={};
 for(const [id,entry] of Object.entries(raw?.weekly||{})){
  if(knownFieldIds.has(id)&&typeof entry?.weekKey==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(entry.weekKey)&&Array.isArray(entry.berries)){
   weekly[id]={weekKey:entry.weekKey,berries:entry.berries.slice(0,3).map(name=>knownBerryNames.has(name)?name:'')};
  }
 }
 return {selectedFieldId,areaBonuses,weekly};
}
function readFieldProfile(){
 try{return normalizeFieldProfile(JSON.parse(localStorage.getItem(FIELD_STORAGE_KEY)||'{}'))}
 catch{return normalizeFieldProfile({})}
}
let fieldProfile=readFieldProfile();
function saveFieldProfile(){
 try{localStorage.setItem(FIELD_STORAGE_KEY,JSON.stringify(fieldProfile));renderFieldControls();renderTeamDay();return true}
 catch{fieldProfile=readFieldProfile();renderFieldControls();alert('フィールド設定を保存できませんでした。');return false}
}
const backupFile=document.getElementById('backupFile');
const backupPreview=document.getElementById('backupPreview');
const backupImport=document.getElementById('backupImport');
let pendingBackup=null;
document.getElementById('backupExport').onclick=()=>{
 try{
  const payload={format:'psg-user-data',version:3,exportedAt:new Date().toISOString(),box:state.box.map(backupBoxFields),sleepFound:readSleepBackup(),team:normalizeTeam(team,state.box),fields:normalizeFieldProfile(fieldProfile)};
  const url=URL.createObjectURL(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}));
  const link=document.createElement('a');link.href=url;link.download=`PSG_backup_${new Date().toISOString().slice(0,10)}.json`;
  document.body.append(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),60000);
  backupPreview.textContent=`ボックス ${payload.box.length}件・寝顔 ${Object.keys(payload.sleepFound).length}件を書き出しました。`;
 }catch{backupPreview.textContent='書き出せませんでした。端末の設定を確認してください。'}
};
backupFile.onchange=async()=>{
 pendingBackup=null;backupImport.hidden=true;
 const file=backupFile.files?.[0];if(!file){backupPreview.textContent='ファイルを選ぶと内容を確認できます。';return}
 if(file.size>5*1024*1024){backupPreview.textContent='ファイルが大きすぎます（上限5MB）。';return}
 try{
  const parsed=JSON.parse(await file.text());
  if(parsed?.format!=='psg-user-data'||![1,2,3].includes(parsed.version)||!Array.isArray(parsed.box)||!parsed.sleepFound||typeof parsed.sleepFound!=='object'||Array.isArray(parsed.sleepFound)||parsed.version>=2&&!Array.isArray(parsed.team)||parsed.version===3&&(!parsed.fields||typeof parsed.fields!=='object'||Array.isArray(parsed.fields)))throw Error('形式');
  const box=normalizeBox(parsed.box),sleepFound=normalizeSleepFound(parsed.sleepFound);
  const importedTeam=normalizeTeam(parsed.team,box);
  if(parsed.box.length>0&&box.length===0)throw Error('ポケモンのデータが一致しません');
  const skipped=parsed.box.length-box.length+Object.keys(parsed.sleepFound).length-Object.keys(sleepFound).length;
  pendingBackup={box,sleepFound,team:importedTeam,fields:parsed.version===3?normalizeFieldProfile(parsed.fields):null};
  backupPreview.textContent=`ボックス ${box.length}件・チーム ${importedTeam.filter(Boolean).length}匹・寝顔 ${Object.keys(sleepFound).length}件を確認しました。${skipped?`未対応の記録 ${skipped}件を除外します。`:''}復元すると現在の記録を置き換えます。`;
  backupImport.hidden=false;
 }catch{backupPreview.textContent='読み込めませんでした。PokéSleep GuideのバックアップJSONを選んでください。'}
};
backupImport.onclick=()=>{
 if(!pendingBackup)return;
 if(!confirm(`現在のボックス ${state.box.length}件・寝顔 ${Object.keys(readSleepBackup()).length}件を、選択したバックアップに置き換えます。復元しますか？`))return;
 const oldBox=localStorage.getItem(BOX_STORAGE_KEY),oldSleep=localStorage.getItem(SLEEP_STORAGE_KEY),oldTeam=localStorage.getItem(TEAM_STORAGE_KEY),oldFields=localStorage.getItem(FIELD_STORAGE_KEY);
 try{
  localStorage.setItem(BOX_STORAGE_KEY,JSON.stringify(pendingBackup.box.map(backupBoxFields)));
  localStorage.setItem(SLEEP_STORAGE_KEY,JSON.stringify(pendingBackup.sleepFound));
  localStorage.setItem(TEAM_STORAGE_KEY,JSON.stringify(pendingBackup.team));
  if(pendingBackup.fields)localStorage.setItem(FIELD_STORAGE_KEY,JSON.stringify(pendingBackup.fields));
  fieldProfile=readFieldProfile();renderFieldControls();
  state.box=readBox();team=readTeam();renderBox();renderTeam();
  window.PSG_REFRESH_SLEEP_FOUND?.();
  backupPreview.textContent=`復元しました。ボックス ${state.box.length}件・寝顔 ${Object.keys(pendingBackup.sleepFound).length}件。`;
  pendingBackup=null;backupImport.hidden=true;backupFile.value='';
 }catch{
  try{
   if(oldBox===null)localStorage.removeItem(BOX_STORAGE_KEY);else localStorage.setItem(BOX_STORAGE_KEY,oldBox);
   if(oldSleep===null)localStorage.removeItem(SLEEP_STORAGE_KEY);else localStorage.setItem(SLEEP_STORAGE_KEY,oldSleep);
   if(oldTeam===null)localStorage.removeItem(TEAM_STORAGE_KEY);else localStorage.setItem(TEAM_STORAGE_KEY,oldTeam);
   if(oldFields===null)localStorage.removeItem(FIELD_STORAGE_KEY);else localStorage.setItem(FIELD_STORAGE_KEY,oldFields);
  }catch{}
  fieldProfile=readFieldProfile();renderFieldControls();state.box=readBox();backupPreview.textContent='復元できませんでした。端末の保存設定を確認してください。';
 }
};
/* Individual records may later contain:
 favorite:boolean, training:boolean,
 shiny:'confirmed'|'not_shiny'|'unknown'.
 Shiny is not exposed as a freely editable tag. */
const screens=[...document.querySelectorAll('.screen')],tabs=[...document.querySelectorAll('nav button')];

function go(id,push=true){
 if(push&&state.screen!==id)state.history.push(state.screen);
 state.screen=id;
 if(id==='fieldPage')renderFieldControls();
 screens.forEach(s=>s.classList.toggle('active',s.id===id));
 const activeTab=['recipePage','skillPage','fieldPage'].includes(id)?'info':id;
 tabs.forEach(b=>b.classList.toggle('active',b.dataset.tab===activeTab));
 window.scrollTo(0,0);
 requestAnimationFrame(updateTeamFaceDock);
}
tabs.forEach(b=>b.onclick=()=>{state.history=[];go(b.dataset.tab,false)});
document.querySelectorAll('[data-back]').forEach(b=>b.onclick=()=>go(state.history.pop()||'home',false));
document.querySelectorAll('[data-info-page]').forEach(b=>b.onclick=()=>go(b.dataset.infoPage));

const typeClass=t=>({'くさ':'grass','ほのお':'fire','みず':'water','でんき':'electric','むし':'bug','ノーマル':'normal','どく':'poison','じめん':'ground','ひこう':'flying','ゴースト':'ghost','エスパー':'psychic','こおり':'ice','はがね':'steel','かくとう':'fighting','いわ':'rock','あく':'dark','ドラゴン':'dragon','フェアリー':'fairy'}[t]||'normal');
const typeSymbol=t=>({'くさ':'草','ほのお':'炎','むし':'虫','みず':'水','でんき':'電','どく':'毒','ノーマル':'普'}[t]||t);
// Small original SVG previews; actual ingredient WebP files take priority when added.
