 ,'おいしいシッポ':`<path d="M16 48c0-13 9-31 27-36 5-1 9 4 7 9-4 10-13 16-23 21-3 2-4 6-4 11z" fill="#eaa897" stroke="#a86666" stroke-width="3"/><path d="M21 43c8-13 18-20 28-23" fill="none" stroke="#f8d1b8" stroke-width="3"/>`
 ,'ふといながねぎ':`<path d="M28 55c0-17 1-27 3-38l8 1c-2 15-2 27-3 37z" fill="#f1f2d5" stroke="#8a9e70" stroke-width="2"/><path d="M30 25C19 20 14 13 12 6c13 2 20 10 23 19M35 24c4-11 11-16 20-18-2 10-8 18-19 24" fill="#71b979" stroke="#43895d" stroke-width="2"/>`
};
const filterIconData=name=>filterIconShapes[name]?`data:image/svg+xml;charset=utf-8,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="30" fill="#faf8ee"/>${filterIconShapes[name]}</svg>`)}`:null;
window.PS_INGREDIENT_FALLBACK_ICON=filterIconData;
const typeFilterArt=t=>window.PS_TYPE_IMAGES?.[t]?`<img src="${window.PS_TYPE_IMAGES[t]}" alt="">`:filterIconData(t)?`<img src="${filterIconData(t)}" alt="">`:`<span class="filter-pictogram" aria-hidden="true">${typeSymbol(t)}</span>`;
window.PS_TYPE_ART=typeFilterArt;
const ingredientFilterArt=name=>{
 const visual=ingredientVisual(name);
 if(visual?.image)return window.PS_DEV_ASSETS.image(visual.image,'ingredient',name,'full','');
 return filterIconData(name)?`<img src="${filterIconData(name)}" alt="">`:'';
};
const filterCaption=name=>`<span class="filter-caption">${name}</span>`;
const specialtyIconPaths={'きのみ':'berry_pixel.png','食材':'ingredient_pixel.png','スキル':'skill_pixel.png','オール':'all_pixel.png'};
const hydrateSpecialtyIcons=root=>root.querySelectorAll('[data-specialty-icon]').forEach(img=>{img.src=window.PS_SPECIALTY_IMAGES[img.dataset.specialtyIcon]||''});
const specIcon=s=>specialtyIconPaths[s]?`<img class="psg-specialty-icon" data-specialty-icon="${specialtyIconPaths[s].replace('_pixel.png','')}" alt="${s}">`:'◌';
const ingredientVisual=name=>window.PS_CATALOG?.ingredientVisual(name);
const ingIcon=ingredient=>{const name=ingredient?.name,visual=ingredientVisual(name);return !name?'◌':visual?.image?window.PS_DEV_ASSETS.image(visual.image,'ingredient',name,'full',name):'<small class="psg-mini-missing" aria-label="No image">No<br>image</small>'};
const searchKey=text=>String(text||'').normalize('NFKC').replace(/[ァ-ヶ]/g,c=>String.fromCharCode(c.charCodeAt(0)-96)).toLowerCase();
function matchesDexFilters(p,q,filters){
 return (!q||searchKey(p.name).includes(q))
   &&(!filters.types.size||filters.types.has(p.type))
   &&(!filters.ingredients.size||p.ingredients?.some(x=>filters.ingredients.has(x.name)))
   &&(!filters.specs.size||filters.specs.has(p.specialty));
}
function discoveryLabel(p){
 const found=p.sleepFound,total=p.sleepTotal;
 return Number.isInteger(found)&&Number.isInteger(total)&&total>0&&found===total?'🌕':
  Number.isInteger(found)&&Number.isInteger(total)&&total>0?`${found}/${total}`:'—/—';
}

function renderFilters(){
 const types=[...new Set(master.pokemon.map(p=>p.type).filter(Boolean))];
 const ingredients=[...new Set(master.pokemon.flatMap(p=>(p.ingredients||[]).map(x=>x.name)).filter(Boolean))];
  typeFilters.innerHTML=types.length?types.map(t=>`<button class="filter-option type-${typeClass(t)}${state.filters.types.has(t)?' on':''}" data-type="${t}" aria-label="${t}">${typeFilterArt(t)}${filterCaption(t)}</button>`).join(''):'<button class="filter-option" disabled>データ投入後に生成</button>';
  ingredientFilters.innerHTML=ingredients.length?ingredients.map(name=>`<button class="filter-option${state.filters.ingredients.has(name)?' on':''}" data-ingredient="${name}" aria-label="${name}" title="${name}">${ingredientFilterArt(name)}${filterCaption(name)}</button>`).join(''):'<button class="filter-option" disabled>データ投入後に生成</button>';
  const boxTypes=document.getElementById('boxTypeFilters');
  const boxIngredients=document.getElementById('boxIngredientFilters');
  boxTypes.innerHTML=types.length?types.map(t=>`<button class="filter-option type-${typeClass(t)}${state.boxFilters.types.has(t)?' on':''}" data-type="${t}" aria-label="${t}">${typeFilterArt(t)}${filterCaption(t)}</button>`).join(''):'<button class="filter-option" disabled>データ投入後に生成</button>';
  boxIngredients.innerHTML=ingredients.length?ingredients.map(name=>`<button class="filter-option${state.boxFilters.ingredients.has(name)?' on':''}" data-ingredient="${name}" aria-label="${name}" title="${name}">${ingredientFilterArt(name)}${filterCaption(name)}</button>`).join(''):'<button class="filter-option" disabled>データ投入後に生成</button>';
  typeFilters.querySelectorAll('[data-type]').forEach(b=>b.onclick=e=>{e.stopPropagation();b.classList.toggle('on');state.filters.types.has(b.dataset.type)?state.filters.types.delete(b.dataset.type):state.filters.types.add(b.dataset.type);renderDex()});
  ingredientFilters.querySelectorAll('[data-ingredient]').forEach(b=>b.onclick=e=>{e.stopPropagation();b.classList.toggle('on');state.filters.ingredients.has(b.dataset.ingredient)?state.filters.ingredients.delete(b.dataset.ingredient):state.filters.ingredients.add(b.dataset.ingredient);renderDex()});
  boxTypes.querySelectorAll('[data-type]').forEach(b=>b.onclick=e=>{e.stopPropagation();b.classList.toggle('on');state.boxFilters.types.has(b.dataset.type)?state.boxFilters.types.delete(b.dataset.type):state.boxFilters.types.add(b.dataset.type);renderBox()});
  boxIngredients.querySelectorAll('[data-ingredient]').forEach(b=>b.onclick=e=>{e.stopPropagation();b.classList.toggle('on');state.boxFilters.ingredients.has(b.dataset.ingredient)?state.boxFilters.ingredients.delete(b.dataset.ingredient):state.boxFilters.ingredients.add(b.dataset.ingredient);renderBox()});
 specialtyFilters.querySelectorAll('[data-spec]').forEach(b=>b.onclick=()=>{b.classList.toggle('active');state.filters.specs.has(b.dataset.spec)?state.filters.specs.delete(b.dataset.spec):state.filters.specs.add(b.dataset.spec);renderDex()});
}
function setupMenus(){
 document.querySelectorAll('.filter-select>.filter-main').forEach(btn=>btn.onclick=e=>{
   e.stopPropagation();const host=btn.parentElement,was=host.classList.contains('open');
   document.querySelectorAll('.filter-select.open').forEach(x=>x.classList.remove('open'));
   if(!was)host.classList.add('open');
 });
 document.querySelectorAll('.filter-panel').forEach(p=>p.onclick=e=>e.stopPropagation());
 document.addEventListener('click',()=>document.querySelectorAll('.filter-select.open').forEach(x=>x.classList.remove('open')));
 document.querySelectorAll('#boxSpecialtyFilters [data-spec]').forEach(b=>b.onclick=()=>{const v=b.dataset.spec;b.classList.toggle('on');state.boxFilters.specs.has(v)?state.boxFilters.specs.delete(v):state.boxFilters.specs.add(v);renderBox()});
 document.querySelectorAll('#boxTagFilters [data-tag]').forEach(b=>b.onclick=()=>{b.classList.toggle('on');const v=b.dataset.tag;state.boxFilters.tags.has(v)?state.boxFilters.tags.delete(v):state.boxFilters.tags.add(v);renderBox()});
}
function renderDex(){
 const q=searchKey(dexSearch.value.trim());
 const all=master.pokemon;
 const a=all.filter(p=>matchesDexFilters(p,q,state.filters));
 document.querySelector('[data-menu="dex-type"]>.filter-main')?.classList.toggle('active',state.filters.types.size>0);
 document.querySelector('[data-menu="dex-ing"]>.filter-main')?.classList.toggle('active',state.filters.ingredients.size>0);
 dexCount.textContent=`${a.length} / ${all.length}`;
 dexGrid.innerHTML=a.map(p=>`<article class="poke dex-card type-${typeClass(p.type)}" data-no="${p.no}" role="button" tabindex="0" aria-label="No.${String(p.no).padStart(3,'0')} ${p.name}の詳細を見る">
   <div class="dex-heading"><div class="dex-identity"><span class="dex-no">No.${String(p.no).padStart(3,'0')}</span><span class="dex-name">${p.name}</span></div><span class="dex-discovery" aria-label="寝顔発見数 ${discoveryLabel(p)}">${discoveryLabel(p)}</span></div>
   <div class="dex-art">${window.PS_DEV_ASSETS.image(p.faceImage||p.image,'pokemon',p.no,'face',p.name)}</div><div class="dex-bottom"><span title="得意: ${p.specialty||'未確認'}">${specIcon(p.specialty)}</span>${[0,1,2].map(i=>`<span title="食材${['A','B','C'][i]}: ${p.ingredients?.[i]?.name||'未確認'}">${ingIcon(p.ingredients?.[i])}</span>`).join('')}</div>
  </article>`).join('');
 hydrateSpecialtyIcons(dexGrid);
 dexEmpty.style.display=a.length?'none':'block';
 dexGrid.querySelectorAll('[data-no]').forEach(c=>{
   c.onclick=()=>{if(Date.now()<(window.PS?.ignoreCardClicksUntil||0))return;window.openDexCard?.(+c.dataset.no)};
   c.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();c.click()}};
 });
}
function val(v,suffix=''){return v===null||v===undefined?'未確認':`${v}${suffix}`}
// v57 cleanup: legacy openDex renderer removed; Dex cards use window.openDexCard -> window.openPokemonDetail.
document.querySelectorAll('.detail-tabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.detail-tabs button').forEach(x=>x.classList.toggle('on',x===b));document.querySelectorAll('.detail-pane').forEach(x=>x.classList.toggle('on',x.id==='pane-'+b.dataset.pane))});

function renderBox(){
 const q=searchKey(boxSearch.value.trim()),a=state.box.filter(x=>{
 const text=!q||searchKey(x.name).includes(q);
  const species=window.PS_CATALOG?.pokemon[x.no];
  const type=!state.boxFilters.types.size||state.boxFilters.types.has(species?.type);
  const ingredient=!state.boxFilters.ingredients.size||species?.ingredients?.some(item=>state.boxFilters.ingredients.has(item.name));
 const spec=!state.boxFilters.specs.size||state.boxFilters.specs.has(x.specialty);
 const tags=!state.boxFilters.tags.size||[...state.boxFilters.tags].every(t=>
   t==='favorite'?!!x.favorite:t==='training'?!!x.training:t==='special'?!!x.specialTeamLimited:t==='shiny'?x.shiny==='confirmed':true);
  return text&&type&&ingredient&&spec&&tags;
 });
  document.querySelector('[data-menu="box-type"]>.filter-main')?.classList.toggle('active',state.boxFilters.types.size>0);
  document.querySelector('[data-menu="box-ing"]>.filter-main')?.classList.toggle('active',state.boxFilters.ingredients.size>0);
 boxGrid.innerHTML=a.map(x=>{
  const species=window.PS_CATALOG?.pokemon[x.no];
  const foods=[1,30,60].map((unlock,i)=>{
   const slot=species?.ingredientSlots?.find(s=>s.unlock===unlock);
   const chosen=x.ingredients?.[unlock]||((slot?.candidates?.length===1)?slot.candidates[0].name:'');
   const visual=chosen&&ingredientVisual(chosen);
   const icon=visual?.image?window.PS_DEV_ASSETS.image(visual.image,'ingredient',chosen,'full',chosen):'';
   return `<span class="psg-box-mini-badge ${chosen?'':'is-unknown'}" title="${['A','B','C'][i]} Lv.${unlock}：${boxEsc(chosen||'未確認')}" aria-label="${['A','B','C'][i]} ${boxEsc(chosen||'未確認')}"><em>${['A','B','C'][i]}</em>${icon||'<span>?</span>'}</span>`;
  }).join('');
  return `<button type="button" class="poke psg-box-card type-${typeClass(species?.type)}" data-id="${boxEsc(x.id)}" aria-label="${boxEsc(x.name)} Lv.${x.level}、食材とサブスキルの構成を見る"><span class="psg-box-card-copy"><b>${boxEsc(x.name)}</b></span><span class="psg-box-card-art">${window.PS_DEV_ASSETS.image(species?.faceImage,'pokemon',x.no,'face',x.name)||'<small>No image</small>'}<span class="psg-box-card-level">Lv.${x.level}</span></span><span class="psg-box-mini-row" aria-label="食材構成">${foods}</span>${subskillCardBadges(x)}</button>`;
 }).join('');
 boxEmpty.textContent=state.box.length?'条件に合う個体がありません。':'Boxは空です。「＋追加」から登録できます。';
 boxEmpty.style.display=a.length?'none':'block';
 boxGrid.querySelectorAll('.poke').forEach(c=>c.onclick=()=>{
  if(Date.now()<(window.PS?.ignoreCardClicksUntil||0))return;
  if(teamBoxSlot!==null){
   const index=teamBoxSlot,id=c.dataset.id,usedAt=team.indexOf(id),next=[...team];
   const selected=state.box.find(x=>x.id===id);
   const selectingSpecial=window.PS_CATALOG?.pokemon?.[selected?.no]?.specialTeamLimited===true;
   const occupiedSpecial=team.some((memberId,slot)=>slot!==index&&memberId!==id&&window.PS_CATALOG?.pokemon?.[state.box.find(x=>x.id===memberId)?.no]?.specialTeamLimited===true);
   if(selectingSpecial&&occupiedSpecial){alert('特別なポケモンはチームに1匹だけ編成できます。先に現在の特別なポケモンを外してください。');return}
   if(usedAt!==-1&&usedAt!==index)next[usedAt]=next[index];
   next[index]=id;saveTeamSelection(next);teamBoxSlot=null;renderBoxTeamMode();go('home');return;
  }
  openBox(c.dataset.id);
 });
 renderTeam();
}
function renderBoxTeamMode(){
 const bar=document.getElementById('boxTeamMode');bar.hidden=teamBoxSlot===null;
 if(teamBoxSlot!==null){document.getElementById('boxTeamModeTitle').textContent=`チームの${teamBoxSlot+1}匹目を選択中`;document.getElementById('boxTeamRemove').disabled=!team[teamBoxSlot]}
}
document.getElementById('boxTeamCancel').onclick=()=>{teamBoxSlot=null;renderBoxTeamMode();go('home')};
document.getElementById('boxTeamRemove').onclick=()=>{if(teamBoxSlot===null)return;const next=[...team];next[teamBoxSlot]=null;saveTeamSelection(next);teamBoxSlot=null;renderBoxTeamMode();go('home')};
const MAX_POKEMON_LEVEL=70; // Confirmed in official Ver.3.6.0 notice, 2026-06-25.
const SUBSKILL_LEVELS=[10,25,50,70,80];
// Individual corrections are deliberately separate from daily yield (energy, collection and camp are not fixed here).
const NATURE_ROWS=window.PS_CATALOG.natures.rows;
const NATURE_AXES=window.PS_CATALOG.natures.axes;
const NATURE_EFFECTS=Object.fromEntries(NATURE_ROWS.flatMap((row,up)=>row.map((name,down)=>[name,up===down?{}:{up:NATURE_AXES[up],down:NATURE_AXES[down]}])));
const SUBSKILLS=Object.fromEntries(window.PS_CATALOG.subskills.map(skill=>[skill.name,skill]));
const SUBSKILL_NAMES=window.PS_CATALOG.subskills.map(skill=>skill.name);
function individualCorrections(item,p,teamSpeedReduction=0){
 const effect=item.mint?{}:NATURE_EFFECTS[item.nature]||{};
 const active=SUBSKILL_LEVELS.filter(n=>n<=item.level).map((_,i)=>item.subskills?.[i]).filter(Boolean);
 const sum=kind=>active.reduce((total,name)=>total+(SUBSKILLS[name]?.effect===kind?SUBSKILLS[name].value||0:0),0);
 const natureFactor=axis=>effect.up===axis?window.PS_CATALOG.natures.factors[axis].up:effect.down===axis?window.PS_CATALOG.natures.factors[axis].down:1;
 const soloSpeedReduction=Math.min(.35,sum('speedReduction'));
 const speedReduction=Math.min(.35,sum('speedReduction')+teamSpeedReduction);
 const speedBase=Number.isFinite(p?.help)?p.help*(1-(item.level-1)*.002)*natureFactor('speed'):null;
 const soloSpeed=speedBase==null?null:Math.floor(speedBase*(1-soloSpeedReduction));
 const speed=speedBase==null?null:Math.floor(speedBase*(1-speedReduction));
 const foodFactor=natureFactor('food')*(1+sum('foodRateBonus'));
 const skillFactor=natureFactor('skill')*(1+sum('skillRateBonus'));
 const carry=Number.isFinite(p?.carry)?p.carry+sum('carryBonus'):null;
 const food=Number.isFinite(p?.foodRate)?Math.min(100,p.foodRate*foodFactor):null;
 const skill=Number.isFinite(p?.skillRate)?Math.min(100,p.skillRate*skillFactor):null;
 const unknown=[...active.filter(name=>!SUBSKILL_NAMES.includes(name)),...(!item.mint&&item.nature&&!NATURE_EFFECTS[item.nature]?[item.nature]:[])];
 return {speed,soloSpeed,carry,food,skill,foodFactor,skillFactor,active,unknown,
   nature:effect,berryQty:Number.isFinite(p?.berryQty)?p.berryQty+sum('berryQtyBonus'):null,
   teamBonus:sum('teamSpeedReduction')>0,energyFactor:natureFactor('energy'),expFactor:natureFactor('exp')};
}
function teamSpeedContext(ids=team,box=state.box,catalog=window.PS_CATALOG){
 const selected=ids.map(id=>box.find(item=>item.id===id)).filter(Boolean);
 const contribution=item=>SUBSKILL_LEVELS.reduce((sum,unlock,i)=>sum+(unlock<=item.level&&SUBSKILLS[item.subskills?.[i]]?.effect==='teamSpeedReduction'?SUBSKILLS[item.subskills[i]].value:0),0);
 const bonus=selected.reduce((sum,item)=>sum+contribution(item),0);
 const members=new Map(selected.map(item=>[item.id,individualCorrections(item,catalog?.pokemon?.[item.no],bonus)]));
 return {bonus,bonusCount:selected.filter(item=>contribution(item)>0).length,members};
}
// Bounded estimate: ten-minute energy bands and expected inventory occupancy.
// Ingredients across unlocked slots are assumed equally likely; skill events are separate.
function expectedStoredSkills(regularHelps,rate,stockLimit){
 const probability=Math.max(0,Math.min(1,Number(rate)/100));
 if(!Number.isFinite(regularHelps)||regularHelps<=0||!probability)return 0;
 if(probability===1)return Math.min(stockLimit,regularHelps);
 // Fractional expected helps: Poisson approximation to Bernoulli trials.
 const lambda=-regularHelps*Math.log1p(-probability),none=Math.exp(-lambda);
 return stockLimit===2?2-(2+lambda)*none:1-none;
}
function berryEnergyAtLevel(base,level){
 if(!Number.isFinite(base)||!Number.isFinite(level))return null;
 return Math.round(Math.max(base+level-1,base*Math.pow(1.025,level-1)));
}
function mealRecoveryAtEnergy(energy){
 return energy>80?1:energy>70?2:energy>60?3:energy>50?4:energy>40?5:energy>30?6:energy>20?7:energy>10?8:9;
}
function dailyBaseline(ids=team,box=state.box,catalog=window.PS_CATALOG,collectionHours=4,initialEnergy=100,goodCamp=false,threeMeals=true,favoriteBerries=[],areaBonus=0){
 const interval=[2,4,8].includes(Number(collectionHours))?Number(collectionHours):4;
 const startingEnergy=Math.max(0,Math.min(150,Math.round(Number(initialEnergy)||0)));
 const favorites=new Set(favoriteBerries.filter(name=>Object.hasOwn(catalog?.berries||{},name)));
 const areaFactor=1+Math.max(0,Math.min(200,Number(areaBonus)||0))/100;
 const energyIntervalFactor=e=>e>=81?.45:e>=61?.52:e>=41?.58:e>=1?.66:1;
 const speedContext=teamSpeedContext(ids,box,catalog);
 const periods=[];for(let h=0;h<16;h+=interval)periods.push(Math.min(interval,16-h));
 periods.push(8); // No collection during sleep; collect at wake-up.
 const members=ids.map(id=>box.find(item=>item.id===id)).filter(Boolean).map(item=>{
  const species=catalog?.pokemon?.[item.no],stats=speedContext.members.get(item.id);
  const slots=(species?.ingredientSlots||[]).filter(slot=>slot.unlock<=item.level).map(slot=>{
   const chosen=item.ingredients?.[slot.unlock];
   return slot.candidates?.length===1?slot.candidates[0]:slot.candidates?.find(candidate=>candidate.name===chosen);
  });
  const reasons=[];
  if(!stats?.speed)reasons.push('おてつだい時間');
  if(!stats?.carry)reasons.push('最大所持数');
  if(!Number.isFinite(stats?.food))reasons.push('食材確率');
  if(!Number.isFinite(stats?.berryQty))reasons.push('きのみ数');
  if(!Number.isFinite(catalog?.berries?.[species?.berry]))reasons.push('きのみエナジー');
  if(!slots.length)reasons.push('食材候補');
  else slots.forEach((slot,index)=>{if(!slot)reasons.push(`Lv.${species.ingredientSlots.filter(s=>s.unlock<=item.level)[index].unlock}の食材選択`)});
  if(reasons.length)return {id:item.id,name:item.name,missing:true,reasons};
  const chance=Math.max(0,Math.min(1,stats.food/100));
  const averageFood=slots.reduce((sum,slot)=>sum+slot.qty,0)/slots.length;
  const averageSize=chance*averageFood+(1-chance)*stats.berryQty;
  if(averageSize<=0)return {id:item.id,name:item.name,missing:true};
  const skill=catalog?.skills?.[species.mainSkillId];
  const skillLevel=Math.max(1,Math.min(skill?.maxLevel||7,item.skillLevel||1));
  const skillEffect=skill?.levels?.[skillLevel];
  const stockLimit=['スキル','オール'].includes(species.specialty)?2:1;
  return {id:item.id,name:item.name,stats,slots,chance,averageSize,stockLimit,
   berryBase:catalog.berries[species.berry],berryName:species.berry,level:item.level,
   foods:new Map(),berries:0,overflow:0,skillTriggers:0,energy:startingEnergy,
   skillName:skill?.name||null,skillEffectType:skill?.effectType,
   skillAmount:skillEffect?.amount,skillEnergy:skillEffect?.energy ??
    (Number.isFinite(skillEffect?.min)&&Number.isFinite(skillEffect?.max)?(skillEffect.min+skillEffect.max)/2:null),
   skillRecovery:skillEffect?.recovery,skillHelps:skillEffect?.helps,missing:false};
 });
 const valid=members.filter(m=>!m.missing);
 let elapsedTicks=0;
 periods.forEach((hours,periodIndex)=>{
  let teamRecovery=0,allyRecovery=0;
  for(const member of valid){
   let helps=0;
   for(let tick=0;tick<hours*6;tick++){
    if(threeMeals&&[0,36,72].includes(elapsedTicks+tick))member.energy=Math.min(150,member.energy+mealRecoveryAtEnergy(member.energy));
    helps+=600*(goodCamp?1.2:1)/(member.stats.speed*energyIntervalFactor(member.energy));
    member.energy=Math.max(0,member.energy-1);
   }
   const regular=Math.min(helps,member.stats.carry*(goodCamp?1.2:1)/member.averageSize);
   const extra=Math.max(0,helps-regular);
   const triggers=Number.isFinite(member.stats.skill)&&member.skillName?expectedStoredSkills(regular,member.stats.skill,member.stockLimit):0;
   member.skillTriggers+=triggers;
   if(member.skillEffectType==='team_energy_recovery'&&Number.isFinite(member.skillRecovery))teamRecovery+=triggers*member.skillRecovery;
   if(periodIndex<periods.length-1&&member.skillEffectType==='self_energy_recovery'&&Number.isFinite(member.skillRecovery))
    member.energy=Math.min(150,member.energy+triggers*member.skillRecovery*member.stats.energyFactor);
   if(member.skillEffectType==='ally_energy_recovery'&&Number.isFinite(member.skillRecovery))
    allyRecovery+=triggers*member.skillRecovery;
   for(const slot of member.slots)member.foods.set(slot.name,(member.foods.get(slot.name)||0)+regular*member.chance*slot.qty/member.slots.length);
   member.berries+=regular*(1-member.chance)*member.stats.berryQty+extra*member.stats.berryQty;
   member.overflow+=extra*member.stats.berryQty;
  }
  // The sleep period ends at the next wake-up; its stored skills do not change today's production.
  if(periodIndex<periods.length-1&&(teamRecovery>0||allyRecovery>0)){
   // Random ally target is approximated as an equal share; actual targeting favors low energy.
   for(const member of valid)member.energy=Math.min(150,member.energy+(teamRecovery+allyRecovery/valid.length)*member.stats.energyFactor);
  }
  elapsedTicks+=hours*6;
 });
 for(const member of valid){
  member.berryEnergyBase=member.berries*berryEnergyAtLevel(member.berryBase,member.level);
  member.berryEnergy=member.berryEnergyBase*(favorites.has(member.berryName)?2:1)*areaFactor;
 }
 const foods=new Map();
 valid.forEach(member=>member.foods.forEach((qty,name)=>foods.set(name,(foods.get(name)||0)+qty)));
 const berryEnergy=valid.reduce((sum,member)=>sum+member.berryEnergy,0);
 const skillEnergyBase=valid.reduce((sum,member)=>sum+(['fixed_energy','variable_energy'].includes(member.skillEffectType)&&Number.isFinite(member.skillEnergy)?member.skillTriggers*member.skillEnergy:0),0);
 const skillEnergy=skillEnergyBase*areaFactor;
 return {members,foods,berryEnergy,skillEnergy,skillEnergyBase,periods,interval,startingEnergy,goodCamp,threeMeals,favorites,areaFactor};
}
let teamInitialEnergy=100;
let teamGoodCamp=false;
let teamMeals=true;
const berryChoices=[...document.querySelectorAll('.psg-favorite-berry')];
for(const select of berryChoices){
 for(const name of [...knownBerryNames].sort((a,b)=>a.localeCompare(b,'ja'))){
  select.add(new Option(name,name));
 }
 select.onchange=()=>{
  fieldProfile.weekly[fieldProfile.selectedFieldId]={weekKey:currentFieldWeek(),berries:berryChoices.map(choice=>choice.value)};
  saveFieldProfile();
 };
}
const fieldSelect=document.getElementById('fieldSelect');
const homeFieldSelect=document.getElementById('homeFieldSelect');
const fieldOrder=['greengrass','cyan','taupe','snowdrop','lapis','old_gold','amber'];
for(const id of fieldOrder){
 const field=window.PS_CATALOG?.fields?.[id];
 if(field){fieldSelect.add(new Option(field.name,id));homeFieldSelect.add(new Option(field.name,id))}
}
const areaBonusInput=document.getElementById('fieldAreaBonus');
function activeFieldBerries(){
 const entry=fieldProfile.weekly[fieldProfile.selectedFieldId];
 return entry?.weekKey===currentFieldWeek()?entry.berries:(window.PS_CATALOG?.fields?.[fieldProfile.selectedFieldId]?.favoriteBerries||[]);
}
function renderFieldControls(){
 fieldSelect.value=fieldProfile.selectedFieldId;
 homeFieldSelect.value=fieldProfile.selectedFieldId;
 areaBonusInput.value=String(fieldProfile.areaBonuses[fieldProfile.selectedFieldId]||0);
 const berries=activeFieldBerries();
 berryChoices.forEach((choice,index)=>{choice.value=berries[index]||''});
 const field=window.PS_CATALOG?.fields?.[fieldProfile.selectedFieldId];
 document.getElementById('fieldWeekLabel').textContent=`今週：${currentFieldWeek()}開始（端末の現地時間・月曜4時切替）・${field?.favoriteMode==='fixed'?'通常は固定3種':'毎週ランダム'}`;
 document.getElementById('fieldFavoriteReset').hidden=fieldProfile.weekly[fieldProfile.selectedFieldId]?.weekKey!==currentFieldWeek();
 const fieldName=window.PS_CATALOG?.fields?.[fieldProfile.selectedFieldId]?.name||'フィールド未設定';
 document.getElementById('teamFieldSummary').textContent=`${fieldName}・エリア＋${areaBonusInput.value}％・好物 ${berries.filter(Boolean).join(' / ')||'未設定'}`;
 renderFieldEncounters(field);
}
function renderFieldEncounters(field){
 const host=document.getElementById('fieldEncounterList');if(!host)return;
 host.replaceChildren();
 const encounters=field?.encounters||[];
 const rankFilter=document.getElementById('fieldRankFilter');
 const rankOrder={ノーマル:0,スーパー:1,ハイパー:2,マスター:3};
 const rankValue=rank=>rankOrder[rank.tier]*100+rank.level;
 const oldValue=rankFilter.value;
 const rankOptions=(field?.rankThresholds||[]).map(rank=>[`${rank.tier}:${rank.level}`,rank]);
 rankFilter.replaceChildren(new Option('すべて表示',''));
 for(const [value,rank] of rankOptions)rankFilter.add(new Option(`${rank.tier}${rank.level}まで`,value));
 rankFilter.value=oldValue;
 if(!rankFilter.value)rankFilter.value='';
 rankFilter.onchange=()=>renderFieldEncounters(field);
 const selected=rankOptions.find(([value])=>value===rankFilter.value)?.[1];
 document.getElementById('fieldRankEnergy').textContent=selected?`${selected.tier}${selected.level}に必要なカビゴンエナジー：${selected.energy.toLocaleString()}`:'ランクを選ぶと必要なカビゴンエナジーを表示します。';
 const rankList=document.getElementById('fieldRankThresholdList');rankList.replaceChildren();
 for(const [,rank] of rankOptions){const line=document.createElement('div');line.className='psg-field-encounter-row';const label=document.createElement('span');label.textContent=`${rank.tier}${rank.level}`;const energy=document.createElement('strong');energy.textContent=rank.energy.toLocaleString();line.append(label,energy);rankList.append(line)}
 if(!encounters.length){document.getElementById('fieldEncounterCount').textContent='';const p=document.createElement('p');p.className='note';p.textContent='このフィールドの出現データは未投入です。';host.append(p);return}
 const visible=selected?encounters.filter(item=>rankValue(item.rank)<=rankValue(selected)):encounters;
 document.getElementById('fieldEncounterCount').textContent=`${visible.length} / ${encounters.length} 件の収録済み寝顔`;
 const grouped=new Map();
 for(const item of visible){
  const no=String(Number(item.sleepStyleId.split('_')[0]));
  const pokemon=window.PS_CATALOG.pokemon?.[no];
  const style=window.PS_CATALOG.sleepStyles?.[no]?.find(row=>row[2]===item.sleepStyleId);
  if(!pokemon||!style)continue;
  if(!grouped.has(no))grouped.set(no,{pokemon,rows:[]});
  grouped.get(no).rows.push({item,style});
 }
 for(const {pokemon,rows} of [...grouped.values()].sort((a,b)=>a.pokemon.no-b.pokemon.no)){
  const section=document.createElement('section');section.className='psg-field-species';
  const title=document.createElement('button');title.type='button';title.className='psg-field-species-name';
  title.textContent=`No.${String(pokemon.no).padStart(3,'0')} ${pokemon.name} ›`;
  title.onclick=()=>window.openPokemonDetail?.(pokemon.no);
  section.append(title);
  for(const {item,style} of rows.sort((a,b)=>a.style[1]-b.style[1])){
   const row=document.createElement('div');row.className='psg-field-encounter-row';
   const name=document.createElement('span');name.textContent=`★${style[1]} ${style[0]}`;
   const rank=document.createElement('strong');rank.textContent=`${item.rank.tier}${item.rank.level}から`;
   row.append(name,rank);section.append(row);
  }
  host.append(section);
 }
 if(!visible.length){const p=document.createElement('p');p.className='note';p.textContent='このランクまでに収録済みの寝顔はありません。';host.append(p)}
}
function selectField(id){fieldProfile.selectedFieldId=id;document.getElementById('fieldRankFilter').value='';saveFieldProfile()}
fieldSelect.onchange=()=>selectField(fieldSelect.value);
homeFieldSelect.onchange=()=>selectField(homeFieldSelect.value);
document.getElementById('fieldFavoriteReset').onclick=()=>{delete fieldProfile.weekly[fieldProfile.selectedFieldId];saveFieldProfile()};
areaBonusInput.onchange=()=>{
 fieldProfile.areaBonuses[fieldProfile.selectedFieldId]=Math.max(0,Math.min(200,Number(areaBonusInput.value)||0));
 saveFieldProfile();
};
document.getElementById('teamFieldLink').onclick=()=>{renderFieldControls();go('fieldPage')};
renderFieldControls();
function renderTeamDay(){
 const host=document.getElementById('teamDayEstimate');if(!host)return;
 const interval=document.getElementById('teamCollectionInterval').value;
 renderFieldControls();
 const result=dailyBaseline(team,state.box,window.PS_CATALOG,interval,teamInitialEnergy,teamGoodCamp,teamMeals,activeFieldBerries(),fieldProfile.areaBonuses[fieldProfile.selectedFieldId]||0);
 host.replaceChildren();
 if(!result.members.length){const p=document.createElement('p');p.className='note';p.textContent='チームを選ぶと獲得予想を表示します。';host.append(p);return}
 const foodTiles=foods=>{
  const tiles=document.createElement('div');tiles.className='psg-day-food-list';
  for(const [name,qty] of foods){
   const tile=document.createElement('span');tile.className='psg-day-food-tile';tile.setAttribute('aria-label',`${name} 約${qty.toFixed(1)}個`);
   tile.append(teamFoodIcon(name));
   const copy=document.createElement('span');const title=document.createElement('small');title.textContent=name;
   const amount=document.createElement('strong');amount.textContent=`約${qty.toFixed(1)}個`;
   copy.append(title,amount);tile.append(copy);tiles.append(tile);
  }
  return tiles;
 };
 const list=document.createElement('div');list.className='psg-day-list';
 for(const member of result.members){
  const row=document.createElement('div');row.className='psg-day-row';
  const label=document.createElement('strong');label.textContent=member.name;row.append(label);
  const detail=document.createElement('span');
  const skillText=member.skillName?` ／ ${member.skillName} 約${member.skillTriggers.toFixed(1)}回${member.skillEffectType==='random_ingredients'&&Number.isFinite(member.skillAmount)?`（ランダム食材 約${(member.skillTriggers*member.skillAmount).toFixed(1)}個）`:['fixed_energy','variable_energy'].includes(member.skillEffectType)&&Number.isFinite(member.skillEnergy)?`（エナジー期待値 約${Math.round(member.skillTriggers*member.skillEnergy*result.areaFactor).toLocaleString()}）`:member.skillEffectType==='team_energy_recovery'&&Number.isFinite(member.skillRecovery)?`（チーム各匹＋${member.skillRecovery}）`:member.skillEffectType==='self_energy_recovery'&&Number.isFinite(member.skillRecovery)?`（自分のげんき＋${member.skillRecovery}）`:member.skillEffectType==='ally_energy_recovery'&&Number.isFinite(member.skillRecovery)?`（1匹のげんき＋${member.skillRecovery}・対象は仮配分）`:member.skillEffectType==='extra_help'&&Number.isFinite(member.skillHelps)?`（即時おてつだい約${(member.skillTriggers*member.skillHelps).toFixed(1)}回・日産未反映）`:''}`:'';
  detail.textContent=member.missing?`未確認：${member.reasons.join('・')}`:`きのみ 約${member.berries.toFixed(1)}個（満杯後 約${member.overflow.toFixed(1)}個・エナジー 約${Math.round(member.berryEnergy).toLocaleString()}${result.favorites.has(member.berryName)?'・好物':''}）${skillText}`;
  row.append(detail);if(!member.missing&&member.foods.size)row.append(foodTiles(member.foods));list.append(row);
 }
 host.append(list);
 if(result.foods.size){const total=document.createElement('div');total.className='psg-day-total';const label=document.createElement('strong');label.textContent='食材合計';total.append(label,foodTiles(result.foods));host.append(total)}
 if(result.members.some(member=>!member.missing)){const total=document.createElement('p');total.className='psg-day-total';total.textContent=`きのみ＋スキルのエナジー期待値：約${Math.round(result.berryEnergy+result.skillEnergy).toLocaleString()}（きのみ 約${Math.round(result.berryEnergy).toLocaleString()}・スキル 約${Math.round(result.skillEnergy).toLocaleString()}／好物・エリア補正込み）`;host.append(total)}
}
document.getElementById('teamCollectionInterval').onchange=renderTeamDay;
document.getElementById('teamGoodCamp').onclick=event=>{
 teamGoodCamp=!teamGoodCamp;
 event.currentTarget.setAttribute('aria-pressed',String(teamGoodCamp));
 event.currentTarget.textContent=`いいキャンプ：${teamGoodCamp?'ON':'OFF'}`;
 renderTeamDay();
};
document.getElementById('teamMeals').onclick=event=>{
 teamMeals=!teamMeals;
 event.currentTarget.setAttribute('aria-pressed',String(teamMeals));
 event.currentTarget.textContent=`食事3回：${teamMeals?'ON':'OFF'}`;
 renderTeamDay();
};
document.querySelectorAll('.psg-day-energy-options button').forEach(button=>button.onclick=()=>{
 teamInitialEnergy=Number(button.dataset.energy);
 document.querySelectorAll('.psg-day-energy-options button').forEach(option=>option.setAttribute('aria-pressed',String(option===button)));
 renderTeamDay();
});
const boxEsc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const selectedSpecies=()=>window.PS_CATALOG?.pokemon?.[state.selected?.no]||null;
function openBox(id){state.selected=state.box.find(x=>x.id===id);if(!state.selected)return;boxTitle.textContent=state.selected.name;syncLevel();go('boxDetail')}
function syncLevel(){
 const item=state.selected;if(!item)return;
 const p=selectedSpecies();
 const calc=individualCorrections(item,p);
 lv.textContent='Lv.'+item.level;lvRange.value=item.level;
 boxTitle.textContent=item.name;
 document.getElementById('boxHeaderNo').textContent=`No.${String(item.no).padStart(3,'0')}`;
 document.getElementById('boxHeaderMeta').textContent=`Lv.${item.level}`;
 const berryImage=p?.berryImage?window.PS_DEV_ASSETS.image(p.berryImage,'berry',p.berry,'full',p.berry):'<small aria-label="No image">◌</small>';
 document.getElementById('boxTraits').innerHTML=`<span class="psg-box-trait psg-box-trait-berry">${berryImage}<b>${calc.berryQty==null?'未確認':'×'+calc.berryQty}</b></span><span class="psg-box-trait">💤 ${boxEsc(p?.sleepType||'未確認')}</span><span class="psg-box-trait psg-v106-specialty" title="得意：${boxEsc(p?.specialty||'未確認')}" aria-label="得意：${boxEsc(p?.specialty||'未確認')}">${specIcon(p?.specialty)}</span>`;
 hydrateSpecialtyIcons(document.getElementById('boxTraits'));
 const artwork=document.getElementById('boxArtwork');
 document.querySelector('#boxDetail .psg-box-hero').style.setProperty('--box-type-bg',({'くさ':'#e8f7ec','ほのお':'#fff0e8','むし':'#f1f5df','みず':'#e9f4ff','でんき':'#fff8d9'}[p?.type]||'#f3f6f4'));
 const badges=p?`<div class="psg-box-art-badges"><span class="psg-box-art-badge" title="タイプ：${boxEsc(p.type)}" aria-label="タイプ：${boxEsc(p.type)}">${typeFilterArt(p.type)}</span></div>`:'';
 artwork.innerHTML=(window.PS_DEV_ASSETS.image(p?.image,'pokemon',p?.no,'full',item.name)||'No image')+badges;
 hydrateSpecialtyIcons(artwork);
 const naturePending=(!item.nature&&!item.mint)||calc.unknown.length;
 const nextRateUnlock=kind=>SUBSKILL_LEVELS.find((unlock,i)=>unlock>item.level&&unlock<=MAX_POKEMON_LEVEL&&SUBSKILLS[item.subskills?.[i]]?.effect===kind);
 const rateNote=(factor,kind)=>{const next=factor===1?nextRateUnlock(kind):null;return next?`推定・Lv.${next}で補正`:`推定・×${factor.toFixed(2)}`};
 const fields=[['おてつだい時間',calc.speed,'秒','Lv・個体補正',naturePending],['最大所持数',calc.carry,'','補正反映',false],['食材確率',calc.food,'%',rateNote(calc.foodFactor,'foodRateBonus'),naturePending],['スキル発動確率',calc.skill,'%',rateNote(calc.skillFactor,'skillRateBonus'),naturePending]];
 document.getElementById('boxStats').innerHTML=fields.map(([title,value,unit,note,pending])=>`<div class="psg-box-stat"><small>${title}</small><strong>${value==null?'未確認':(unit==='%'?value.toFixed(1):value.toLocaleString())+unit}</strong><em>${value==null?'（基礎データなし）':'（'+(pending?'暫定・':'')+note+'）'}</em></div>`).join('');
 const slots=p?.ingredientSlots||[];
 const ingredientRows=[1,30,60].map((unlock,index)=>{
  const slot=slots.find(s=>s.unlock===unlock);
  const name=item.ingredients?.[unlock]||((slot?.candidates?.length===1)?slot.candidates[0].name:'');
  const choice=slot?.candidates?.find(x=>x.name===name);
  const image=name&&window.PS_CATALOG.ingredientVisual(name)?.image;
  const iconSource=image||window.PS_INGREDIENT_FALLBACK_ICON?.(name);
  const icon=iconSource?`<img src="${iconSource}" alt="${boxEsc(name)}">`:'';
  return `<div class="psg-v106-ingredient ${item.level<unlock?'is-locked':''}" aria-label="${index?'Lv.'+unlock+' ':' '}${boxEsc(name||'食材未確認')}${choice?' '+choice.qty+'個':''}${item.level<unlock?' 未解放':''}">${index?`<b class="psg-v106-unlock">Lv.${unlock}</b>`:'<b class="psg-v106-unlock" aria-hidden="true">&nbsp;</b>'}<span class="psg-v106-ingredient-image">${icon||'<span class="psg-v106-unknown">◌</span>'}</span><strong>${choice?'×'+choice.qty:'—'}</strong></div>`;
 });
 document.getElementById('boxIngredientRows').innerHTML=ingredientRows.join('');
 document.getElementById('boxSubskillRows').innerHTML=SUBSKILL_LEVELS.map((unlock,index)=>{const name=item.subskills?.[index]||'';const badge=window.PS_IMAGE_FILES.subskills?.[name];return `<div class="psg-box-line ${item.level<unlock?'is-locked':''}"><span class="psg-level-label">Lv.${unlock}</span><span class="psg-line-body">${badge?`<img class="psg-subskill-badge" src="${badge}" alt="">`:''}${boxEsc(name||'未確認')}</span><span class="psg-line-state">${unlock>MAX_POKEMON_LEVEL?'上限未到達':item.level>=unlock?'解放済み':'未解放'}</span></div>`}).join('');
 const skill=window.PS_CATALOG?.skills?.[p?.mainSkillId];
 const skillLv=Math.min(Math.max(1,item.skillLevel||1),skill?.maxLevel||7);
 const currentEffect=skill?.levels?.[skillLv];
 const effect=skill?.effectType==='random_ingredients'&&currentEffect?.amount!=null?`１回の効果量：ランダムな食材 ${currentEffect.amount}個`:skill?.effectType==='fixed_energy'&&currentEffect?.energy!=null?`１回の効果量：カビゴンのエナジーを ${currentEffect.energy.toLocaleString()} 増やす`:skill?.effectType==='variable_energy'&&currentEffect?.min!=null&&currentEffect?.max!=null?`１回の効果量：カビゴンのエナジーを ${currentEffect.min.toLocaleString()}～${currentEffect.max.toLocaleString()} 増やす`:skill?.effectType==='team_energy_recovery'&&currentEffect?.recovery!=null?`１回の効果量：チーム各匹のげんき＋${currentEffect.recovery}`:currentEffect?.description?`１回の効果量：${boxEsc(currentEffect.description)}`:'効果量 未確認';
 const skillArt=skill?.image?window.PS_DEV_ASSETS.image(skill.image,'skill',skill.id,'full',skill.name):'';
 document.getElementById('boxMainSkill').innerHTML=`<div class="psg-box-lead">${skillArt?`<span class="psg-box-skill-art">${skillArt}</span>`:''}${boxEsc(skill?.name||'未確認')}　Lv.${skillLv}</div><p>${effect}</p><div class="psg-box-forecast"><b>１日あたりの期待値</b><p>計算データ未確認</p></div><details><summary>計算の詳細</summary><p class="psg-box-muted">スキルLv補正・発動回数の計算データ未確認</p></details>`;
 const mintIcon='<span class="psg-mint-mark" title="まっしろミント適用済み" aria-label="まっしろミント適用済み"><svg width="17" height="17" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 16C3 7 9 3 17 3c0 8-4 14-12 14" fill="#fff" stroke="#5d9c75" stroke-width="1.5"/><path d="M4 17c3-4 6-7 11-10" fill="none" stroke="#5d9c75" stroke-width="1.2"/></svg></span>';
 const labels={speed:'おてつだい速度',energy:'げんき回復',food:'食材確率',skill:'スキル確率',exp:'EXP'};
 const natureText=item.mint?'ミント適用：性格補正なし':!item.nature?'性格未入力（無補正として仮計算）':!NATURE_EFFECTS[item.nature]?'性格名未対応（無補正として仮計算）':calc.nature.up?`${labels[calc.nature.up]}↑ / ${labels[calc.nature.down]}↓`:'性格補正なし';
 document.getElementById('boxNature').innerHTML=`<div class="psg-box-lead">${boxEsc(item.nature||'未確認')}${item.mint?mintIcon:''}</div><p class="psg-box-muted">${natureText}。解放済みサブスキルのみ反映。${calc.unknown.length?'未対応：'+boxEsc(calc.unknown.join('・'))+'。':''}</p>`;
 document.getElementById('boxEvaluation').innerHTML=`<p>役割：${boxEsc(item.role||'未設定')}</p><p>食材確率 ×${calc.foodFactor.toFixed(2)} / スキル確率 ×${calc.skillFactor.toFixed(2)}</p><p class="psg-box-muted">単体の個体補正の比較用。チームのおてつだいボーナスはホームのおてつだい時間に反映。げんき・回収間隔・所持数満杯を含む日産計算には条件設定が必要。スキルLvは現在値を別途設定（スキルレベルアップS/Mを二重加算しない）。理想個体との差は未判定。</p>`;
 const milestones=[...new Set([...slots.map(s=>s.unlock).filter(n=>n>1),...SUBSKILL_LEVELS.filter(n=>n<=MAX_POKEMON_LEVEL)])].filter(n=>n>item.level&&n<=MAX_POKEMON_LEVEL).sort((a,b)=>a-b).slice(0,2);
 document.getElementById('boxGrowth').innerHTML=milestones.length?milestones.map(n=>`<div class="psg-milestone"><b>Lv.${n}　${slots.some(s=>s.unlock===n)?'食材解放':'Sスキル解放'}</b><div class="psg-box-muted">現在Lv.${item.level}から：アメ 未確認／ゆめのかけら 未確認</div></div>`).join(''):'<p class="psg-box-muted">現在のレベル上限まで、次の解放はありません。</p>';
 const parent=p?.evolution;
 if(parent&&!Array.isArray(parent))document.getElementById('boxGrowth').insertAdjacentHTML('beforeend',`<p class="psg-box-muted">進化先：${boxEsc(parent.to||'未確認')}　${parent.level?'Lv.'+parent.level:''}${parent.candy?'・アメ'+parent.candy+'個':''}</p>`);
 fillBoxEditor(item,p);
}
function fillBoxEditor(item,p){
 const form=document.getElementById('boxEditForm');
 const natureOptions=['',...NATURE_ROWS.flat()];
 if(item.nature&&!natureOptions.includes(item.nature))natureOptions.push(item.nature);
 form.elements.nature.innerHTML=natureOptions.map(name=>`<option value="${boxEsc(name)}">${boxEsc(name||'未確認')}${name&&!NATURE_EFFECTS[name]?'（未対応）':''}</option>`).join('');
 form.elements.nature.value=item.nature||'';
 form.elements.mint.checked=!!item.mint;
 form.elements.skillLevel.value=item.skillLevel||1;
 form.elements.role.value=item.role||'';
 const slots=p?.ingredientSlots||[];
 document.getElementById('boxEditIngredients').innerHTML=[1,30,60].map(unlock=>{
  const candidates=slots.find(s=>s.unlock===unlock)?.candidates||[];
  const chosen=item.ingredients?.[unlock]||((candidates.length===1)?candidates[0].name:'');
  return `<label>Lv.${unlock} 食材<select name="ingredient-${unlock}"><option value="">未確認</option>${candidates.map(c=>`<option value="${boxEsc(c.name)}" ${c.name===chosen?'selected':''}>${boxEsc(c.name)} ×${c.qty}</option>`).join('')}</select></label>`;
 }).join('');
 document.getElementById('boxEditSubskills').innerHTML=SUBSKILL_LEVELS.map((n,i)=>{const prior=item.subskills?.[i]||'';const choices=['',...SUBSKILL_NAMES];if(prior&&!choices.includes(prior))choices.push(prior);return `<label>Lv.${n} サブスキル<select name="subskill-${i}">${choices.map(name=>`<option value="${boxEsc(name)}" ${name===prior?'selected':''}>${boxEsc(name||'未確認')}${name&&!SUBSKILL_NAMES.includes(name)?'（未対応）':''}</option>`).join('')}</select></label>`}).join('');
}
function updateLevel(level){
 if(!state.selected||!Number.isInteger(level)||level<1||level>MAX_POKEMON_LEVEL)return;
 const changed={...state.selected,level};
 if(commitBox(state.box.map(x=>x.id===changed.id?changed:x))){state.selected=changed;syncLevel()}
}
minus.onclick=()=>updateLevel(Math.max(1,(state.selected?.level||1)-1));
plus.onclick=()=>updateLevel(Math.min(MAX_POKEMON_LEVEL,(state.selected?.level||1)+1));
lvRange.oninput=()=>updateLevel(+lvRange.value);
document.getElementById('boxEditShortcut').onclick=()=>{const details=document.getElementById('boxEditor');details.open=true;details.scrollIntoView({behavior:'smooth',block:'start'})};
document.getElementById('boxEditForm').onsubmit=e=>{
 e.preventDefault();const item=state.selected,p=selectedSpecies();if(!item||!p)return;
 const form=e.currentTarget;const data=new FormData(form),ingredients={};
 for(const unlock of [1,30,60]){
  const value=String(data.get(`ingredient-${unlock}`)||'');
  if(p.ingredientSlots?.find(s=>s.unlock===unlock)?.candidates?.some(c=>c.name===value))ingredients[unlock]=value;
 }
 const skillLevel=Math.max(1,Math.min(window.PS_CATALOG?.skills?.[p.mainSkillId]?.maxLevel||7,Number(data.get('skillLevel'))||1));
 const changed={...item,ingredients,subskills:SUBSKILL_LEVELS.map((_,i)=>String(data.get(`subskill-${i}`)||'').trim().slice(0,80)),nature:String(data.get('nature')||'').trim().slice(0,40),mint:data.get('mint')==='on',skillLevel,role:String(data.get('role')||'').trim().slice(0,40)};
 const filled=changed.subskills.filter(Boolean);
 if(new Set(filled).size!==filled.length){document.getElementById('boxEditMessage').textContent='同じサブスキルを重複して設定できません';return}
 if(commitBox(state.box.map(x=>x.id===changed.id?changed:x))){state.selected=changed;syncLevel();document.getElementById('boxEditMessage').textContent='保存しました'}
};
boxSearch.oninput=renderBox;dexSearch.oninput=renderDex;
function closeBoxAdd(){boxAddPanel.hidden=true;addBtn.setAttribute('aria-expanded','false')}
addBtn.onclick=()=>{
 const opening=boxAddPanel.hidden;
 if(opening)boxSpecies.innerHTML=boxCatalog().map(p=>`<option value="${p.no}">No.${String(p.no).padStart(3,'0')} ${p.name}</option>`).join('');
 boxAddPanel.hidden=!opening;addBtn.setAttribute('aria-expanded',String(opening));
};
boxCancelAdd.onclick=closeBoxAdd;
boxConfirmAdd.onclick=()=>{
 const p=boxCatalog().find(x=>Number(x.no)===Number(boxSpecies.value));if(!p)return;
 const id=globalThis.crypto?.randomUUID?.()||`${Date.now()}-${Math.random().toString(36).slice(2)}`;
 if(commitBox([...state.box,{id,no:Number(p.no),name:p.name,specialty:p.specialty,level:1}])){
  boxUndoPanel.hidden=true;closeBoxAdd();boxSearch.value='';renderBox();
 }
};
let lastRemoval=null;
boxRemoveBtn.onclick=()=>{
 const selected=state.selected;if(!selected||!confirm(`${selected.name} Lv.${selected.level}をBoxから削除しますか？`))return;
 const index=state.box.findIndex(x=>x.id===selected.id);if(index<0)return;
 if(commitBox(state.box.filter(x=>x.id!==selected.id))){lastRemoval={selected,index};state.selected=null;boxUndoPanel.hidden=false;go('box',false)}
};
boxUndoRemove.onclick=()=>{
 if(!lastRemoval)return;
 const next=[...state.box];next.splice(lastRemoval.index,0,lastRemoval.selected);
 if(commitBox(next)){lastRemoval=null;boxUndoPanel.hidden=true}
};
hydrateSpecialtyIcons(document);renderFilters();setupMenus();renderDex();renderBox();
window.PS={state,master,go,renderDex,renderFilters,renderBox,refreshBoxDetail:syncLevel,teamContext};
})();
</script>
<script id="psg-dex-catalog-adapter">
(()=>{
/* Dex cards share the same records and Pokédex order as the detail renderer. */
if(window.PS?.master&&window.PS_CATALOG){
 window.PS.master.pokemon.splice(0,window.PS.master.pokemon.length,
  ...Object.values(window.PS_CATALOG.pokemon).filter(p=>p.dexVisible).sort((a,b)=>Number(a.no)-Number(b.no))
 );
 // The catalog arrives after the controller initializes; generate its filters now.
 window.PS.renderFilters?.();
 window.PS.renderDex?.();
}
})();
</script>










<script id="stable-v12-controller">
(()=>{
 const V=window.PS_CATALOG;if(!V)return;
 const detailEsc=value=>String(value).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
 let currentNo=1,currentTab="ability";
 const byNo=n=>V.pokemon[Number(n)]||null;
 const neighborOf=(no,direction)=>{
   const knownNos=Object.values(V.pokemon)
     .filter(p=>p&&Number.isInteger(Number(p.no))&&p.name)
     .map(p=>Number(p.no)).sort((a,b)=>a-b);
   const index=knownNos.indexOf(Number(no));
   return index<0?null:byNo(knownNos[index+direction]);
 };
 const skillOf=m=>m?V.skills[m.mainSkillId]:null;

 const TYPE_THEME={
   "ノーマル":["#f5f3ea","#9b9686"],"ほのお":["#fff0e8","#ef7b52"],
   "みず":["#e9f4ff","#5c9fdb"],"でんき":["#fff8d9","#d7ae35"],
   "くさ":["#e8f7ec","#55a66b"],"こおり":["#e7f7fa","#62b9c4"],
   "かくとう":["#f7e9e6","#b66a5d"],"どく":["#f3e9f8","#9568ad"],
   "じめん":["#f5eee1","#b28b56"],"ひこう":["#edf1fb","#849bc8"],
   "エスパー":["#f9eaf1","#c76f96"],"むし":["#f1f5df","#91a44e"],
   "いわ":["#f1ede2","#9f8c5b"],"ゴースト":["#eeeafa","#756da9"],
   "ドラゴン":["#eceafb","#7067bd"],"あく":["#ecebea","#69635f"],
   "はがね":["#eef2f4","#82939c"],"フェアリー":["#faeaf2","#c77c9f"]
 };
 const TYPE_ICONS={
   "くさ":"🌿","ほのお":"🔥","みず":"💧","でんき":"⚡","こおり":"❄️",
   "かくとう":"🥊","どく":"☠️","じめん":"⛰️","ひこう":"🪽","エスパー":"🔮",
   "むし":"🐛","いわ":"🪨","ゴースト":"👻","ドラゴン":"🐉","あく":"🌑",
   "はがね":"⚙️","フェアリー":"✨","ノーマル":"◯"
 };
 const iconForType=type=>TYPE_ICONS[type]||"◯";
 function setTheme(type){
   const [bg,accent]=TYPE_THEME[type]||["#f3f6f4","#718078"];
   const d=document.getElementById("dexDetail");
   d.style.setProperty("--type-bg",bg);d.style.setProperty("--type-accent",accent);
 }
 function show(id){
   document.querySelectorAll(".screen").forEach(x=>x.classList.toggle("active",x.id===id));
   if(window.PS?.state)window.PS.state.screen=id;
   window.scrollTo(0,0);
 }
 // v30: app-local detail history. Keeps evolution jumps reversible without relying on browser history.
 const detailHistory=[],detailForward=[];
 let detailOrigin="dex";
 const info=document.querySelector("#dexDetail .hero-info");
 const stats=document.querySelector("#dexDetail .hero > .stats")||document.querySelector("#dexDetail .hero-info .stats");
 if(info&&stats&&stats.parentElement!==info) info.appendChild(stats);

 // Remove legacy duplicated identity/traits and legacy tab strip.
 ["detailTraits","detailName"].forEach(id=>document.getElementById(id)?.remove());
 document.querySelectorAll("#dexDetail .detail-tabs").forEach(x=>x.remove());

 // Resolve the hero before it is referenced below.
 // v54 referenced `hero` before this const declaration, which throws a ReferenceError
 // and aborts the whole detail controller before openDexCard is registered.
 const hero=document.querySelector("#dexDetail .hero");
 let tabs=document.getElementById("v12Tabs");
 if(!tabs){
   tabs=document.createElement("div");tabs.id="v12Tabs";tabs.className="v12-tabs";
   tabs.innerHTML='<button data-v12tab="ability">基本能力</button><button data-v12tab="sleep">寝顔図鑑 <span class="psg-sleep-tab-count"></span></button><button data-v12tab="field">フィールド</button>';
   hero?.appendChild(tabs);
 }
 // Everything after hero becomes the switchable area. Existing ability sections are grouped.
 let ability=document.getElementById("v12Ability");
 if(!ability){
   ability=document.createElement("div");ability.id="v12Ability";ability.className="v12-panel";
   const movable=[];
   let node=hero?.nextElementSibling;
   while(node){
     const next=node.nextElementSibling;
     if(!node.matches("nav,.bottom-nav")) movable.push(node);
     node=next;
   }
   movable.forEach(n=>ability.appendChild(n));
   hero?.after(ability);
 }
 
 // Remove legacy headings/table header that are replaced by the current renderers.
 // This fixes the visible duplicate UI without deleting the CSS/layout that v17 relies on.
 ability.querySelectorAll(".ability-card").forEach(card=>{
   const title=card.querySelector(":scope > .ability-title");
   const legacyFoodHead=card.querySelector(":scope > .food-table-head");
   if(title) title.remove();
   if(legacyFoodHead) legacyFoodHead.remove();
 });

 let sleep=document.getElementById("v12Sleep");
 if(!sleep){sleep=document.createElement("div");sleep.id="v12Sleep";sleep.className="v12-panel";ability.after(sleep)}
 let field=document.getElementById("v12Field");
 if(!field){field=document.createElement("div");field.id="v12Field";field.className="v12-panel";field.innerHTML='<div class="v12-placeholder">フィールドデータをここに表示します</div>';sleep.after(field)}
 // Pin identity and tab navigation together, while keeping the tabs outside the type-colored card.
 let sticky=document.getElementById('psgDexSticky');
 if(!sticky){
   sticky=document.createElement('div');sticky.id='psgDexSticky';sticky.className='psg-dex-sticky';
   hero.before(sticky);sticky.append(hero,tabs);
 }

 // Discoveries are stored by permanent sleep-style ID, never by position or name.
 const SLEEP_FOUND_KEY='psg-sleep-discoveries-v1';
 function readSleepFound(){
   try{
     const saved=JSON.parse(localStorage.getItem(SLEEP_FOUND_KEY)||'{}');
     return saved&&typeof saved==='object'&&!Array.isArray(saved)?saved:{};
   }catch{return {}}
 }
 let sleepFound=readSleepFound();
 function renderSleepStyles(m){
   sleep.replaceChildren();
   const styles=(V.sleepStyles?.[m.no]||[]).filter(x=>x&&x.id&&Number.isInteger(Number(x.stars))&&Number(x.stars)>=1&&Number(x.stars)<=5)
     .slice().sort((a,b)=>Number(a.stars)-Number(b.stars)||Number(a.order||0)-Number(b.order||0)||String(a.id).localeCompare(String(b.id)));
   const registered=styles.filter(x=>sleepFound[x.id]).length;
   const sleepTab=tabs.querySelector('[data-v12tab="sleep"]');
   sleepTab.querySelector('.psg-sleep-tab-count').textContent=`${registered}/${styles.length}`;
   sleepTab.setAttribute('aria-label',`寝顔図鑑、${styles.length}種類中${registered}種類登録済み`);
   if(!styles.length){
     const empty=document.createElement('p');empty.className='psg-sleep-empty';
     empty.textContent='寝顔データ未登録。確認できた寝顔をマスターデータに追加すると、ここに★順で表示します。';
     sleep.appendChild(empty);return;
   }
   const grid=document.createElement('div');grid.className='psg-sleep-grid';
   styles.forEach(style=>{
     const card=document.createElement('article');card.className='psg-sleep-card';
     const photo=document.createElement('div');photo.className='psg-sleep-photo';
     const fallback=document.createElement('span');fallback.className='psg-sleep-no-image';fallback.textContent='No image';
     if(style.image){
       const img=document.createElement('img');img.src=style.image;img.alt=style.name||'寝顔';img.loading='lazy';
       img.onerror=()=>{img.remove();photo.appendChild(fallback)};
       photo.appendChild(img);
     }else photo.appendChild(fallback);
     const toggle=document.createElement('button');toggle.type='button';toggle.className='psg-sleep-toggle';
     toggle.setAttribute('aria-pressed',sleepFound[style.id]?'true':'false');
     toggle.setAttribute('aria-label',`${m.name} ${style.name||'寝顔'} ${sleepFound[style.id]?'登録済み。タップして未登録にする':'未登録。タップして登録する'}`);
     toggle.textContent=sleepFound[style.id]?'✓':'○';
     toggle.onclick=()=>{
       const updated={...sleepFound};
       if(updated[style.id])delete updated[style.id];else updated[style.id]=true;
       try{localStorage.setItem(SLEEP_FOUND_KEY,JSON.stringify(updated));sleepFound=updated;renderSleepStyles(m)}
       catch{toggle.setAttribute('aria-label','保存できませんでした。端末の保存設定を確認してください')}
     };
     photo.appendChild(toggle);card.appendChild(photo);
     const caption=document.createElement('div');caption.className='psg-sleep-caption';
     const stars=document.createElement('strong');stars.className='psg-sleep-stars';stars.textContent=`★${style.stars}`;
     const name=document.createElement('span');name.textContent=style.name||'名称未確認';
     caption.append(stars,name);card.appendChild(caption);grid.appendChild(card);
   });
   sleep.appendChild(grid);
 }
 function renderPokemonFields(m){
   field.replaceChildren();
   const title=document.createElement('h3');title.textContent='フィールド別の寝顔・最低ランク';field.append(title);
   const note=document.createElement('p');note.className='note';note.textContent='資料を投入した出現情報のみ表示。未掲載は出現しないという意味ではありません。';field.append(note);
   let found=false;
   for(const entry of Object.values(V.fields||{})){
     const rows=(entry.encounters||[]).filter(row=>Number(row.sleepStyleId.split('_')[0])===m.no);
     if(!rows.length)continue;
     found=true;
     const section=document.createElement('section');section.className='psg-field-species';
     const heading=document.createElement('h4');heading.textContent=entry.name;section.append(heading);
     for(const item of rows){
       const style=V.sleepStyles?.[m.no]?.find(row=>row[2]===item.sleepStyleId);
       if(!style)continue;
       const line=document.createElement('div');line.className='psg-field-encounter-row';
       const label=document.createElement('span');label.textContent=`★${style[1]} ${style[0]}`;
       const rank=document.createElement('strong');rank.textContent=`${item.rank.tier}${item.rank.level}から`;
       line.append(label,rank);section.append(line);
     }
     field.append(section);
   }
   if(!found){const empty=document.createElement('p');empty.className='v12-placeholder';empty.textContent='フィールド出現データ未投入';field.append(empty)}
 }
 window.PSG_REFRESH_SLEEP_FOUND=()=>{
   sleepFound=readSleepFound();
   const pokemon=byNo(currentNo);
   if(pokemon)renderSleepStyles(pokemon);
 };

 function switchTab(tab){
   currentTab=tab;
   [["ability",ability],["sleep",sleep],["field",field]].forEach(([k,p])=>p.classList.toggle("active",k===tab));
   tabs.querySelectorAll("button").forEach(b=>b.classList.toggle("active",b.dataset.v12tab===tab));
 }
 tabs.onclick=e=>{const b=e.target.closest("[data-v12tab]");if(b)switchTab(b.dataset.v12tab)};

 function header(m){
   let h=document.getElementById("v12Header");
   if(!h){h=document.createElement("div");h.id="v12Header";info.prepend(h)}
   const prev=neighborOf(m.no,-1),next=neighborOf(m.no,1);
   const berryQty=m.berryQtyOverride??m.berryQty;

   // v51: 1-2 + previous/next move into the sticky detail header.
   const head=document.querySelector("#dexDetail .detail-head");
   if(head){
     const title=head.querySelector("h2");
     if(title) title.innerHTML=`<span class="v51-head-no">No.${String(m.no).padStart(3,"0")}</span><span class="v51-head-name">${m.name}</span>`;
     head.querySelector(".v51-head-nav")?.remove();
     const nav=document.createElement("div");
     nav.className="v51-head-nav";
     nav.innerHTML=`<button id="v12Prev" aria-label="前のポケモン" ${prev?"":"disabled"}>‹</button><button id="v12Next" aria-label="次のポケモン" ${next?"":"disabled"}>›</button>`;
     head.appendChild(nav);
   }

   // v51: right side line 1 = former 1-3 (3 columns). Identity/type no longer consumes this area.
   h.innerHTML=`<div class="v19-traits">
     <span class="v44-berry-trait"><span class="v44-berry-visual" title="${m.berry||'きのみ'}">${m.berryImage?window.PS_DEV_ASSETS.image(m.berryImage,'berry',m.berry,'full',m.berry):'<small class="psg-mini-missing" aria-label="No image">No<br>image</small>'}</span><b>${berryQty==null?"未確認":`×${berryQty}`}</b></span>
     <span class="v44-sleep-trait">💤 ${m.sleepType}</span>
     <span class="v44-specialty-trait" title="得意：${m.specialty}" aria-label="得意：${m.specialty}">${window.PS_SPECIALTY_IMAGES?.[({"きのみ":"berry","食材":"ingredient","スキル":"skill","オール":"all"})[m.specialty]]?`<img class="psg-specialty-icon" src="${window.PS_SPECIALTY_IMAGES[({"きのみ":"berry","食材":"ingredient","スキル":"skill","オール":"all"})[m.specialty]]}" alt="">`:m.specialty}</span>
   </div>`;

   // Keep artwork square and place the compact trait row beneath it.
   const heroTop=document.querySelector('#dexDetail .hero-top');
   let media=heroTop?.querySelector('.psg-v106-media');
   if(heroTop&&!media){media=document.createElement('div');media.className='psg-v106-media';heroTop.prepend(media);media.appendChild(document.getElementById('detailArt'))}
   const heroInfo=heroTop?.querySelector('.hero-info');
   if(heroInfo)heroInfo.insertBefore(h,heroInfo.querySelector('.stats'));
   // Type belongs to the artwork, at its lower-right corner.
   const art=document.getElementById("detailArt");
   if(art){
     art.replaceChildren();
     const preview=window.PS_DEV_ASSETS;
     const img=document.createElement('img');
     const expected=preview.path('pokemon',m.no,'full');
     img.src=m.image||preview.preview(expected);
     img.alt=m.name;
     img.classList.toggle('psg-asset-preview',!m.image);
     img.title=preview.title(expected);
     if(m.image)img.dataset.previewPath=expected;
     art.appendChild(img);
     const badge=document.createElement("span");
     badge.className="v51-type-badge";
     badge.title="タイプ："+m.type;badge.setAttribute("aria-label",badge.title);
     badge.innerHTML=window.PS_TYPE_ART?.(m.type)||iconForType(m.type);
     art.appendChild(badge);
   }
 }
 function renderStats(m){
   stats.innerHTML=`<div class="stat"><small><span class="v45-stat-icon">⏱</span><span class="v45-stat-text">おてつだい時間</span></small><b>${m.help?.toLocaleString()||"—"}秒</b></div>
   <div class="stat"><small><span class="v45-stat-icon">🎒</span><span class="v45-stat-text">最大所持数</span></small><b>${m.carry??"未確認"}</b></div>
   <div class="stat"><small><span class="v45-stat-icon">🥕</span><span class="v45-stat-text">食材確率</span></small><b>${m.foodRate??"—"}%</b></div>
   <div class="stat"><small><span class="v45-stat-icon">✨</span><span class="v45-stat-text">スキル発動確率</span></small><b>${m.skillRate??"—"}%</b></div>`;
 }
 function renderFood(m){
   const host=document.getElementById('detailFoods');
   document.getElementById('foodRateBadge')?.style.setProperty('display','none');
   if(!host)return;
   const rows=(m.ingredients||[]).map((x,i)=>{
     const image=V.ingredientVisual(x.name)?.image;
     const iconSource=image||window.PS_INGREDIENT_FALLBACK_ICON?.(x.name);
     const visual=iconSource?`<img src="${iconSource}" alt="${x.name}">`:`<span class="psg-food-fallback">${x.name||'未確認'}</span>`;
     const quantities=(x.qty||[]).map(n=>`<div class="psg-food-level"><strong>${n==null?'—':n+'個'}</strong></div>`).join('');
     const knownRecipes=V.recipesByIngredient?.[x.name]||[];
     const tiles=knownRecipes.map(recipe=>`<div class="psg-food-recipe-tile" title="${recipe.name||'料理'}" aria-label="${recipe.name||'料理'}${recipe.amount!=null?' '+recipe.amount+'個':''}">${recipe.image?`<img src="${recipe.image}" alt="">`:'<span class="psg-food-recipe-missing" aria-hidden="true">🍽</span>'}${recipe.amount!=null?`<small>${recipe.amount}</small>`:''}</div>`).join('');
     const recipes=knownRecipes.length?`<div class="psg-food-recipes"><div class="psg-food-recipe-strip">${tiles}</div></div>`:'<div class="psg-food-recipes is-pending"><span class="psg-food-pending">データ未確認</span></div>';
     return `<div class="psg-food-row" data-slot="${x.slot||['A','B','C'][i]}"><div class="psg-food-id"><b>${x.slot||['A','B','C'][i]}</b>${visual}</div><div class="psg-food-levels">${quantities}</div>${recipes}</div>`;
   }).join('');
   host.innerHTML=`<div class="psg-food-head"><div class="psg-food-rate"><span>食材</span><strong>${m.foodRate!=null?m.foodRate+'%':'未確認'}</strong></div><div class="psg-food-head-levels"><span></span><span>Lv.30</span><span>Lv.60</span></div><b>対応料理</b></div>${rows?`<div class="psg-food-stack">${rows}</div>`:'<p class="unknown">食材データ未確認</p>'}`;
 }
 function renderSkill(m){
   const s=skillOf(m);if(!s)return;
   const skillIcon=document.querySelector('#v12Ability .skill-icon');
   if(skillIcon){
     skillIcon.replaceChildren();
     const path=window.PS_DEV_ASSETS.path('skill',s.id);
     skillIcon.classList.toggle('has-image',!!s.image);
     if(s.image){const img=document.createElement('img');img.src=s.image;img.alt=s.name;img.title=window.PS_DEV_ASSETS.title(path);if(path)img.dataset.previewPath=path;skillIcon.appendChild(img)}
   }
   const badge=document.getElementById("skillRateBadge");
   if(badge)badge.style.display="none";
   const name=document.getElementById("detailSkill");
   if(name)name.textContent=s.name;
   const rate=document.getElementById("skillRateInline");
   if(rate)rate.innerHTML=`発動確率 <strong>${m.skillRate!=null?m.skillRate+"%":"未確認"}</strong>`;
   const lv1=s.levels?.[1];
   const effect=document.getElementById("detailSkillEffect");
   if(effect){
     const effectCopy=s.effectType==='random_ingredients'&&lv1?.amount!=null?`ランダムな食材を <strong class="skill-var effect-food">${lv1.amount}個</strong> ゲットする。`:s.effectType==='fixed_energy'&&lv1?.energy!=null?`カビゴンのエナジーを <strong class="skill-var">${lv1.energy.toLocaleString()}</strong> 増やす。`:s.effectType==='variable_energy'&&lv1?.min!=null&&lv1?.max!=null?`カビゴンのエナジーを <strong class="skill-var">${lv1.min.toLocaleString()}～${lv1.max.toLocaleString()}</strong> 増やす。`:s.effectType==='team_energy_recovery'&&lv1?.recovery!=null?`チーム全員のげんきを <strong class="skill-var">${lv1.recovery}</strong> 回復する。`:lv1?.description?detailEsc(lv1.description):'効果未確認';
     effect.innerHTML=`<b class="v35-effect-level">Lv.1</b><span class="v35-effect-copy">${effectCopy}</span>`;
     effect.classList.add("skill-desc");
   }
   // Dex is reference-only: no skill-level adjustment control here.
   const ctl=document.getElementById("v12SkillLv");
   if(ctl)ctl.remove();
   const levels=document.getElementById("skillLevels");
   if(levels){
     const detail=Object.entries(s.levels||{}).filter(([lv])=>Number(lv)>1).sort((a,b)=>Number(a[0])-Number(b[0]));
     const simpleCompact = detail.length===6 && detail.every(([lv,x])=>x && (x.amount!=null||x.energy!=null||x.recovery!=null||x.helps!=null) && String(x.amount??x.energy??x.recovery??x.helps).length<=4);
     const layoutClass = simpleCompact ? "v43-compact-3" : (detail.length<=6 ? "v43-compact-2" : "v43-detail-long");
     levels.innerHTML=`<div class="v32-skill-grid ${layoutClass}">${detail.map(([lv,x])=>`<div class="v32-skill-cell"><b>Lv.${lv}</b><strong class="skill-var effect-food">${s.effectType==='random_ingredients'&&x.amount!=null?x.amount+'個':s.effectType==='fixed_energy'&&x.energy!=null?x.energy.toLocaleString():s.effectType==='variable_energy'&&x.min!=null&&x.max!=null?x.min.toLocaleString()+'～'+x.max.toLocaleString():s.effectType==='team_energy_recovery'&&x.recovery!=null?'全員＋'+x.recovery:s.effectType==='self_energy_recovery'&&x.recovery!=null?'自分＋'+x.recovery:s.effectType==='ally_energy_recovery'&&x.recovery!=null?'1匹＋'+x.recovery:s.effectType==='extra_help'&&x.helps!=null?'おてつだい'+x.helps+'回':x.description?detailEsc(x.description):'効果未確認'}</strong></div>`).join("")}</div>`;
   }
 }
 function evolutionEntries(m){
   if(!m?.evolution)return [];
   return Array.isArray(m.evolution)?m.evolution:[m.evolution];
 }
 function evolutionConditions(e){
   if(Array.isArray(e.conditions)&&e.conditions.length)return e.conditions;
   const out=[];
   if(e.level!=null)out.push(`Lv.${e.level}`);
   if(e.candy!=null)out.push(`アメ${e.candy}個`);
   if(e.item)out.push(e.item);
   if(e.extra)out.push(e.extra);
   return out.length?out:["条件未確認"];
 }
 function parentsOf(no){
   return Object.values(V.pokemon).filter(p=>evolutionEntries(p).some(e=>Number(e.toNo)===Number(no)));
 }
 function rootOf(m){
   let cur=m,seen=new Set();
   while(cur&&!seen.has(cur.no)){
     seen.add(cur.no);const ps=parentsOf(cur.no);if(!ps.length)break;cur=ps[0];
   }
   return cur||m;
 }
 function descendantsOf(root){
   const out=[],seen=new Set();
   const walk=p=>{if(!p||seen.has(p.no))return;seen.add(p.no);out.push(p);evolutionEntries(p).forEach(e=>walk(byNo(e.toNo)))};
   walk(root);return out;
 }
 function evoNode(p,currentNo,cls="",condition=null){
   if(!p)return "";
   const face=window.PS_IMAGE_FILES.pokemonFaces?.[p.no]||(p.faceImage&&p.faceImage!==p.image?p.faceImage:null);
   const image=window.PS_DEV_ASSETS.image(face,'pokemon',p.no,'face',p.name);
   const isCurrent=Number(p.no)===Number(currentNo);
   const conditions=condition?`<span class="v106-evo-conditions">${evolutionConditions(condition).map((x,i)=>`<span>${x}${i===0?'<span class="v111-evo-next" aria-hidden="true">›</span>':''}</span>`).join("")}</span>`:"";
   return `<button class="v31-evo-node ${isCurrent?"is-current":""} ${cls}" data-evo-no="${p.no}"><span class="v31-evo-name">${p.name}</span><span class="v111-evo-body"><span class="v31-evo-image">${image}<span class="v31-evo-type">${iconForType(p.type)}</span></span>${conditions}</span></button>`;
 }
 function renderEvolution(m){
   const el=document.getElementById("detailEvolution"),card=document.getElementById("evolutionCard");
   if(!el||!card)return;
   const root=rootOf(m),family=descendantsOf(root),rootBranches=evolutionEntries(root);
   if(family.length<=1){
     card.style.display=m.evolutionStatus==="未確認"?"":"none";
     el.textContent=m.evolutionStatus==="未確認"?"進化条件未確認":"";
     return;
   }
   card.style.display="";
   // Heavy branching: base at left-center, destinations in a 3-column grid on the right.
   if(rootBranches.length>1){
     const cells=rootBranches.map(e=>{const p=byNo(e.toNo);return `<div class="v31-branch-cell">${evoNode(p,m.no)}<div class="v31-evo-cond">${evolutionConditions(e).map(x=>`<span>${x}</span>`).join("")}</div></div>`}).join("");
     el.innerHTML=`<div class="v31-branch-layout"><div class="v31-branch-root">${evoNode(root,m.no,"is-root")}</div><div class="v31-big-arrow">›</div><div class="v31-branch-grid ${rootBranches.length===2?'is-two':''}">${cells}</div></div>`;
   }else{
     // Normal line: render the full known evolution family, not Pokédex-number adjacency.
     const chain=[];let cur=root,guard=0;
     while(cur&&guard++<12){chain.push(cur);const es=evolutionEntries(cur);if(es.length!==1)break;cur=byNo(es[0].toNo)}
     let html='<div class="v31-evo-line">';
     chain.forEach((p,i)=>{
       const edge=i<chain.length-1?evolutionEntries(p)[0]:null;
       html+=evoNode(p,m.no,"",edge);
       // The source card carries the arrow and outgoing requirement.
     });
     html+='</div>';el.innerHTML=html;
   }
   el.querySelectorAll("[data-evo-no]").forEach(btn=>btn.onclick=()=>{const no=Number(btn.dataset.evoNo);if(no&&no!==currentNo)openPokemonDetail(no,{pushHistory:true})});
 }
 function openPokemonDetail(no,opts={}){
   const m=byNo(no);if(!m)return;
   if(['skillPage','recipePage'].includes(window.PS?.state?.screen))detailOrigin=window.PS.state.screen;
   if(opts.pushHistory&&currentNo&&currentNo!==m.no){detailHistory.push(currentNo);detailForward.length=0}
   currentNo=m.no;setTheme(m.type);show("dexDetail");
   header(m);renderStats(m);renderFood(m);renderSkill(m);renderEvolution(m);renderSleepStyles(m);renderPokemonFields(m);switchTab(currentTab||"ability");
 }
 window.openPokemonDetail=openPokemonDetail;

 // v57: one explicit entry point for every Dex card.
 // renderDex calls this directly, so there is no capture/bubble race with the legacy handler.
 window.openDexCard=function(no){
   no=Number(no);if(!Number.isFinite(no))return;
   currentTab="ability";detailHistory.length=0;detailForward.length=0;detailOrigin="dex";currentNo=null;
   if(byNo(no)){openPokemonDetail(no);return;}
 };

 // Line-1 previous/next navigation also participates in the same reversible detail history.
 document.addEventListener("click",e=>{
   const b=e.target.closest?.("#v12Prev,#v12Next");
   if(!b||b.disabled)return;
   const current=byNo(currentNo);if(!current)return;
   const target=neighborOf(current.no,b.id==="v12Prev"?-1:1);
   if(!target)return;
   e.preventDefault();e.stopImmediatePropagation();openPokemonDetail(target.no,{pushHistory:true});
 },true);

 const back=document.querySelector("#dexDetail [data-back]");
 function leaveDetail(){
   show(detailOrigin||"dex");currentNo=null;
   detailHistory.length=0;detailForward.length=0;
   return true;
 }
 function backDetail(){
   const previous=detailHistory.pop();
   if(previous){detailForward.push(currentNo);openPokemonDetail(previous);return true}
   return leaveDetail();
 }
 function forwardDetail(){
   const next=detailForward.pop();
   if(!next)return false;
   if(currentNo)detailHistory.push(currentNo);
   openPokemonDetail(next);return true;
 }
 // The visible button exits to the originating list. Inner-screen swipes navigate detail history.
 if(back)back.addEventListener("click",e=>{e.preventDefault();e.stopImmediatePropagation();leaveDetail()},true);
 window.PS_DETAIL_NAV={back:backDetail,forward:forwardDetail};

 const toggle=document.getElementById("skillDetailToggle"),levels=document.getElementById("skillLevels");
 if(toggle&&levels)toggle.onclick=()=>{const o=levels.classList.toggle("open");toggle.textContent=o?"詳細を閉じる ▲":"詳細を見る ▼"};

 switchTab("ability");
})();
</script>


<script id="psg-auto-image-paths">
/* Only verified species and registered asset IDs are queried. Missing files leave the existing UI alone. */
(()=>{'use strict';
const catalog=window.PS_CATALOG;
const assets=window.PS_DEV_ASSETS;
const explicit=window.PS_IMAGE_FILES;
const lookup=new Map();
function exists(path){
  if(!path)return Promise.resolve(false);
  if(lookup.has(path))return lookup.get(path);
  const task=new Promise(resolve=>{
    const image=new Image();
    image.onload=()=>resolve(image.naturalWidth>0);
    image.onerror=()=>resolve(false);
    image.src=path;
  });
  lookup.set(path,task);
  return task;
}
const jobs=[];
function tryPath(path,apply){jobs.push(exists(path).then(ok=>{if(ok){apply(path);return true}return false}))}
window.PS_TYPE_IMAGES={...window.PS_IMAGE_FILES.types};
const typeSheet=new Image();
jobs.push(new Promise(resolve=>{
 typeSheet.onload=()=>{
  const names=['ノーマル','ほのお','みず','くさ','でんき','こおり','かくとう','どく','じめん','ひこう','エスパー','むし','いわ','ゴースト','ドラゴン','あく','はがね','フェアリー'];
  const width=typeSheet.naturalWidth/6,height=typeSheet.naturalHeight/3;
  names.forEach((name,index)=>{
   const canvas=document.createElement('canvas');canvas.width=64;canvas.height=64;
   const context=canvas.getContext('2d');context.imageSmoothingEnabled=false;
   context.drawImage(typeSheet,(index%6)*width,Math.floor(index/6)*height,width,height,0,0,64,64);
   if(!window.PS_TYPE_IMAGES[name])window.PS_TYPE_IMAGES[name]=canvas.toDataURL('image/png');
  });resolve(true);
 };
 typeSheet.onerror=()=>resolve(false);
 typeSheet.src="data:image/png;base64,